{
  "name": "loyna-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application iPhone et Android Loyna : l'espace client de loyna.fr (src/app/) embarqué avec Capacitor",
  "scripts": {
    "build": "node ../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "dev": "node ../node_modules/vite/bin/vite.js --config vite.config.ts",
    "icones": "python outils/icones.py",
    "sync": "npm run build && cap sync",
    "sync:ios": "npm run build && cap sync ios",
    "check": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
