---
import '../styles/global.css';
import fontLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Consent from '../components/Consent.astro';
import OfferBar from '../components/OfferBar.astro';
import {getSettings} from '../lib/builder';
import {LAUNCH_OFFER, SITE, offerActive} from '../data/site';

type Link = {href: string; label: string};
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  breadcrumbs?: {name: string; url: string}[];
  published?: string;
  modified?: string;
  ogImageAlt?: string;
  bare?: boolean;
  /** Barre d'action fixe sur mobile : false pour la masquer, ou liens personnalisés. */
  stickyCta?: false | {primary?: Link; secondary?: Link};
}
const props = Astro.props;
const {stickyCta = {}} = props;
const settings = await getSettings();
const gaId = (settings.ga4Id || SITE.ga4Id || '').trim();
---

<!doctype html>
<html lang="fr-FR" data-offer-until={offerActive() ? LAUNCH_OFFER.until : undefined}>
  <head>
    <meta charset="utf-8" />
    <!-- Liens Supabase Auth arrivés sur une autre page (ex. « Send password recovery » du tableau de bord, qui renvoie à
         l'accueil) : jetons ou erreur après # → page du mot de passe, qui sait les lire (2026-10-28). -->
    <script is:inline>
      (function () {
        var h = location.hash;
        if (location.pathname.indexOf('/espace-client/mot-de-passe') === 0) return;
        if ((h.indexOf('access_token=') > -1 && /[#&]type=(recovery|invite)(&|$)/.test(h)) || /[#&]error_code=/.test(h))
          location.replace('/espace-client/mot-de-passe/' + h);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <Seo
      {...props}
      googleVerification={(settings.googleVerification || SITE.googleVerification || '').trim()}
      bingVerification={(settings.bingVerification || SITE.bingVerification || '').trim()}
      sameAs={[...SITE.sameAs, ...(settings.sameAs || '').split(/\s+/)].filter((u) => /^https:\/\//.test(u))}
    />
    <meta name="theme-color" content="#121216" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Blog LOYNA" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {!props.bare && <OfferBar announcement={settings.announcement || ''} />}
    {!props.bare && <Header />}
    <main id="contenu">
      <slot />
    </main>
    {!props.bare && <Footer consent={!!gaId} />}
    {!props.bare && stickyCta !== false && <StickyCta {...stickyCta} />}
    {!props.bare && <Consent gaId={gaId} />}
  </body>
</html>

<script>
  // États de chargement : liens et formulaires marqués data-loading (« Redirection… », « Envoi… »).
  const busy = (el: HTMLElement) => {
    const label = el.dataset.loading;
    if (label) {
      el.dataset.label = el.innerHTML;
      el.textContent = label;
    }
    el.classList.add('is-loading');
    el.setAttribute('aria-busy', 'true');
  };
  document.addEventListener('click', (e) => {
    const me = e as MouseEvent;
    if (me.button || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-loading]');
    if (!a) return;
    busy(a);
    const plan = a.dataset.plan;
    if (plan) (window as unknown as {loynaTrack?: (n: string, p?: object) => void}).loynaTrack?.('begin_checkout', {items: [{item_id: plan}]});
  });
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    const btn = f.querySelector<HTMLButtonElement>('button[type="submit"][data-loading]');
    if (!btn) return;
    if (btn.classList.contains('is-loading')) {
      e.preventDefault(); // évite un double envoi
      return;
    }
    busy(btn);
  });
  // Offre de lancement expirée alors que la page n'a pas été reconstruite : on retire tout ce qui la mentionne.
  const until = Date.parse(document.documentElement.dataset.offerUntil || '');
  if (until && Date.now() > until) {
    document.querySelectorAll('[data-offer]').forEach((el) => el.remove());
    document.querySelectorAll<HTMLElement>('[data-offer-off]').forEach((el) => (el.hidden = false));
    document.querySelectorAll<HTMLAnchorElement>('a[href*="prefilled_promo_code"]').forEach((a) => {
      const u = new URL(a.href);
      u.searchParams.delete('prefilled_promo_code');
      a.href = u.toString();
    });
  }
  // Retour arrière depuis Stripe (cache du navigateur) : on rend les boutons à nouveau cliquables.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    document.querySelectorAll<HTMLElement>('.is-loading').forEach((el) => {
      if (el.dataset.label) el.innerHTML = el.dataset.label;
      el.classList.remove('is-loading');
      el.removeAttribute('aria-busy');
    });
  });
</script>
