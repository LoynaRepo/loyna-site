---
// Bandeau fin au-dessus de l'en-tête : texte libre de Builder (site-settings « announcement ») ou, à défaut,
// le Parrainage LOYNA (choix d'Ewan du 2026-10-28, à la place de l'offre de lancement, qui reste dans les tarifs),
// avec un lien vers la section « Parrainage » de la page d'accueil.
import Icon from './Icon.astro';
interface Props {
  announcement?: string;
}
const {announcement = ''} = Astro.props;
const text = announcement.trim();
---

<div class="offer-bar">
  <div class="container ob-row">
    {text ? (
      <p>{text}</p>
    ) : (
      <p>
        <Icon name="gift" size={16} />
        <span class="ob-long">
          <strong>Parrainage LOYNA</strong> : parrainez un commerçant, un mois à -50&nbsp;% chacun
        </span>
        <span class="ob-short">
          <strong>Parrainage</strong> : un mois à -50&nbsp;% chacun
        </span>
        <a href="/#parrainage"><span class="ob-long">En savoir plus</span> →</a>
      </p>
    )}
  </div>
</div>

<style>
  .offer-bar {
    background: linear-gradient(90deg, #a87530, #e6c27a 50%, #a87530);
    color: #17140f;
    font-size: 0.9rem;
  }
  .ob-row p {
    margin: 0;
    padding: 8px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    text-align: center;
    line-height: 1.35;
  }
  .ob-short {
    display: none;
  }
  @media (max-width: 700px) {
    .ob-long {
      display: none;
    }
    .ob-short {
      display: inline;
      white-space: nowrap;
    }
    .ob-row p {
      flex-wrap: nowrap;
      font-size: 0.84rem;
      padding: 10px 0;
    }
    .offer-bar {
      position: relative;
    }
    .ob-row a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .ob-row :global(svg) {
      display: none;
    }
  }
  .ob-row a {
    color: #17140f;
    font-weight: 800;
    white-space: nowrap;
  }
</style>
