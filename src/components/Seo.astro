---
// Balises de référencement : titre, description, URL canonique, Open Graph, Twitter, données structurées.
import {FONDATEUR, SITE} from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Avec noindex : « noindex, nofollow » (pages privées). */
  nofollow?: boolean;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: object | object[];
  breadcrumbs?: {name: string; url: string}[];
  published?: string;
  /** Date de la dernière mise à jour réelle (articles), si elle existe. */
  modified?: string;
  /** Texte alternatif de l'image de partage ; par défaut, le titre de la page quand elle a son image propre. */
  ogImageAlt?: string;
  googleVerification?: string;
  bingVerification?: string;
  sameAs?: string[];
}
const {title, description, noindex = false, nofollow = false, ogImage, type = 'website', jsonLd = [], breadcrumbs, published, modified, ogImageAlt, googleVerification, bingVerification, sameAs = []} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const image = new URL(ogImage || '/og/default.png', SITE.url).href;
// Le nom de la marque n'est ajouté que s'il manque, quelle que soit sa casse (accueil : « Loyna : … », 2026-10-28)
const fullTitle = /loyna/i.test(title) ? title : `${title} | LOYNA`;
// Image propre à la page (tools/og.py : le titre de la page est écrit sur l'image) ou image par défaut de la marque
const imageAlt =
  ogImageAlt || (ogImage && !ogImage.endsWith('/default.png') ? fullTitle : 'LOYNA — carte de fidélité digitale Apple Wallet et Google Wallet');

// Fondateur (page « À propos »), aussi auteur des articles. sameAs vide tant qu'Ewan n'a pas donné ses profils.
const fondateur = {
  '@type': 'Person',
  '@id': FONDATEUR.id,
  name: FONDATEUR.nom,
  jobTitle: FONDATEUR.titre,
  url: new URL(FONDATEUR.page, SITE.url).href,
  worksFor: {'@id': `${SITE.url}/#organisation`},
  ...(FONDATEUR.sameAs.length ? {sameAs: FONDATEUR.sameAs} : {}),
};

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organisation`,
  name: 'LOYNA',
  alternateName: ['Loyna', 'LOYNA Business'],
  description: SITE.description,
  url: SITE.url,
  logo: {'@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512},
  // Profils officiels de la marque (SITE.sameAs ou Builder site-settings) : vides tant qu'Ewan ne les a pas donnés
  ...(sameAs.length ? {sameAs} : {}),
  founder: fondateur,
  // LOYNA est une marque de KOVA Elec, nom commercial d'Ewan Touquet, entrepreneur individuel (mentions légales)
  identifier: {'@type': 'PropertyValue', propertyID: 'SIRET', value: SITE.legal.siret.replace(/\D/g, '')},
  knowsAbout: ['carte de fidélité', 'carte de fidélité digitale', 'programme de fidélité', 'Apple Wallet', 'Google Wallet', 'fidélisation client'],
  email: SITE.email,
  slogan: SITE.slogan,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: 'FR',
  contactPoint: [{'@type': 'ContactPoint', email: SITE.email, contactType: 'customer service', availableLanguage: ['French']}],
};
const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#site`,
  url: SITE.url,
  name: 'LOYNA',
  alternateName: 'Loyna',
  description: SITE.slogan,
  inLanguage: 'fr-FR',
  publisher: {'@id': `${SITE.url}/#organisation`},
};
const graph: object[] = [organization, website, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({'@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, SITE.url).href})),
  });
}
const ld = JSON.stringify({'@context': 'https://schema.org', '@graph': graph}).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? (nofollow ? 'noindex, nofollow' : 'noindex, follow') : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="LOYNA" />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={ld} />
