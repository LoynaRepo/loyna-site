---
// Visuel d'accueil animé en CSS : la carte dans Wallet, un passage validé, une notification.
import Phone from './Phone.astro';
import WalletCard from './WalletCard.astro';
---

<div class="hero-visual" aria-hidden="true">
  <div class="back-card">
    <WalletCard name="Pain d'Or" activity="Boulangerie" bg="#7a3d1c" accent="#f2c879" filled={4} total={8} reward="Une viennoiserie offerte" variant="google" qr={false} width={250} />
  </div>
  <Phone width={300} screen="#000">
    <div class="wallet-ui">
      <div class="status"><span>9:41</span><span class="dots"></span></div>
      <p class="wallet-title">Wallet</p>
      <div class="stack s1">Banque</div>
      <div class="stack s2">Carte transport</div>
      <div class="main-card">
        <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={252} />
      </div>
    </div>
    <div class="toast">
      <span class="t-icon">ML</span>
      <span class="t-text"><b>Maison Lumière</b><span>Plus que 3 passages avant votre brushing offert&nbsp;!</span></span>
    </div>
  </Phone>
  <div class="pill pill-scan"><span class="ok">✓</span> Passage validé</div>
  <div class="pill pill-reward">🎁 Récompense débloquée</div>
</div>

<style>
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    padding: 40px 30px 30px;
  }
  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 8% 4%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 194, 122, 0.45), rgba(230, 194, 122, 0) 68%);
    filter: blur(10px);
  }
  .back-card {
    position: absolute;
    left: -2%;
    top: 26%;
    transform: rotate(-9deg);
    opacity: 0.95;
    animation: floaty 7s ease-in-out infinite;
  }
  .hero-visual :global(.phone) {
    position: relative;
    animation: floaty 8s ease-in-out infinite reverse;
  }
  .wallet-ui {
    position: absolute;
    inset: 0;
    padding: 14px 12px;
    color: #fff;
  }
  .status {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 14px;
  }
  .wallet-title {
    font-size: 26px;
    font-weight: 750;
    margin: 18px 4px 10px;
    letter-spacing: -0.02em;
  }
  .stack {
    height: 40px;
    border-radius: 12px 12px 0 0;
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: -6px;
  }
  .s1 {
    background: linear-gradient(135deg, #1d3557, #457b9d);
  }
  .s2 {
    background: linear-gradient(135deg, #2d6a4f, #52b788);
  }
  .main-card {
    position: relative;
    animation: slideup 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .main-card :global(.wc-stamps span:nth-child(7)) {
    animation: stamp 6s ease-in-out 1.6s infinite;
  }
  .toast {
    position: absolute;
    z-index: 6;
    left: 10px;
    right: 10px;
    top: 48px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 18px;
    background: rgba(248, 244, 236, 0.95);
    color: #16161a;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    font-size: 11.5px;
    line-height: 1.3;
    animation: toast 6s cubic-bezier(0.16, 1, 0.3, 1) 2.2s infinite both;
  }
  .t-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: #1f1c17;
    color: #d9b27a;
    font-weight: 800;
    font-size: 11px;
  }
  .t-text {
    display: grid;
  }
  .pill {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .pill-scan {
    right: -2%;
    top: 30%;
    animation: pop 6s ease-out 1.5s infinite both;
  }
  .pill-reward {
    left: 2%;
    bottom: 12%;
    animation: pop 6s ease-out 3.4s infinite both;
  }
  .ok {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 13px;
  }
  @keyframes floaty {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }
  @keyframes slideup {
    from {
      transform: translateY(120px);
      opacity: 0;
    }
  }
  @keyframes stamp {
    0%,
    20% {
      background: transparent;
      box-shadow: inset 0 0 0 1.5px rgba(248, 244, 236, 0.35);
      transform: scale(1);
    }
    26% {
      transform: scale(1.5);
    }
    32%,
    100% {
      transform: scale(1);
    }
  }
  @keyframes toast {
    0% {
      transform: translateY(-140%);
      opacity: 0;
    }
    8%,
    55% {
      transform: translateY(0);
      opacity: 1;
    }
    65%,
    100% {
      transform: translateY(-140%);
      opacity: 0;
    }
  }
  @keyframes pop {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    8%,
    60% {
      transform: scale(1);
      opacity: 1;
    }
    70%,
    100% {
      transform: scale(0.9);
      opacity: 0;
    }
  }
  @media (max-width: 640px) {
    .back-card {
      display: none;
    }
    .pill-scan {
      right: 0;
    }
  }
</style>
