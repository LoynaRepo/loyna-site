---
// Logo LOYNA (nouveau logo du 09/11/2026 : icône 3D nacrée + mot « Loyna » en Poppins ExtraBold), images dans public/marque/.
// L’ancien logo vectoriel doré (src/assets/logo-mark.svg, logo-word.svg) ne sert plus que dans la page visuel-carte (image des mails).
interface Props {
  height?: number;
  tone?: 'dark' | 'light';
  withWord?: boolean;
}
const {height = 34, tone = 'dark', withWord = true} = Astro.props;
const mot = tone === 'dark' ? '/marque/mot-nuit.png' : '/marque/mot-blanc.png';
---

<span class="logo" style={`--h:${height}px`}>
  <img class="mark" src="/marque/icone-192.png" alt="" width="192" height="192" />
  {withWord ? <img class="word" src={mot} alt="LOYNA" /> : <span class="visually-hidden">LOYNA</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--h) * 0.22);
    height: var(--h);
  }
  .mark {
    height: calc(var(--h) * 1.25);
    width: auto;
  }
  .word {
    height: calc(var(--h) * 0.62);
    width: auto;
  }
</style>
