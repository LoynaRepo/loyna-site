---
// Logo officiel LOYNA vectorisé (symbole doré + mot), intégré au HTML.
import mark from '../assets/logo-mark.svg?raw';
import word from '../assets/logo-word.svg?raw';
interface Props {
  height?: number;
  tone?: 'dark' | 'light';
  withWord?: boolean;
}
const {height = 34, tone = 'dark', withWord = true} = Astro.props;
const color = tone === 'dark' ? '#141414' : '#F8F4EC';
// identifiant de dégradé propre à chaque logo (plusieurs logos par page)
const uid = 'lg' + Math.random().toString(36).slice(2, 8);
const markSvg = mark.replace('id="g"', `id="${uid}"`).replace('url(#g)', `url(#${uid})`).replace('<svg', '<svg aria-hidden="true"');
const wordSvg = word.replace('<svg', '<svg role="img" aria-label="LOYNA"');
---

<span class="logo" style={`--h:${height}px;color:${color}`}>
  <span class="mark" set:html={markSvg} />
  {withWord ? <span class="word" set:html={wordSvg} /> : <span class="visually-hidden">LOYNA</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--h) * 0.32);
    height: var(--h);
  }
  .mark :global(svg) {
    height: var(--h);
    width: var(--h);
  }
  .word :global(svg) {
    height: calc(var(--h) * 0.48);
    width: auto;
  }
</style>
