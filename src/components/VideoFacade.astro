---
// Vidéo de présentation : affiche légère, la vidéo n'est chargée qu'au clic (aucun poids au chargement de la page).
import {Picture} from 'astro:assets';
import poster from '../assets/shots/poster-video.png';
interface Props {
  title?: string;
}
const {title = 'Découvrez LOYNA en 1 minute'} = Astro.props;
---

<figure class="video">
  <button class="facade" type="button" data-src="/video/loyna-presentation-720p.mp4" aria-label={`Lire la vidéo : ${title}`}>
    <Picture src={poster} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 540, 720]} sizes="(max-width: 600px) 80vw, 360px" alt="" loading="lazy" decoding="async" />
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
    </span>
  </button>
  <figcaption>{title} · 1 min 04 · avec le son</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.facade').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        // Cadre de la vidéo avec indicateur de chargement, retiré dès que la lecture démarre.
        const wrap = document.createElement('div');
        wrap.className = 'vwrap is-buffering';
        const v = document.createElement('video');
        v.src = btn.dataset.src!;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.setAttribute('width', '720');
        v.setAttribute('height', '1280');
        const spin = document.createElement('span');
        spin.className = 'vspin';
        spin.setAttribute('role', 'status');
        spin.innerHTML = '<span class="sr-only">Chargement de la vidéo…</span>';
        wrap.append(v, spin);
        btn.replaceWith(wrap);
        const done = () => wrap.classList.remove('is-buffering');
        v.addEventListener('playing', done, {once: true});
        v.addEventListener('pause', done, {once: true});
        v.addEventListener(
          'error',
          () => {
            done();
            wrap.insertAdjacentHTML('afterend', `<p class="verr">La vidéo n’a pas pu être chargée. <a href="${btn.dataset.src}">Ouvrir le fichier vidéo</a></p>`);
          },
          {once: true},
        );
        v.focus();
      },
      {once: true},
    );
  });
</script>

<style>
  .video {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .facade,
  .video :global(.vwrap) {
    width: min(100%, 360px);
    aspect-ratio: 9 / 16;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: #0b0b0f;
  }
  .facade {
    position: relative;
    padding: 0;
    border: 0;
    cursor: pointer;
  }
  .video :global(.vwrap) {
    position: relative;
  }
  .video :global(.vwrap video) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .video :global(.vspin) {
    display: none;
  }
  .video :global(.vwrap.is-buffering .vspin) {
    display: block;
    position: absolute;
    left: 50%;
    top: 50%;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.25);
    border-top-color: #A487FF;
    animation: spin 0.8s linear infinite;
    pointer-events: none;
  }
  .video :global(.verr) {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }
  .facade :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--grad-gold);
    color: var(--ink);
    box-shadow: 0 14px 40px rgba(123, 77, 255, 0.5);
    transition: transform 0.2s;
  }
  .facade:hover .play {
    transform: scale(1.08);
  }
  figcaption {
    color: var(--muted);
    font-size: 0.92rem;
  }
  :global(.section--dark) figcaption,
  :global(.sur-nuit) figcaption {
    color: #A9B0B8;
  }
</style>
