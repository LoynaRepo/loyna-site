---
// Grille tarifaire avec bascule mensuel / annuel en CSS pur (aucun JavaScript).
// Offres, quotas et contenu : src/data/site.ts (source : docs/OFFRES.md du dépôt LOYNA).
// Les boutons « Choisir » mènent au panier (/panier/ : QR codes sous verre, compte LOYNA, puis paiement Stripe).
import Icon from './Icon.astro';
import {LAUNCH_OFFER, MARKETING_INTERVAL_HOURS, PLANS, SETUP_FEE, SITE, euro, offerActive, panierUrl, quotas} from '../data/site';
interface Props {
  idPrefix?: string;
  compact?: boolean;
  /** Niveau du titre de chaque formule (2 si aucun h2 ne précède la grille). */
  level?: 2 | 3;
}
const {idPrefix = 'p', compact = false, level = 3} = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const offer = offerActive();
---

<div class="pricing">
  <div class="toggle" role="radiogroup" aria-label="Période de facturation">
    <input type="radio" name={`${idPrefix}-period`} id={`${idPrefix}-m`} checked />
    <label for={`${idPrefix}-m`}>Mensuel</label>
    <input type="radio" name={`${idPrefix}-period`} id={`${idPrefix}-y`} class="yearly" />
    <label for={`${idPrefix}-y`}>Annuel <span class="save">−15&nbsp;%</span></label>
  </div>

  <div class="plans">
    {
      PLANS.map((p) => (
        <article class={`plan ${p.highlight ? 'plan--hl' : ''}`} aria-labelledby={`${idPrefix}-${p.id}`}>
          <header>
            <H class="plan-name" id={`${idPrefix}-${p.id}`}>{p.name}</H>
            {p.badge && <span class="badge">{p.badge}</span>}
          </header>
          <p class="pitch">{p.pitch}</p>
          <div class="price only-m">
            <span class="amount">{euro(p.monthly)}</span>
            <span class="per">/ mois, sans TVA</span>
          </div>
          {
            offer ? (
              <>
                <p class="offer-tag only-m" data-offer>
                  Mise en service <s>{euro(SETUP_FEE)}</s> offerte jusqu’au {LAUNCH_OFFER.untilLabel}
                </p>
                <p class="note only-m" data-offer-off hidden>+ {euro(SETUP_FEE)} de mise en service, une seule fois</p>
              </>
            ) : (
              <p class="note only-m">+ {euro(SETUP_FEE)} de mise en service, une seule fois</p>
            )
          }
          <div class="price only-y">
            <span class="amount">{euro(p.yearly)}</span>
            <span class="per">/ an, sans TVA</span>
          </div>
          <p class="note only-y">
            soit {euro(Math.round((p.yearly / 12) * 100) / 100)} / mois · <strong>mise en service offerte</strong>
          </p>
          <p class="quota">
            <Icon name="wallet" size={17} />
            <span>{quotas(p)}</span>
          </p>
          <a class={`btn ${p.highlight ? 'btn--gold' : 'btn--primary'} btn--block only-m`} href={panierUrl(p.id, 'mensuel')} rel="nofollow">
            Choisir {p.name}
          </a>
          <p class="engage only-m"><strong>Engagement de 12 mois</strong>, réglés chaque mois, puis résiliable à la fin de n’importe quel mois, sans frais.</p>
          <a class={`btn ${p.highlight ? 'btn--gold' : 'btn--primary'} btn--block only-y`} href={panierUrl(p.id, 'annuel')} rel="nofollow">
            Choisir {p.name} en annuel
          </a>
          <p class="engage only-y">12 mois payés en une fois, renouvelables.</p>
          {!compact && (
            <>
              {p.intro && <p class="intro">{p.intro}</p>}
              {p.focus && (
                <div class="focus">
                  <p class="focus-title">{p.focus.title}</p>
                  <ul class="checks">
                    {p.focus.items.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                </div>
              )}
              <ul class="checks">
                {p.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </>
          )}
        </article>
      ))
    }
  </div>
  <p class="fine">
    Une notification correspond à un message de campagne reçu par une carte. Les messages automatiques et les notifications de proximité ne sont jamais décomptés, et un client reçoit au plus un message commercial toutes les {MARKETING_INTERVAL_HOURS}&nbsp;h (délai réglable).
  </p>
  <p class="fine">
    {
      offer && (
        <span data-offer>
          Offre de lancement : mise en service offerte jusqu’au {LAUNCH_OFFER.untilLabel}, en mensuel comme en annuel (appliquée d’office dans votre panier).{' '}
        </span>
      )
    }
    Prix en euros, sans TVA ({SITE.vatNote}) : le prix affiché est le prix payé. Paiement sécurisé par Stripe, au nom de KOVA Elec (LOYNA, une marque de KOVA Elec) ; factures dans votre espace client.
  </p>
</div>

<style>
  .toggle {
    display: inline-flex;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    padding: 5px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    margin-bottom: 40px;
    box-shadow: var(--shadow);
  }
  .toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .toggle label {
    padding: 11px 24px;
    border-radius: 999px;
    font-weight: 700;
    cursor: pointer;
    color: var(--muted);
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .toggle input:checked + label {
    background: var(--ink);
    color: #faf7f0;
  }
  .toggle input:focus-visible + label {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .save {
    font-size: 0.78rem;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--gold-soft);
    color: #6b4a14;
  }
  .offer-tag {
    margin: -4px 0 0;
    padding: 8px 12px;
    border-radius: 12px;
    background: rgba(31, 157, 92, 0.1);
    border: 1px dashed rgba(31, 157, 92, 0.45);
    color: #13663b;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .offer-tag b {
    letter-spacing: 0.04em;
  }
  .plan--hl .offer-tag {
    background: rgba(230, 194, 122, 0.12);
    border-color: rgba(230, 194, 122, 0.5);
    color: #f0d49a;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    align-items: start;
  }
  .plan {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 34px 30px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .plan--hl {
    background: var(--ink);
    color: #e9e5dc;
    border-color: var(--ink);
    box-shadow: var(--shadow-lg);
  }
  .plan header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .plan-name {
    margin: 0;
    font-size: 1.45rem;
  }
  .plan--hl .plan-name {
    color: #faf7f0;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--gold-soft);
    color: #6b4a14;
  }
  .plan--hl .badge {
    background: var(--grad-gold);
    color: var(--ink);
  }
  .pitch {
    color: var(--muted);
    margin: 0;
    min-height: 3.2em;
  }
  .plan--hl .pitch,
  .plan--hl .note {
    color: #b9b3a7;
  }
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin-top: 6px;
  }
  .amount {
    font-size: 2.9rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
    line-height: 1;
  }
  .plan--hl .amount {
    color: #faf7f0;
  }
  .per {
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  .plan--hl .per {
    color: #b9b3a7;
  }
  .note {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 6px;
  }
  .engage {
    margin: -4px 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    text-align: center;
    color: var(--muted);
  }
  .engage strong {
    color: var(--ink);
  }
  .plan--hl .engage {
    color: #b9b3a7;
  }
  .plan--hl .engage strong {
    color: #faf7f0;
  }
  .intro {
    font-weight: 700;
    margin: 10px 0 0;
  }
  /* Quotas de l'offre, sous le prix */
  .quota {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 9px 12px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
  }
  .quota :global(svg) {
    flex-shrink: 0;
    color: var(--gold-strong);
  }
  .plan--hl .quota {
    background: rgba(250, 247, 240, 0.06);
    border-color: rgba(230, 194, 122, 0.3);
    color: #faf7f0;
  }
  .plan--hl .quota :global(svg) {
    color: #e6c27a;
  }
  /* Bloc mis en avant : automatisations (Premium), services de LOYNA (Pro) */
  .focus {
    padding: 16px 16px 18px;
    border-radius: 18px;
    background: var(--gold-soft);
    border: 1px solid rgba(201, 150, 63, 0.35);
  }
  .focus-title {
    margin: 0 0 10px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b4a14;
  }
  .focus .checks li::before {
    background-color: #fffdf8;
  }
  .plan--hl .focus {
    background: rgba(230, 194, 122, 0.1);
    border-color: rgba(230, 194, 122, 0.4);
  }
  .plan--hl .focus-title {
    color: #f0d49a;
  }
  .plan--hl .focus .checks li::before {
    background-color: rgba(230, 194, 122, 0.22);
  }
  .plan--hl .focus li {
    color: #faf7f0;
  }
  .plan--hl :global(.checks li::before) {
    background-color: rgba(230, 194, 122, 0.18);
  }
  .fine {
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
    margin: 28px auto 0;
    max-width: 920px;
  }
  .fine + .fine {
    margin-top: 10px;
  }
  .only-y {
    display: none;
  }
  .pricing:has(.yearly:checked) .only-y {
    display: flex;
  }
  .pricing:has(.yearly:checked) p.only-y {
    display: block;
  }
  .pricing:has(.yearly:checked) .only-m {
    display: none;
  }
</style>
