---
// Vrai QR code, dessiné en SVG au moment de la construction.
import qrcode from 'qrcode-generator';
interface Props {
  text: string;
  size?: number;
  color?: string;
  label?: string;
}
const {text, size = 120, color = '#111114', label = 'QR code'} = Astro.props;
const q = qrcode(0, 'M');
q.addData(text);
q.make();
const n = q.getModuleCount();
let d = '';
for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) d += `M${c + 2} ${r + 2}h1v1h-1z`;
---

<svg width={size} height={size} viewBox={`0 0 ${n + 4} ${n + 4}`} shape-rendering="crispEdges" role="img" aria-label={label}>
  <rect width={n + 4} height={n + 4} fill="#fff"></rect>
  <path d={d} fill={color}></path>
</svg>
