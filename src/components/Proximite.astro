---
// Notification de proximité : écran de verrouillage d'un iPhone en HTML/CSS (aucune image). Quand le client passe
// près de la boutique, sa carte s'affiche avec un court message (docs/OFFRES.md du dépôt LOYNA, § 4). Exemple
// d'Ewan : le client passe devant sa boulangerie et la carte s'affiche.
import Phone from './Phone.astro';
import Icon from './Icon.astro';
import {initiales} from '../lib/carte-live';

interface Props {
  name?: string;
  bg?: string;
  accent?: string;
  /** Message affiché ; par défaut celui d'une récompense qui attend le client. */
  message?: string;
  width?: number;
  /** Pastille « Près de la boutique » à côté du téléphone. */
  pill?: boolean;
  class?: string;
}
const {name = 'Le Fournil d’Albane', bg = '#5B3A21', accent = '#F2C46D', width = 300, pill = true, class: cls = ''} = Astro.props;
const message = Astro.props.message ?? `Votre récompense vous attend chez ${name} !`;
const label = `Écran de verrouillage d’un iPhone près de la boutique : la carte de fidélité ${name} s’affiche avec le message « ${message} »`;
---

<div class={`prox ${cls}`} style={`--pw:${width}px`} role="img" aria-label={label}>
  <Phone width={width} screen="#0E1013">
    <div class="ls">
      <p class="ls-day">Samedi</p>
      <p class="ls-time">9:41</p>
      <div class="ls-notif">
        <span class="ls-icon" style={`background:${bg};color:${accent}`}>{initiales(name.replace(/\b[dl][’'](?=\p{L})/giu, ''))}</span>
        <span class="ls-body">
          <span class="ls-app">Wallet <small>maintenant</small></span>
          <b>{name}</b>
          <span>{message}</span>
        </span>
      </div>
    </div>
  </Phone>
  {
    pill && (
      <span class="prox-pill">
        <span class="ping">
          <Icon name="map-pin" size={15} />
        </span>
        Près de la boutique
      </span>
    )
  }
</div>

<style>
  .prox {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 100%;
  }
  .ls {
    position: absolute;
    inset: 0;
    padding: calc(var(--pw) * 0.2) calc(var(--pw) * 0.05) 0;
    color: #fff;
    text-align: center;
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(214, 160, 84, 0.55), transparent 70%),
      linear-gradient(180deg, #4a3319 0%, #24180c 55%, #0E1013 100%);
  }
  .ls p {
    margin: 0;
    color: #fff;
  }
  .ls-day {
    font-size: calc(var(--pw) * 0.058);
    font-weight: 600;
    opacity: 0.9;
  }
  .ls-time {
    font-size: calc(var(--pw) * 0.24);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .ls-notif {
    margin-top: calc(var(--pw) * 0.1);
    display: flex;
    gap: calc(var(--pw) * 0.035);
    align-items: flex-start;
    text-align: left;
    padding: calc(var(--pw) * 0.04) calc(var(--pw) * 0.042);
    border-radius: calc(var(--pw) * 0.065);
    background: rgba(233, 236, 239, 0.94);
    color: #15171B;
    font-size: calc(var(--pw) * 0.045);
    line-height: 1.3;
    box-shadow: 0 calc(var(--pw) * 0.04) calc(var(--pw) * 0.1) rgba(0, 0, 0, 0.35);
    animation: prox-in 7s cubic-bezier(0.16, 1, 0.3, 1) 0.8s infinite both;
  }
  .ls-icon {
    width: calc(var(--pw) * 0.11);
    height: calc(var(--pw) * 0.11);
    border-radius: calc(var(--pw) * 0.026);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: calc(var(--pw) * 0.038);
  }
  .ls-body {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .ls-app {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: calc(var(--pw) * 0.034);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b665c;
  }
  .ls-app small {
    font-size: 1em;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
  .prox-pill {
    position: absolute;
    left: -6%;
    bottom: 18%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px 9px 9px;
    border-radius: 999px;
    background: #fff;
    color: #111316;
    font-weight: 700;
    font-size: 0.88rem;
    white-space: nowrap;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
  }
  .ping {
    position: relative;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--gold-soft);
    color: var(--gold-strong);
  }
  .ping::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(123, 77, 255, 0.6);
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes prox-in {
    0% {
      transform: translateY(-30%);
      opacity: 0;
    }
    8%,
    82% {
      transform: none;
      opacity: 1;
    }
    92%,
    100% {
      transform: translateY(-30%);
      opacity: 0;
    }
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ls-notif,
    .ping::after {
      animation: none;
    }
  }
  @media (max-width: 520px) {
    .prox-pill {
      left: 0;
      bottom: 14%;
      font-size: 0.82rem;
    }
  }
</style>
