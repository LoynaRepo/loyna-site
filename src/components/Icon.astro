---
// Icône Lucide intégrée au HTML au moment de la construction (aucun JavaScript, aucune requête).
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const {name, size = 24, class: cls = '', label} = Astro.props;
const files = import.meta.glob<string>('/node_modules/lucide-static/icons/*.svg', {query: '?raw', import: 'default', eager: true});
const raw = files[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Icône inconnue : ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/\s(width|height)="24"/g, '')
  .replace('<svg', `<svg width="${size}" height="${size}" class="${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`)
  .replace(/\n\s*/g, '');
---

<Fragment set:html={svg} />
