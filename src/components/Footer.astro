---
import Logo from './Logo.astro';
import {SITE} from '../data/site';
import {getSectors} from '../lib/builder';
interface Props {
  consent?: boolean;
}
const {consent = false} = Astro.props;
const year = new Date().getFullYear();
// Tous les métiers, y compris ceux ajoutés depuis Builder.io (même liste et même ordre que /secteurs/)
const sectors = await getSectors();
const cols: {title: string; wide?: boolean; links: [string, string][]}[] = [
  {
    title: 'Produit',
    links: [
      ['/fonctionnalites/', 'Fonctionnalités'],
      ['/tarifs/', 'Tarifs'],
      ['/creer-ma-carte/', 'Créer ma carte'],
      ['/demo/', 'Démo vidéo'],
      ['/espace-client/', 'Espace client'],
    ],
  },
  {
    title: 'Secteurs',
    wide: true,
    links: sectors.map((s): [string, string] => [`/secteurs/${s.slug}/`, s.nom]),
  },
  {
    title: 'Ressources',
    links: [
      ['/blog/', 'Blog'],
      ['/faq/', 'Questions fréquentes'],
      ['/a-propos/', 'À propos de LOYNA'],
      ['/contact/', 'Contact'],
      ['/plan-du-site/', 'Plan du site'],
    ],
  },
  {
    title: 'Informations légales',
    links: [
      ['/mentions-legales/', 'Mentions légales'],
      ['/cgv/', 'CGV'],
      ['/cgu/', 'CGU'],
      ['/confidentialite/', 'Confidentialité'],
      ['/cookies/', 'Cookies'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo height={34} tone="light" />
        <p>La carte de fidélité digitale des commerces indépendants, dans Apple Wallet et Google Wallet. Conçue à {SITE.city}.</p>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <address>
          LOYNA, une marque de KOVA Elec<br />
          {SITE.address.street}<br />
          {SITE.address.postalCode} {SITE.address.locality}
        </address>
      </div>
      {
        cols.map((c) => (
          <nav aria-label={c.title} class={c.wide ? 'wide' : undefined}>
            <p class="col-title">{c.title}</p>
            <ul>
              {c.links.map(([href, label]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="bottom">
      <p>
        © {year} LOYNA · {SITE.address.locality}, {SITE.region} · Prix en euros, sans TVA ({SITE.vatNote})
        {consent && (
          <>
            {' · '}
            <button type="button" class="linkish" data-open-consent>Gérer les cookies</button>
          </>
        )}
      </p>
      <p>Apple Wallet est une marque d'Apple Inc. Google Wallet est une marque de Google LLC.</p>
    </div>
  </div>
</footer>

<style>
  address {
    font-style: normal;
    margin-top: 14px;
    line-height: 1.6;
    font-size: 0.92rem;
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .site-footer {
    background: var(--ink);
    color: #b9b3a7;
    padding: clamp(56px, 8vw, 96px) 0 32px;
    font-size: 0.97rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1.7fr 0.9fr 2.1fr 1.1fr 1fr;
    gap: 36px;
  }
  /* Secteurs : tous les métiers, sur deux colonnes */
  .wide ul {
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
  }
  .about p {
    margin: 20px 0 14px;
    max-width: 320px;
  }
  .mail {
    color: #e6c27a;
    font-weight: 600;
  }
  .col-title {
    color: #faf7f0;
    font-weight: 700;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  a {
    color: #b9b3a7;
    text-decoration: none;
  }
  a:hover {
    color: #faf7f0;
    text-decoration: underline;
  }
  .bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(250, 247, 240, 0.1);
    font-size: 0.85rem;
    color: #8f897e;
  }
  .bottom p {
    margin: 0 0 6px;
  }
  @media (max-width: 960px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about,
    .wide {
      grid-column: 1 / -1;
    }
    /* liens plus hauts : faciles à toucher */
    ul {
      gap: 0;
    }
    ul a,
    .mail {
      display: inline-block;
      padding-block: 10px;
    }
    .col-title {
      margin-bottom: 4px;
    }
  }
</style>
