---
import Logo from './Logo.astro';
import Jonction from './Jonction.astro';
import type {Teinte} from './Jonction.astro';
import {SITE} from '../data/site';
import {getSectors} from '../lib/builder';
interface Props {
  consent?: boolean;
  /** Fond de la dernière section de la page (par défaut : crème). */
  de?: Teinte;
}
const {consent = false, de = 'creme'} = Astro.props;
const year = new Date().getFullYear();
// Réseaux sociaux de la marque (SITE.sameAs) : nom et pictogramme d'après l'adresse
const reseaux = SITE.sameAs
  .map((url) => ({url, nom: /instagram\.com/.test(url) ? 'Instagram' : /tiktok\.com/.test(url) ? 'TikTok' : ''}))
  .filter((r) => r.nom);
// Tous les métiers, y compris ceux ajoutés depuis Builder.io (même liste et même ordre que /secteurs/)
const sectors = await getSectors();
const cols: {title: string; wide?: boolean; links: [string, string][]}[] = [
  {
    title: 'Produit',
    links: [
      ['/fonctionnalites/', 'Fonctionnalités'],
      ['/tarifs/', 'Tarifs'],
      ['/creer-ma-carte/', 'Créer ma carte'],
      ['/demo/', 'Démo vidéo'],
      ['/espace-client/', 'Espace client'],
    ],
  },
  {
    title: 'Secteurs',
    wide: true,
    links: sectors.map((s): [string, string] => [`/secteurs/${s.slug}/`, s.nom]),
  },
  {
    title: 'Ressources',
    links: [
      ['/blog/', 'Blog'],
      ['/faq/', 'Questions fréquentes'],
      ['/a-propos/', 'À propos de LOYNA'],
      ['/devenir-partenaire/', 'Devenir partenaire'],
      ['/contact/', 'Contact'],
      ['/plan-du-site/', 'Plan du site'],
    ],
  },
  {
    title: 'Informations légales',
    links: [
      ['/mentions-legales/', 'Mentions légales'],
      ['/cgv/', 'CGV'],
      ['/cgu/', 'CGU'],
      ['/confidentialite/', 'Confidentialité'],
      ['/cookies/', 'Cookies'],
    ],
  },
];
---

<Jonction de={de} vers="nuit" forme={5} retourne />
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <Logo height={34} tone="light" />
        <p>La carte de fidélité digitale des commerces indépendants, dans Apple Wallet et Google Wallet. Conçue à {SITE.city}.</p>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {
          reseaux.length > 0 && (
            <ul class="reseaux" aria-label="LOYNA sur les réseaux sociaux">
              {reseaux.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="me noopener" aria-label={`LOYNA sur ${r.nom}`}>
                    {r.nom === 'Instagram' ? (
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4.2" />
                        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                        <path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3.1c-1.4.1-2.6-.3-3.9-1.1v6.1c0 3.9-2.6 6.1-5.8 6.1-3.3 0-5.6-2.5-5.4-5.7.2-3 2.8-5.2 6.1-4.9v3.2c-1.5-.3-2.9.5-3 2-.1 1.4.9 2.4 2.2 2.4 1.4 0 2.4-.9 2.4-2.6V3h3.5z" />
                      </svg>
                    )}
                    <span>{r.nom}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <address>
          LOYNA, une marque de KOVA Elec<br />
          {SITE.address.street}<br />
          {SITE.address.postalCode} {SITE.address.locality}
        </address>
      </div>
      {
        cols.map((c) => (
          <nav aria-label={c.title} class={c.wide ? 'wide' : undefined}>
            <p class="col-title">{c.title}</p>
            <ul>
              {c.links.map(([href, label]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="bottom">
      <p>
        © {year} LOYNA · {SITE.address.locality}, {SITE.region} · Prix en euros, sans TVA ({SITE.vatNote})
        {consent && (
          <>
            {' · '}
            <button type="button" class="linkish" data-open-consent>Gérer les cookies</button>
          </>
        )}
      </p>
      <p>Apple Wallet est une marque d'Apple Inc. Google Wallet est une marque de Google LLC.</p>
    </div>
  </div>
</footer>

<style>
  address {
    font-style: normal;
    margin-top: 14px;
    line-height: 1.6;
    font-size: 0.92rem;
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .site-footer {
    position: relative;
    background: var(--ink);
    color: #A9B0B8;
    padding: clamp(28px, 4vw, 56px) 0 32px;
    font-size: 0.97rem;
  }
  .top {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px 24px;
  }
  .about,
  .wide {
    grid-column: 1 / -1;
  }
  /* Secteurs : tous les métiers, sur deux colonnes */
  .wide ul {
    grid-template-columns: 1fr 1fr;
    column-gap: 18px;
  }
  .about p {
    margin: 20px 0 14px;
    max-width: 340px;
  }
  .mail {
    color: #A487FF;
    font-weight: 600;
  }
  .reseaux {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
  }
  .reseaux a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(233, 236, 239, 0.18);
    border-radius: 999px;
    color: #E9ECEF;
    font-weight: 600;
    text-decoration: none;
  }
  .reseaux a:hover {
    border-color: #A487FF;
    color: #A487FF;
    text-decoration: none;
  }
  .col-title {
    color: #A487FF;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  ul a,
  .mail {
    display: inline-block;
    padding-block: 11px;
    line-height: 1.35;
  }
  a {
    color: #A9B0B8;
    text-decoration: none;
  }
  a:hover {
    color: #E9ECEF;
    text-decoration: underline;
  }
  .bottom {
    position: relative;
    z-index: 2;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid rgba(233, 236, 239, 0.1);
    font-size: 0.85rem;
    color: #8f897e;
  }
  .bottom p {
    margin: 0 0 6px;
  }
  @media (min-width: 961px) {
    .top {
      grid-template-columns: 1.55fr 0.85fr 2.15fr 1.1fr 1.1fr;
      gap: 36px;
    }
    .about,
    .wide {
      grid-column: auto;
    }
    .col-title {
      margin-bottom: 10px;
    }
    ul a,
    .mail {
      padding-block: 5px;
    }
    .wide ul {
      column-gap: 24px;
    }
  }
</style>
