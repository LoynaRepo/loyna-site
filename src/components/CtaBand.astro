---
import Icon from './Icon.astro';
import {APPEL, PHRASES, TRIAL} from '../data/site';
interface Props {
  title?: string;
  text?: string;
  /** Lien « être rappelé » (ancre du formulaire de rappel si la page en a un). */
  callbackHref?: string;
}
const {
  callbackHref = '/#rappel',
  title = 'Prêt à faire revenir vos clients ?',
  text = TRIAL.open ? PHRASES.essai : 'Créez l’aperçu de votre carte en quelques secondes, puis choisissez votre offre. Votre carte est prête sous 24 h.',
} = Astro.props;
// Symbole en filigrane, sans son dégradé : teinté par .filigrane
const filigrane = '<svg aria-hidden="true" viewBox="0 0 640 572"><defs><mask id="fil-cta" style="mask-type:alpha"><image href="/marque/silhouette.png" width="640" height="572"/></mask></defs><rect width="640" height="572" fill="currentColor" mask="url(#fil-cta)"/></svg>';
---

<section class="section cta-section" aria-label="Passer à l'action">
  <div class="container">
    <div class="cta-band">
      <span class="filigrane cta-filigrane" set:html={filigrane} />
      <h2>{title.replace(' ?', ' ?')}</h2>
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn--gold" href={APPEL.href}>{APPEL.label} <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn--ghost" href="/creer-ma-carte/">Créer l’aperçu de ma carte</a>
      </div>
      <p class="cta-alt">{TRIAL.open && <><a href="/tarifs/">Voir les tarifs</a> · </>}Une question avant de vous lancer ? <a href={callbackHref}>Être rappelé gratuitement</a></p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--bg);
  }
  .cta-band .cta-filigrane {
    position: absolute;
    right: -4%;
    bottom: -22%;
    width: min(52%, 460px);
  }
</style>
