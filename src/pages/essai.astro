---
// Essai gratuit depuis le site (décision d'Ewan du 2026-10-31) : 1 mois de Starter, sans carte bancaire. Page non indexée, hors du
// plan du site. Île Preact src/app/Essai.tsx ; serveur : Edge Function trial (dépôt LOYNA). `TRIAL.open` faux : la page dit que
// l'essai n'est pas ouvert et propose l'abonnement, tous les boutons du site mènent alors ailleurs.
import Base from '../layouts/Base.astro';
import Jonction from '../components/Jonction.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Essai from '../app/Essai';
import {PHRASES, TRIAL} from '../data/site';
import '../styles/panier.css';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: TRIAL.open ? 'Essai gratuit' : 'Votre carte', url: '/essai/'},
];
---

<Base noindex stickyCta={false} finPage="creme" title={TRIAL.open ? 'Essayer LOYNA 1 mois gratuitement' : 'Votre carte de fidélité LOYNA'} description={TRIAL.open ? '1 mois gratuit, sans carte bancaire : votre carte de fidélité Apple Wallet et Google Wallet, créée tout de suite à partir de vos réglages.' : 'Votre carte de fidélité Apple Wallet et Google Wallet : choisissez votre offre, ou recevez un aperçu de votre carte.'} breadcrumbs={crumbs}>
  <section class="page-hero pn-hero es-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{TRIAL.open ? 'Essai gratuit' : 'LOYNA'}</p>
      <h1>{TRIAL.open ? 'Essayez LOYNA 1 mois gratuitement' : 'Votre carte de fidélité LOYNA'}</h1>
      {TRIAL.open && <p class="lead">{PHRASES.essai}</p>}
    </div>
  </section>
  <Jonction de="sable" vers="creme" forme={3} retourne />

  <section class="section pn-section">
    <div class="container">
      <Essai client:only="preact">
        <div slot="fallback" class="pn-wait" role="status">Chargement de l’essai…</div>
      </Essai>
      <noscript>
        <p class="pn-wait">L’essai a besoin de JavaScript. Activez-le dans votre navigateur, ou écrivez-nous à <a href="mailto:contact@loyna.fr">contact@loyna.fr</a>.</p>
      </noscript>
    </div>
  </section>
</Base>

<style is:global>
  /* Fin de parcours : essai fermé, adresse à confirmer, carte prête */
  .es-fin {
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .es-fin h2 {
    margin: 0 0 14px;
  }
  .es-fin p {
    margin: 0 0 14px;
    overflow-wrap: anywhere;
  }
  .es-fin .btn-row {
    justify-content: center;
    margin-top: 22px;
  }
  .es-fin:focus {
    outline: none;
  }
  /* Champs absents du panier : liste, curseur, recherche */
  .pn .field select,
  .es-cherche input {
    width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
  }
  .pn .field select:focus-visible,
  .es-cherche input:focus-visible {
    outline: 3px solid rgba(201, 150, 63, 0.45);
    outline-offset: 1px;
    border-color: var(--gold);
  }
  .pn .field select[aria-invalid='true'] {
    border-color: #b3261e;
    background: #fff7f6;
  }
  .pn .field .es-autre {
    margin-top: 8px;
  }
  /* Carte au passage ou au montant dépensé (2026-11-04) */
  .pn .es-mode {
    margin: 4px 0 14px;
  }
  .pn .field .es-aide {
    display: block;
    margin-top: 2px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  /* Curseur dessiné à la main, comme celui du calculateur : même rendu sur tous les navigateurs */
  .pn .field input.es-curseur {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    touch-action: pan-y;
  }
  .pn .field input.es-curseur:focus {
    border: 0;
    box-shadow: none;
    outline: none;
  }
  .pn .field input.es-curseur:focus-visible {
    outline: 3px solid rgba(230, 194, 122, 0.5);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .es-curseur::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, #a87530, #e6c27a var(--p, 50%), rgba(18, 18, 22, 0.12) var(--p, 50%));
  }
  .es-curseur::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 24px;
    height: 24px;
    margin-top: -8px;
    border-radius: 50%;
    background: #fff;
    border: 4px solid #c9963f;
    box-shadow: 0 4px 12px rgba(18, 18, 22, 0.28);
  }
  .es-curseur::-moz-range-track {
    height: 8px;
    border-radius: 999px;
    background: rgba(18, 18, 22, 0.12);
  }
  .es-curseur::-moz-range-progress {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, #a87530, #e6c27a);
  }
  .es-curseur::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    border: 4px solid #c9963f;
    box-shadow: 0 4px 12px rgba(18, 18, 22, 0.28);
  }
  .es-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  /* Ronds de couleur : mêmes couleurs et même rond libre que le configurateur */
  .es-sw {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .es-rond {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--c);
    cursor: pointer;
  }
  .es-rond[aria-pressed='true'],
  .es-libre.is-picked {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--ink);
  }
  .es-rond:focus-visible,
  .es-libre:focus-within {
    outline: 3px solid rgba(201, 150, 63, 0.6);
    outline-offset: 3px;
  }
  .es-libre {
    background: var(--roue-couleur);
    overflow: hidden;
  }
  .es-libre.is-picked {
    background:
      radial-gradient(circle closest-side, var(--pick) 0 50%, #fff 54% 63%, rgb(255 255 255 / 0) 67%),
      var(--roue-arc);
  }
  .es-libre input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .pn .field label.es-rond {
    margin: 0;
  }
  /* Recherche du SIRET */
  .es-cherche {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .es-cherche > label {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .es-cherche-l {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .es-cherche-l .btn {
    min-height: 46px;
    padding: 8px 18px;
    font-size: 0.95rem;
  }
  .es-cherche p {
    margin: 4px 0 0;
  }
  .es-resultats {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .es-resultats button {
    width: 100%;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-size: 0.92rem;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .es-resultats button:hover,
  .es-resultats button:focus-visible {
    border-color: var(--ink);
  }
  .es-resultats span,
  .es-resultats small {
    color: var(--muted);
  }
  /* Aperçu de la carte */
  .es-apercu {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .es-apercu .cw-tel {
    width: 250px;
  }
  .es-apercu .cw-tel .cw {
    font-size: 10.5px;
  }
  .es-sum .pn-prep-sys {
    margin-bottom: 0;
    color: #f8f4ec;
  }
  .es-sum .pn-then {
    color: #d9d4c9;
  }
  /* En-tête compact : la première question doit se voir sans défiler */
  body .page-hero.es-hero {
    padding-top: clamp(20px, 3vw, 40px);
    padding-bottom: clamp(10px, 1.6vw, 20px);
  }
  body .page-hero.es-hero h1 {
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
  }
  body .page-hero.es-hero .breadcrumbs {
    margin-bottom: 10px;
  }
  @media (max-width: 720px) {
    body .page-hero.es-hero .lead,
    body .page-hero.es-hero .eyebrow {
      display: none;
    }
  }
  /* Renvoi du lien, sur l'écran « Vérifiez votre boîte mail » */
  .es-renvoi {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .es-renvoi p {
    margin: 0;
  }
  .es-renvoi-b {
    min-width: 260px;
    min-height: 52px;
  }
  .es-renvoi-b:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .es-renvoi-ok {
    color: #1f6b3a;
    font-weight: 600;
  }
  /* Funnel (2026-11-07) : une question par écran, l'aperçu du téléphone à droite sur ordinateur */
  .es-funnel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
    max-width: 1040px;
    margin-inline: auto;
  }
  .es-q {
    min-width: 0;
    padding: clamp(20px, 3.4vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .es-prog {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(18px, 3vw, 28px);
  }
  .es-prog-l {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 36px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .es-retour {
    padding: 6px 10px 6px 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
  }
  .es-barre {
    height: 6px;
    border-radius: 999px;
    background: rgba(18, 18, 22, 0.1);
    overflow: hidden;
  }
  .es-barre span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #a87530, #e6c27a);
    transition: width 0.3s ease;
  }
  .pn.es-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .es-form h2 {
    margin: 0;
    font-size: clamp(1.45rem, 3.6vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .es-form h2:focus {
    outline: none;
  }
  .es-sous {
    margin: -6px 0 4px;
    color: var(--muted);
  }
  .es-choix {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .es-choix:focus {
    outline: none;
  }
  .es-choix button {
    min-height: 56px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1.5px solid var(--line);
    background: #fff;
    font: inherit;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .es-choix button:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  .es-choix button[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: #faf7f0;
  }
  .es-choix button:focus-visible {
    outline: 3px solid rgba(201, 150, 63, 0.6);
    outline-offset: 2px;
  }
  .pn .field input.es-grand {
    min-height: 58px;
    font-size: 1.15rem;
  }
  .es-go {
    justify-self: start;
    min-width: 220px;
    min-height: 54px;
    font-size: 1.05rem;
  }
  .es-mode {
    justify-self: start;
  }
  .es-couleurs summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
  }
  .es-couleurs[open] summary {
    margin-bottom: 12px;
  }
  .es-parrain {
    justify-self: start;
  }
  .es-fin-note {
    margin: -6px 0 0;
  }
  .es-mini {
    display: none;
    width: 100%;
    max-width: 340px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .es-mini .cw {
    font-size: 12px;
  }
  /* Téléphone et tablette : la carte dans l'écran, pas de colonne d'aperçu ; boutons sur toute la largeur, au pouce */
  @media (max-width: 980px) {
    .es-funnel {
      grid-template-columns: 1fr;
    }
    .es-sum {
      display: none;
    }
    .es-mini {
      display: block;
      justify-self: center;
    }
  }
  @media (max-width: 720px) {
    .es-choix {
      grid-template-columns: 1fr 1fr;
    }
    .es-go,
    .es-mode {
      justify-self: stretch;
    }
  }
  @media (max-width: 720px) {
    .es-cherche-l {
      grid-template-columns: 1fr;
    }
    .es-rond {
      width: 32px;
      height: 32px;
    }
  }
</style>
