---
// Essai gratuit depuis le site (décision d'Ewan du 2026-10-31) : 1 mois de Starter, sans carte bancaire. Page non indexée, hors du
// plan du site. Île Preact src/app/Essai.tsx ; serveur : Edge Function trial (dépôt LOYNA). `TRIAL.open` faux : la page dit que
// l'essai n'est pas ouvert et propose l'abonnement, tous les boutons du site mènent alors ailleurs.
import Base from '../layouts/Base.astro';
import Jonction from '../components/Jonction.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Essai from '../app/Essai';
import {PHRASES, TRIAL} from '../data/site';
import '../styles/panier.css';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: TRIAL.open ? 'Essai gratuit' : 'Votre carte', url: '/essai/'},
];
---

<Base noindex stickyCta={false} finPage="creme" title={TRIAL.open ? 'Essayer LOYNA 1 mois gratuitement' : 'Votre carte de fidélité LOYNA'} description={TRIAL.open ? '1 mois gratuit, sans carte bancaire : votre carte de fidélité Apple Wallet et Google Wallet, créée tout de suite à partir de vos réglages.' : 'Votre carte de fidélité Apple Wallet et Google Wallet : choisissez votre offre, ou recevez un aperçu de votre carte.'} breadcrumbs={crumbs}>
  <section class="page-hero pn-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{TRIAL.open ? 'Essai gratuit' : 'LOYNA'}</p>
      <h1>{TRIAL.open ? 'Essayez LOYNA 1 mois gratuitement' : 'Votre carte de fidélité LOYNA'}</h1>
      {TRIAL.open && <p class="lead">{PHRASES.essai}</p>}
    </div>
  </section>
  <Jonction de="sable" vers="creme" forme={3} retourne />

  <section class="section pn-section">
    <div class="container">
      <Essai client:only="preact">
        <div slot="fallback" class="pn-wait" role="status">Chargement de l’essai…</div>
      </Essai>
      <noscript>
        <p class="pn-wait">L’essai a besoin de JavaScript. Activez-le dans votre navigateur, ou écrivez-nous à <a href="mailto:contact@loyna.fr">contact@loyna.fr</a>.</p>
      </noscript>
    </div>
  </section>
</Base>

<style is:global>
  /* Fin de parcours : essai fermé, adresse à confirmer, carte prête */
  .es-fin {
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .es-fin h2 {
    margin: 0 0 14px;
  }
  .es-fin p {
    margin: 0 0 14px;
    overflow-wrap: anywhere;
  }
  .es-fin .btn-row {
    justify-content: center;
    margin-top: 22px;
  }
  .es-fin:focus {
    outline: none;
  }
  /* Champs absents du panier : liste, curseur, recherche */
  .pn .field select,
  .es-cherche input {
    width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
  }
  .pn .field select:focus-visible,
  .es-cherche input:focus-visible {
    outline: 3px solid rgba(201, 150, 63, 0.45);
    outline-offset: 1px;
    border-color: var(--gold);
  }
  .pn .field select[aria-invalid='true'] {
    border-color: #b3261e;
    background: #fff7f6;
  }
  .pn .field .es-autre {
    margin-top: 8px;
  }
  .pn .field input.es-curseur {
    min-height: 34px;
    padding: 0;
    border: 0;
    background: transparent;
    accent-color: var(--ink);
  }
  .es-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  /* Ronds de couleur : mêmes couleurs et même rond libre que le configurateur */
  .es-sw {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .es-rond {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--c);
    cursor: pointer;
  }
  .es-rond[aria-pressed='true'],
  .es-libre.is-picked {
    box-shadow:
      0 0 0 2px var(--bg),
      0 0 0 4px var(--ink);
  }
  .es-rond:focus-visible,
  .es-libre:focus-within {
    outline: 3px solid rgba(201, 150, 63, 0.6);
    outline-offset: 3px;
  }
  .es-libre {
    background: var(--roue-couleur);
    overflow: hidden;
  }
  .es-libre.is-picked {
    background:
      radial-gradient(circle closest-side, var(--pick) 0 50%, #fff 54% 63%, rgb(255 255 255 / 0) 67%),
      var(--roue-arc);
  }
  .es-libre input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .es-logo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .pn .field label.es-rond {
    margin: 0;
  }
  .pn .field label.es-logo-b {
    display: inline-flex;
    margin: 0;
  }
  .es-logo-b {
    position: relative;
    min-height: 46px;
    padding: 10px 18px;
    font-size: 0.95rem;
    overflow: hidden;
  }
  .es-logo-b input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    font-size: 0;
  }
  .es-logo-b:focus-within {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  /* Recherche du SIRET */
  .es-cherche {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .es-cherche > label {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .es-cherche-l {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }
  .es-cherche-l .btn {
    min-height: 46px;
    padding: 8px 18px;
    font-size: 0.95rem;
  }
  .es-cherche p {
    margin: 4px 0 0;
  }
  .es-resultats {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .es-resultats button {
    width: 100%;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    font: inherit;
    font-size: 0.92rem;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    overflow-wrap: anywhere;
  }
  .es-resultats button:hover,
  .es-resultats button:focus-visible {
    border-color: var(--ink);
  }
  .es-resultats span,
  .es-resultats small {
    color: var(--muted);
  }
  /* Aperçu de la carte */
  .es-apercu {
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .es-apercu .cw-tel {
    width: 250px;
  }
  .es-apercu .cw-tel .cw {
    font-size: 10.5px;
  }
  .es-sum .pn-prep-sys {
    margin-bottom: 0;
    color: #f8f4ec;
  }
  .es-sum .pn-then {
    color: #d9d4c9;
  }
  .es-mini {
    display: none;
    max-width: 320px;
    margin-inline: auto;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Téléphone et tablette : la carte reste visible en haut du formulaire, le téléphone complet sous le formulaire */
  @media (max-width: 980px) {
    .es-mini {
      display: block;
    }
  }
  .es-mini .cw {
    font-size: 12px;
  }
  @media (max-width: 720px) {
    .es-cherche-l {
      grid-template-columns: 1fr;
    }
    .es-rond {
      width: 32px;
      height: 32px;
    }
  }
</style>
