---
import {Picture} from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import PricingCards from '../components/PricingCards.astro';
import VideoFacade from '../components/VideoFacade.astro';
import WalletCard from '../components/WalletCard.astro';
import CtaBand from '../components/CtaBand.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import CallbackForm from '../components/CallbackForm.astro';
import Proximite from '../components/Proximite.astro';
import {getFaq, getSectors, getSettings} from '../lib/builder';
import {LAUNCH_OFFER, MARKETING_INTERVAL_HOURS, PLANS, SITE, offerActive} from '../data/site';
import scanQr from '../assets/shots/scan-qr.png';
import inscription from '../assets/shots/inscription.png';
import ajoutWallet from '../assets/shots/ajout-wallet.png';
import passageValide from '../assets/shots/passage-valide.png';
import notifications from '../assets/shots/notifications.png';

const settings = await getSettings();
const sectors = await getSectors();
const faq = (await getFaq()).slice(0, 6);
// Titre d'accueil : les mots entre *astérisques* (réglage Builder) sont mis en valeur en doré.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const heroTitleHtml = esc(settings.heroTitle).replace(/\*(.+?)\*/g, '<span class="gold-text">$1</span>');

const steps = [
  {img: scanQr, title: 'Il scanne votre QR code', text: 'Sur votre comptoir, en vitrine ou sur vos réseaux : un QR code suffit pour rejoindre votre programme.'},
  {img: inscription, title: "Il s'inscrit en quelques secondes", text: 'Un formulaire très court, des consentements clairs et séparés. Aucune application à télécharger.'},
  {img: ajoutWallet, title: 'Sa carte arrive dans son Wallet', text: 'Un geste et la carte est dans Apple Wallet ou Google Wallet, toujours dans sa poche.'},
];

const features = [
  {icon: 'wallet', title: 'Carte Apple & Google Wallet', text: 'À vos couleurs, avec votre logo et votre récompense. Elle se met à jour toute seule.'},
  {icon: 'map-pin', title: 'Notification de proximité', text: 'Votre client passe près de la boutique : sa carte s’affiche sur l’écran de verrouillage. Dans toutes les formules.'},
  {icon: 'scan-line', title: 'Un scan, un passage', text: 'Pas de recherche, pas de bouton +1 : le passage est validé dès le scan, avec protection anti double scan.'},
  {icon: 'gift', title: 'Récompenses automatiques', text: 'Au seuil fixé, la récompense se débloque et le client est prévenu sur son téléphone.'},
  {icon: 'megaphone', title: 'Campagnes de notifications', text: 'Une offre, une nouveauté : le message arrive sur le téléphone de vos clients, sans coût par envoi.'},
  {icon: 'workflow', title: 'Automatisations', text: 'Anniversaire, relance des inactifs, « Plus qu’un passage ! », avis Google : avec Premium, les messages partent tout seuls.'},
  {icon: 'users', title: 'Toute votre équipe', text: 'Un compte par personne, des rôles et des droits adaptés, sans limite d’employés.'},
  {icon: 'shield-check', title: 'Données protégées', text: 'Hébergées dans l’Union européenne, chiffrées, consentements séparés, export et suppression à la demande.'},
];
const offer = offerActive();

const softwareLd = {
  '@type': 'SoftwareApplication',
  name: 'LOYNA',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, Android, Web',
  description: SITE.description,
  url: SITE.url,
  publisher: {'@id': `${SITE.url}/#organisation`},
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: Math.min(...PLANS.map((p) => p.monthly)),
    highPrice: Math.max(...PLANS.map((p) => p.monthly)),
    offerCount: PLANS.length,
  },
};
---

<Base
  title="Loyna : la carte de fidélité digitale Apple et Google Wallet"
  description={SITE.description}
  jsonLd={softwareLd}
>
  <Hero titleHtml={heroTitleHtml} subtitle={settings.heroSubtitle} sectors={sectors} />

  <section class="strip" aria-label="Compatibilité">
    <div class="container strip-row">
      <span><Icon name="wallet" size={18} /> Apple Wallet</span>
      <span><Icon name="wallet" size={18} /> Google Wallet</span>
      <span><Icon name="smartphone" size={18} /> iPhone et Android</span>
      <span><Icon name="shield-check" size={18} /> Données hébergées dans l’UE</span>
      <span><Icon name="lock" size={18} /> Paiement sécurisé Stripe</span>
    </div>
  </section>

  <section class="section section--warm" id="video">
    <div class="container split">
      <VideoFacade />
      <div>
        <p class="eyebrow">Présentation vidéo</p>
        <h2>LOYNA en 80 secondes</h2>
        <p class="lead">Du QR code d’inscription à la récompense débloquée, en passant par les notifications et le tableau de bord : voyez tout le parcours, côté client et côté commerçant.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/creer-ma-carte/">Créer l’aperçu de ma carte</a>
          <a class="btn btn--ghost" href="/demo/">Voir la démo complète</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Le constat</p>
        <h2>La carte à tampons a fait son temps</h2>
        <p>Perdue au fond d’un sac, oubliée à la maison, jetée au premier tri : la carte papier ne fait revenir personne. Et quand un client ne revient plus, vous n’avez aucun moyen de le relancer.</p>
      </div>
      <div class="grid grid-3">
        <div class="card compare">
          <p class="before">Carte papier perdue ou oubliée</p>
          <h3>Toujours dans le téléphone</h3>
          <p>La carte vit dans Apple Wallet ou Google Wallet, à côté de la carte bancaire. Impossible de la perdre.</p>
        </div>
        <div class="card compare">
          <p class="before">Aucun contact avec vos clients</p>
          <h3>Des notifications qui font revenir</h3>
          <p>Récompense disponible, passage devant la boutique, anniversaire : le bon message arrive au bon moment.</p>
        </div>
        <div class="card compare">
          <p class="before">Aucune idée de ce qui marche</p>
          <h3>Un tableau de bord clair</h3>
          <p>Clients actifs, passages, récompenses débloquées et utilisées : pilotez votre fidélité avec de vrais chiffres.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--warm" id="comment-ca-marche">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Comment ça marche</p>
        <h2>Pour vos clients, trois gestes</h2>
        <p>Aucune application à installer, aucun compte à créer : la carte s’ajoute au Wallet du téléphone, comme une carte d’embarquement.</p>
      </div>
      <ol class="steps" aria-label="Les trois étapes">
        {
          steps.map((s, i) => (
            <li class="step">
              <div class="shot">
                <Picture src={s.img} formats={['avif', 'webp']} fallbackFormat="webp" widths={[300, 460]} sizes="(max-width: 700px) 80vw, 300px" alt={s.title} loading="lazy" />
              </div>
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="swipe-hint" aria-hidden="true">Faites glisser pour voir les 3 étapes →</p>
      <div class="mid-cta">
        <a class="btn btn--primary" href="/creer-ma-carte/">Voir ma carte en 1 minute <Icon name="arrow-right" size={18} /></a>
        <span>Aperçu gratuit, à vos couleurs, avant tout paiement</span>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="proximite">
    <div class="container split">
      <div>
        <p class="eyebrow">Notification de proximité</p>
        <h2>Votre client passe devant la boutique&nbsp;: sa carte s’affiche</h2>
        <p class="lead">Un habitué passe devant votre boulangerie. Sur l’écran de verrouillage de son téléphone, sa carte de fidélité s’affiche avec un court message&nbsp;: « Votre récompense vous attend chez Le Fournil d’Albane&nbsp;! ». Le bon rappel, au bon endroit.</p>
        <ul class="checks prox-checks">
          <li>Incluse dans toutes les formules, et jamais décomptée de vos notifications</li>
          <li>Sur iPhone, la carte s’affiche sur l’écran de verrouillage&nbsp;; sur Android, une notification apparaît quand le client s’attarde près de la boutique</li>
          <li>Le message suit la carte&nbsp;: récompense qui attend, passages restants, ou votre propre message</li>
          <li>LOYNA ne reçoit jamais la position de vos clients&nbsp;: c’est leur téléphone qui détecte la proximité</li>
        </ul>
        <p class="prox-note">Fonctionne quand le client a activé la localisation et laissé Wallet s’afficher sur l’écran verrouillé. Avec Pro, jusqu’à 3 boutiques.</p>
      </div>
      <div class="prox-visual">
        <Proximite width={290} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="shot narrow-shot">
        <Picture src={passageValide} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480]} sizes="(max-width: 700px) 80vw, 340px" alt="Écran LOYNA Business : passage validé, 8 sur 10" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Au comptoir</p>
        <h2>Un scan, c’est validé</h2>
        <p class="lead">Avec LOYNA Business sur votre téléphone, vous scannez la carte du client : le passage est enregistré, la carte se met à jour, la récompense se débloque toute seule au bon moment.</p>
        <ul class="checks">
          <li>Pas de tampon, pas de recherche du client, pas de bouton +1</li>
          <li>Protection anti double scan et bouton « Annuler » pendant quelques secondes</li>
          <li>Un simple smartphone suffit : aucun matériel à acheter</li>
          <li>Chaque action est tracée dans un journal d’activité</li>
        </ul>
        <a class="btn btn--ghost" href="/fonctionnalites/">Toutes les fonctionnalités</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Fonctionnalités</p>
        <h2>Tout ce qu’il faut pour fidéliser, rien de compliqué</h2>
        <p>Une carte, un scanner et des automatisations qui travaillent pour vous pendant que vous servez vos clients.</p>
      </div>
      <div class="grid grid-4 feat-list">
        {
          features.map((f) => (
            <div class="card">
              <span class="icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
      <div class="mid-cta">
        <a class="btn btn--primary" href="/tarifs/">Voir les formules <Icon name="arrow-right" size={18} /></a>
        <a href="/fonctionnalites/">Le détail des fonctionnalités</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split reverse">
      <div>
        <p class="eyebrow">Automatisations · Premium</p>
        <h2>Les messages qui font revenir, envoyés tout seuls</h2>
        <p class="lead">Avec Premium, LOYNA envoie le bon message au bon moment, sur l’écran de verrouillage de vos clients. Vous choisissez le texte et la surprise&nbsp;; ces messages automatiques ne sont jamais décomptés de vos notifications.</p>
        <ul class="checks">
          <li><strong>Anniversaire</strong>&nbsp;: un message le jour J, avec la surprise de votre choix</li>
          <li><strong>Relance des inactifs</strong>&nbsp;: un rappel aux clients qui ne reviennent plus (après 60 jours par défaut, réglable)</li>
          <li><strong>« Plus qu’un passage&nbsp;! »</strong>&nbsp;: un rappel aux clients tout proches de leur récompense</li>
          <li><strong>Avis Google</strong>&nbsp;: une demande d’avis après la 3e visite</li>
          <li><strong>Campagnes programmées et groupes de clients</strong>, et un rapport mensuel avec 3 conseils concrets</li>
        </ul>
        <p class="auto-note">Toutes les formules préviennent le client à chaque passage et quand sa récompense est débloquée. Un client reçoit au plus un message commercial toutes les {MARKETING_INTERVAL_HOURS}&nbsp;h, délai réglable.</p>
        <a class="btn btn--ghost" href="/tarifs/">Voir l’offre Premium</a>
      </div>
      <div class="shot narrow-shot">
        <Picture src={notifications} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480]} sizes="(max-width: 700px) 80vw, 340px" alt="Notifications Wallet sur l’écran de verrouillage d’un iPhone" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--dark" id="rentabilite">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Rentabilité</p>
        <h2>Combien vous rapporte un client qui revient ?</h2>
        <p>Entrez vos propres chiffres : vous voyez tout de suite combien de visites en plus suffisent à couvrir votre abonnement.</p>
      </div>
      <RoiCalculator />
    </div>
  </section>


  <section class="section section--warm" id="tarifs">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Tarifs</p>
        <h2>Des formules simples, sans surprise sur le prix</h2>
        <p>
          Starter, Premium ou Pro&nbsp;: la notification de proximité est incluse partout. Payez en ligne en toute sécurité. Mise en service {
            offer ? (
              <>
                <span data-offer>offerte jusqu’au {LAUNCH_OFFER.untilLabel}, en mensuel comme en annuel.</span>
                <span data-offer-off hidden>offerte en paiement annuel.</span>
              </>
            ) : (
              'offerte en paiement annuel.'
            )
          }
        </p>
      </div>
      <PricingCards idPrefix="home" />
      <ul class="reassure">
        <li><Icon name="zap" size={18} /> Carte prête sous 24&nbsp;h</li>
        <li>
          <Icon name="gift" size={18} />
          <span>
            Mise en service {
              offer ? (
                <>
                  <span data-offer>offerte jusqu’au {LAUNCH_OFFER.untilLabel}</span>
                  <span data-offer-off hidden>offerte en paiement annuel</span>
                </>
              ) : (
                'offerte en paiement annuel'
              )
            }
          </span>
        </li>
        <li><Icon name="lock" size={18} /> Paiement sécurisé par Stripe</li>
        <li><Icon name="phone" size={18} /> Une question ? <a href="#rappel">On vous rappelle</a></li>
      </ul>
      <p class="center"><a href="/tarifs/">Comparer les formules en détail</a></p>
    </div>
  </section>

  <section class="section" id="parrainage">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Parrainage LOYNA</p>
        <h2>Parrainez un commerçant&nbsp;: un mois à -50&nbsp;% chacun</h2>
        <p>Vous connaissez un commerçant à qui une carte de fidélité rendrait service&nbsp;? Partagez votre code de parrainage depuis votre espace client.</p>
      </div>
      <div class="grid grid-2 ref-grid">
        <div class="card">
          <span class="icon"><Icon name="gift" /></span>
          <h3>-50 % pour votre filleul</h3>
          <p>Sur son premier mois d’abonnement, avec votre code saisi dans son panier.</p>
        </div>
        <div class="card">
          <span class="icon"><Icon name="handshake" /></span>
          <h3>-50 % pour vous</h3>
          <p>Sur votre mois suivant, pour chaque commerçant parrainé qui s’abonne. Les mois s’enchaînent, un par filleul.</p>
        </div>
      </div>
      <p class="center ref-note">Dans les trois offres, pour les abonnements mensuels, parrain comme filleul. <a href="/faq/#parrainage-loyna">Comment ça marche</a></p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <CallbackForm />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Secteurs</p>
        <h2>Pensé pour les commerces de proximité</h2>
        <p>Coiffure, beauté, restauration, boulangerie, café, fleuriste ou boutique : la carte s’adapte à votre rythme de visites et à vos récompenses.</p>
      </div>
      <div class="sectors">
        {
          sectors.slice(0, 5).map((s) => (
            <a class="sector" href={`/secteurs/${s.slug}/`}>
              <WalletCard
                name={s.carte.nom}
                activity={s.carte.activite}
                bg={s.carte.couleurFond}
                accent={s.carte.couleurAccent}
                text={s.carte.couleurTexte}
                filled={Math.max(2, s.carte.total - 3)}
                total={s.carte.total}
                reward={s.carte.recompense}
                qr={false}
                width={240}
              />
              <span class="sector-name">
                {s.nom} <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
      {
        sectors.length > 5 && (
          <p class="more-sectors">
            <span>Aussi :</span>
            {sectors.slice(5).map((s) => (
              <a href={`/secteurs/${s.slug}/`}>{s.nom}</a>
            ))}
            <a href="/secteurs/">Tous les métiers →</a>
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container seo-text">
      <div class="section-head">
        <p class="eyebrow">Repères</p>
        <h2>La carte de fidélité digitale, en bref</h2>
      </div>
      <div class="seo-cols">
        <div>
          <h3>Qu’est-ce qu’une carte de fidélité digitale ?</h3>
          <p>
            C’est la version dématérialisée de la carte à tampons : au lieu d’un carton, la carte de fidélité vit dans le téléphone du client, dans Apple Wallet ou Google Wallet. Pas d’application à télécharger : le client scanne votre QR code et ajoute sa carte en un geste.
            Pour comprendre le fonctionnement en détail, lisez notre <a href="/blog/carte-de-fidelite-digitale-guide/">guide de la carte de fidélité digitale</a>.
          </p>
        </div>
        <div>
          <h3>Pourquoi remplacer la carte papier ?</h3>
          <p>
            Une carte numérique ne se perd pas, ne s’imite pas et se met à jour toute seule. Surtout, elle vous permet de garder le contact : récompense disponible, anniversaire, client qui ne revient plus. Le <a href="/blog/carte-fidelite-papier-ou-digitale/">comparatif papier ou digitale</a> détaille les avantages et les limites de chaque solution.
          </p>
        </div>
        <div>
          <h3>Comment créer la carte de fidélité de votre commerce ?</h3>
          <p>
            Choisissez la mécanique (passages, points ou montant), une récompense qui donne envie et un seuil atteignable. Notre méthode pour <a href="/blog/creer-carte-de-fidelite/">créer une carte de fidélité</a> vous guide pas à pas, et le <a href="/creer-ma-carte/">configurateur</a> en montre l’aperçu à votre nom.
          </p>
        </div>
        <div>
          <h3>Un logiciel de fidélité simple et conforme</h3>
          <p>
            LOYNA réunit la carte, le scanner sur smartphone, les récompenses automatiques, les notifications et le tableau de bord, avec des consentements séparés et des données hébergées dans l’Union européenne. Les règles à connaître sont résumées dans notre article <a href="/blog/carte-de-fidelite-rgpd/">carte de fidélité et RGPD</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Questions fréquentes</p>
        <h2>Vous vous demandez peut-être…</h2>
      </div>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="answer">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
      <p class="center"><a href="/faq/">Toutes les questions</a></p>
    </div>
  </section>

  <CtaBand callbackHref="#rappel" />
</Base>

<style>
  .strip {
    border-block: 1px solid rgba(230, 194, 122, 0.18);
    background: #1a181c;
  }
  .strip-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px 28px;
    padding: 22px 0;
    color: #d9d2c4;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .strip-row :global(svg) {
    color: #e6c27a;
  }
  .mid-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 22px;
    margin-top: clamp(36px, 5vw, 56px);
    text-align: center;
  }
  .mid-cta span {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .mid-cta a:not(.btn) {
    font-weight: 700;
    padding: 10px 4px;
  }
  .swipe-hint {
    display: none;
  }
  .ref-grid {
    max-width: 880px;
    margin-inline: auto;
  }
  .ref-note {
    margin: 26px auto 0;
    max-width: 720px;
    color: var(--muted);
  }
  .reassure {
    list-style: none;
    padding: 0;
    margin: 34px auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    font-weight: 600;
    color: var(--ink);
  }
  .reassure li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .reassure :global(svg) {
    color: var(--gold-strong);
  }
  .strip-row span {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .compare .before {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #a8473f;
    text-decoration: line-through;
    text-decoration-color: rgba(168, 71, 63, 0.5);
    margin: 0;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  .step {
    position: relative;
  }
  .step .shot {
    max-width: 300px;
    margin: 0 auto 26px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: #faf7f0;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .step p {
    color: var(--muted);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .split .checks {
    margin: 26px 0 30px;
  }
  .narrow-shot {
    max-width: 360px;
