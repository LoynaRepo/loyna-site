---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Jonction from '../components/Jonction.astro';
import PricingCards from '../components/PricingCards.astro';
import VideoModale from '../components/VideoModale.astro';
import WalletCard from '../components/WalletCard.astro';
import QrCode from '../components/QrCode.astro';
import CtaBand from '../components/CtaBand.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import CallbackForm from '../components/CallbackForm.astro';
import Proximite from '../components/Proximite.astro';
import MockNotifications from '../components/MockNotifications.astro';
import MockTableau from '../components/MockTableau.astro';
import MiniConfigurateur from '../components/MiniConfigurateur.astro';
import Confiance from '../components/Confiance.astro';
import {getFaq, getSectors, getSettings} from '../lib/builder';
import {APPEL, MARKETING_INTERVAL_HOURS, MISE_EN_SERVICE_APRES, PHRASES, PLANS, SITE, TRIAL, offerActive} from '../data/site';
import mark from '../assets/logo-mark.svg?raw';

const settings = await getSettings();
const sectors = await getSectors();
const faq = (await getFaq()).slice(0, 6);
// Titre d'accueil : les mots entre *astérisques* (réglage Builder) sont mis en valeur en doré.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const heroTitleHtml = esc(settings.heroTitle).replace(/\*(.+?)\*/g, '<span class="gold-text">$1</span>');
// Symbole LOYNA en filigrane des sections sombres (couleur donnée par .filigrane)
const filigrane = mark.replace(/<defs>.*<\/defs>/s, '').replace(/fill="url\(#g\)"/, '').replace('<svg', '<svg aria-hidden="true"');

const chiffres = [
  {n: '0', unite: 'application', texte: 'à télécharger pour vos clients : la carte s’ajoute à Apple Wallet ou Google Wallet en un geste.'},
  {n: '1', unite: 'scan', texte: 'pour valider un passage. Pas de recherche du client, pas de bouton +1.'},
  TRIAL.open
    ? {n: '1', unite: 'mois gratuit', texte: 'sans carte bancaire : votre carte et son QR code sont créés tout de suite à partir de vos réglages.'}
    : {n: '24', unite: 'heures', texte: 'pour que votre carte soit prête, avec son QR code, hors personnalisation exceptionnelle.'},
  {n: '0 €', unite: 'par message', texte: 'Les notifications Wallet arrivent sur le téléphone de vos clients, sans coût par envoi.'},
];
const garanties = [
  {icon: 'smartphone', t: 'iPhone et Android'},
  {icon: 'scan-line', t: 'Un simple smartphone suffit pour scanner'},
  {icon: 'shield-check', t: 'Données hébergées dans l’UE'},
  {icon: 'lock', t: 'Paiement sécurisé par Stripe'},
];
const constats = [
  {avant: 'Carte papier perdue ou oubliée', titre: 'Toujours dans le téléphone', texte: 'La carte vit dans Apple Wallet ou Google Wallet, à côté de la carte bancaire. Impossible de la perdre.'},
  {avant: 'Aucun contact avec vos clients', titre: 'Des notifications qui font revenir', texte: 'Récompense disponible, passage devant la boutique, anniversaire : le bon message arrive au bon moment.'},
  {avant: 'Aucune idée de ce qui marche', titre: 'Un tableau de bord clair', texte: 'Clients actifs, passages, récompenses débloquées et utilisées : pilotez votre fidélité avec de vrais chiffres.'},
];
const features = [
  {icon: 'wallet', title: 'Carte Apple & Google Wallet', text: 'À vos couleurs, avec votre logo et votre récompense. Elle se met à jour toute seule.'},
  {icon: 'map-pin', title: 'Notification de proximité', text: 'Votre client passe près de la boutique : sa carte s’affiche sur l’écran de verrouillage. Dans toutes les offres.'},
  {icon: 'scan-line', title: 'Un scan, un passage', text: 'Pas de recherche, pas de bouton +1 : le passage est validé dès le scan, avec protection anti double scan.'},
  {icon: 'gift', title: 'Récompenses automatiques', text: 'Au seuil fixé, la récompense se débloque et le client est prévenu sur son téléphone.'},
  {icon: 'megaphone', title: 'Campagnes de notifications', text: 'Une offre, une nouveauté : le message arrive sur le téléphone de vos clients, sans coût par envoi.'},
  {icon: 'workflow', title: 'Automatisations', text: 'Anniversaire, relance des inactifs, « Plus qu’un passage ! », avis Google : dans toutes les offres, les messages partent tout seuls.'},
  {icon: 'users', title: 'Toute votre équipe', text: 'Un compte par personne, des rôles et des droits adaptés, sans limite d’employés.'},
  {icon: 'shield-check', title: 'Données protégées', text: 'Hébergées dans l’Union européenne, chiffrées, consentements séparés, export et suppression à la demande.'},
];
// Exemples de cartes : huit métiers bien différents, les autres en pastilles (tous restent liés depuis l'accueil).
const EXEMPLES: Record<string, {icon: string; label: string}> = {
  'boulangerie-cafe': {icon: 'croissant', label: 'Boulangerie'},
  'coiffeur-barbier': {icon: 'scissors', label: 'Coiffure'},
  'restauration-rapide': {icon: 'hamburger', label: 'Snack'},
  'institut-onglerie': {icon: 'gem', label: 'Institut'},
  barbier: {icon: 'scissors', label: 'Barbier'},
  pizzeria: {icon: 'pizza', label: 'Pizzeria'},
  fleuriste: {icon: 'flower-2', label: 'Fleuriste'},
  sushi: {icon: 'fish', label: 'Sushi'},
};
const exemples = sectors.filter((s) => EXEMPLES[s.slug]).sort((a, b) => Object.keys(EXEMPLES).indexOf(a.slug) - Object.keys(EXEMPLES).indexOf(b.slug));
const autresMetiers = sectors.filter((s) => !EXEMPLES[s.slug]);
const offer = offerActive();

const softwareLd = {
  '@type': 'SoftwareApplication',
  name: 'LOYNA',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, Android, Web',
  description: SITE.description,
  url: SITE.url,
  publisher: {'@id': `${SITE.url}/#organisation`},
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: Math.min(...PLANS.map((p) => p.monthly)),
    highPrice: Math.max(...PLANS.map((p) => p.monthly)),
    offerCount: PLANS.length,
  },
};
---

<Base
  title="Carte de fidélité digitale Apple et Google Wallet"
  description={SITE.description}
  jsonLd={softwareLd}
>
  <Hero titleHtml={heroTitleHtml} subtitle={settings.heroLead || settings.heroSubtitle} sectors={sectors} />

  <Jonction sur vers="nuit" forme={1} />

  <!-- L'essentiel, en grands chiffres -->
  <section class="section section--dark chiffres" aria-labelledby="chiffres-titre">
    <span class="filigrane chiffres-filigrane" set:html={filigrane} />
    <div class="container chiffres-corps">
      <p class="eyebrow">L’essentiel</p>
      <h2 class="titre" id="chiffres-titre">Simple pour vos clients, <span class="gold-text">simple pour vous.</span></h2>
      <dl class="stats">
        {
          chiffres.map((c) => (
            <div class="stat apparait">
              <dt>
                <b>{c.n}</b> <span>{c.unite}</span>
              </dt>
              <dd>{c.texte}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="garanties" aria-label="Compatibilité et sécurité">
        {
          garanties.map((g) => (
            <li>
              <Icon name={g.icon} size={16} /> {g.t}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Jonction de="nuit" vers="creme" forme={2} />

  <!-- Le problème, puis le parcours en trois étapes -->
  <section class="section parcours" id="comment-ca-marche">
    <div class="container">
      <Confiance />
      <div class="constat-tete">
        <div>
          <p class="eyebrow">Le constat</p>
          <h2 class="titre">La carte à tampons a fait son temps</h2>
        </div>
        <p>Perdue au fond d’un sac, oubliée à la maison, jetée au premier tri : la carte papier ne fait revenir personne. Et quand un client ne revient plus, vous n’avez aucun moyen de le relancer.</p>
      </div>
      <div class="constats">
        {
          constats.map((c) => (
            <div class="card constat apparait">
              <p class="avant">{c.avant}</p>
              <h3>{c.titre}</h3>
              <p>{c.texte}</p>
            </div>
          ))
        }
      </div>

      <div class="section-head etapes-tete" data-fantome="scan">
        <p class="eyebrow">Comment ça marche</p>
        <h2>De la création au premier scan, <span class="gold-text">sans complexité.</span></h2>
        <p>Aucune application à installer, aucun compte à créer pour vos clients : la carte s’ajoute au Wallet du téléphone, comme une carte d’embarquement.</p>
      </div>
      <ol class="etapes" aria-label="Les trois étapes">
        <li class="etape apparait">
          <div class="ill ill-1" aria-hidden="true">
            <WalletCard name="Le Fournil d’Albane" activity="Boulangerie" bg="#7a3d1c" accent="#f2c879" filled={3} total={10} reward="Viennoiserie offerte" qr={false} width={250} />
            <span class="ill-pts"><i style="--c:#7a3d1c"></i><i style="--c:#14532d"></i><i style="--c:#1e3a5f"></i><i style="--c:#121216"></i></span>
          </div>
          <span class="etape-n" data-n="01" aria-hidden="true"></span>
          <h3>Vous créez votre carte</h3>
          <p>Votre nom, vos couleurs, votre logo, votre récompense : l’aperçu se met à jour en direct. {TRIAL.open ? 'Lancez l’essai : votre carte et son QR code sont créés tout de suite.' : <>Choisissez votre offre, votre carte et son QR code sont prêts sous 24&nbsp;h.</>}</p>
        </li>
        <li class="etape apparait">
          <div class="ill ill-2" aria-hidden="true">
            <div class="ill-qr">
              <QrCode text="https://loyna.fr/creer-ma-carte/" size={104} label="" />
              <small>Scannez-moi</small>
            </div>
            <div class="ill-ajout">
              <span><Icon name="wallet" size={15} /> Ajouter à Apple Wallet</span>
              <span><Icon name="wallet" size={15} /> Enregistrer dans Google Wallet</span>
            </div>
          </div>
          <span class="etape-n" data-n="02" aria-hidden="true"></span>
          <h3>Votre client l’ajoute à son Wallet</h3>
          <p>Il scanne votre QR code au comptoir, en vitrine ou sur vos réseaux, remplit un formulaire très court, et sa carte rejoint son téléphone en un geste.</p>
        </li>
        <li class="etape apparait">
          <div class="ill ill-3" aria-hidden="true">
            <span class="ill-ok"><Icon name="check" size={22} /></span>
            <b>Passage validé</b>
            <span class="ill-compte">8 <i>/ 10</i></span>
            <span class="ill-tampons">{Array.from({length: 10}).map((_, i) => <i class={i < 8 ? 'on' : ''} />)}</span>
          </div>
          <span class="etape-n" data-n="03" aria-hidden="true"></span>
          <h3>Un scan, c’est validé</h3>
          <p>À chaque visite, vous scannez sa carte avec votre téléphone. Elle se met à jour toute seule et la récompense se débloque au bon moment.</p>
        </li>
      </ol>

      <div class="mid-cta mid-cta--double" id="video">
        <div class="btn-row">
          <a class="btn btn--primary" href={APPEL.href}>{APPEL.label} <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--ghost" href="/demo/" data-video="/video/loyna-presentation-720p.mp4"><Icon name="circle-play" size={18} /> LOYNA en 1 minute</a>
        </div>
        <span>{TRIAL.open ? `${TRIAL.label.charAt(0).toUpperCase()}${TRIAL.label.slice(1)}.` : 'Aperçu gratuit, à vos couleurs, avant tout paiement.'} La vidéo montre tout le parcours, côté client et côté commerçant.</span>
      </div>
    </div>
  </section>
  <VideoModale />

  <Jonction de="creme" vers="sable" forme={3} retourne />

  <!-- Ce que le commerçant y gagne -->
  <section class="section section--alt atouts" aria-labelledby="atouts-titre">
    <div class="container">
      <div class="section-head" data-fantome="wallet">
        <p class="eyebrow">Ce que vous y gagnez</p>
        <h2 id="atouts-titre">Faites revenir vos clients, <span class="gold-text">sans y penser.</span></h2>
        <p>La notification de proximité, des messages qui partent tout seuls et un tableau de bord clair : de quoi donner envie de revenir, et voir ce qui marche.</p>
      </div>

      <div class="atout" id="proximite">
        <div>
          <p class="eyebrow">Proximité · Toutes les offres</p>
          <h3 class="atout-titre">Votre client passe devant la boutique&nbsp;: sa carte s’affiche</h3>
          <p class="atout-texte">Un habitué passe devant votre boulangerie. Sur l’écran de verrouillage de son téléphone, sa carte de fidélité s’affiche avec un court message&nbsp;: « Votre récompense vous attend chez Le Fournil d’Albane&nbsp;! ». Le bon rappel, au bon endroit.</p>
          <ul class="checks">
            <li>Incluse dans toutes les offres, et jamais comptée comme une campagne</li>
            <li>Sur iPhone, la carte s’affiche sur l’écran de verrouillage&nbsp;; sur Android, une notification apparaît quand le client s’attarde près de la boutique</li>
            <li>LOYNA ne reçoit jamais la position de vos clients&nbsp;: c’est leur téléphone qui détecte la proximité</li>
          </ul>
          <p class="atout-note">Fonctionne quand le client a activé la localisation et laissé Wallet s’afficher sur l’écran verrouillé. Avec Pro, jusqu’à 3 adresses&nbsp;: une seule carte, un seul tableau de bord.</p>
        </div>
        <div class="atout-visuel apparait">
          <div class="visuel-coupe">
            <Proximite width={300} pill={false} />
          </div>
          <div class="pastille-prox"><span><Icon name="map-pin" size={15} /></span> Près de la boutique</div>
          <p class="atout-legende">Exemple : commerce fictif</p>
        </div>
      </div>

      <div class="atout atout--inverse">
        <div>
          <p class="eyebrow">Automatisations · Toutes les offres</p>
          <h3 class="atout-titre">Les messages qui font revenir, envoyés tout seuls</h3>
          <p class="atout-texte">Dans toutes les offres, LOYNA envoie le bon message au bon moment. Vous choisissez le texte et la surprise&nbsp;; ces messages automatiques ne comptent jamais dans vos campagnes. La relance et «&nbsp;Plus qu’un passage&nbsp;!&nbsp;» sont actifs d’office, l’anniversaire et l’avis Google s’activent en un réglage.</p>
          <ul class="checks">
            <li><strong>Anniversaire</strong><span class="det">&nbsp;: un message le jour J, avec la surprise de votre choix</span></li>
            <li><strong>Relance des inactifs</strong><span class="det">&nbsp;: un rappel aux clients qui ne reviennent plus (après 60 jours par défaut, réglable)</span></li>
            <li><strong>« Plus qu’un passage&nbsp;! »</strong><span class="det">&nbsp;: un rappel aux clients tout proches de leur récompense</span></li>
            <li><strong>Avis Google</strong><span class="det">&nbsp;: une demande d’avis après la 3e visite</span></li>
            <li><strong>Campagnes programmées et groupes de clients</strong><span class="det">, et un rapport du mois par e-mail, avec jusqu’à 3 conseils</span></li>
          </ul>
          <p class="atout-note atout-note--large">Toutes les offres préviennent le client à chaque passage et quand sa récompense est débloquée. Un même client reçoit au plus un message commercial par {MARKETING_INTERVAL_HOURS}&nbsp;h, réglable.</p>
        </div>
        <div class="atout-visuel apparait">
          <div class="visuel-coupe">
            <MockNotifications width={300} />
          </div>
          <p class="atout-legende">Exemple : commerce et prénom fictifs</p>
        </div>
      </div>

      <div class="atout">
        <div>
          <p class="eyebrow">Au comptoir et au bureau</p>
          <h3 class="atout-titre">Un scan au comptoir, des chiffres clairs ensuite</h3>
          <p class="atout-texte">Avec LOYNA Business sur votre téléphone, vous scannez la carte du client et tout le reste suit&nbsp;: le passage, la récompense et des statistiques calculées à partir de vos vrais passages.</p>
          <ul class="checks">
            <li>Pas de tampon, pas de recherche du client, pas de bouton +1</li>
            <li>Protection anti double scan et bouton « Annuler » pendant quelques secondes</li>
            <li>Un simple smartphone suffit : aucun matériel à acheter</li>
            <li>Chaque action est tracée dans un journal d’activité</li>
          </ul>
          <div class="btn-row atout-boutons">
            <a class="btn btn--ghost" href="/espace-client/demo/" rel="nofollow">Essayer l’espace client en démo</a>
            <a class="lien-fort" href="/fonctionnalites/">Toutes les fonctionnalités <Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
        <div class="atout-visuel apparait">
          <MockTableau />
          <div class="tableau-pastille"><span><Icon name="check" size={14} /></span> Passage validé : 8 / 10</div>
        </div>
      </div>

      <div class="carte-action apparait">
        <div>
          <p class="carte-action-sur">Aperçu gratuit</p>
          <p class="carte-action-titre">Voyez votre carte avant de décider.</p>
          <p class="carte-action-texte">À votre nom et à vos couleurs, avant tout paiement.</p>
        </div>
        <a class="btn btn--primary" href="/creer-ma-carte/">Créer l’aperçu de ma carte <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <Jonction de="sable" vers="blanc" forme={4} />

  <!-- Exemples par métier -->
  <section class="section section--blanc exemples" aria-labelledby="exemples-titre">
    <div class="container">
      <div class="exemples-tete">
        <div>
          <p class="eyebrow">Exemples</p>
          <h2 class="titre" id="exemples-titre">Votre métier, votre carte, <span class="gold-text">vos couleurs.</span></h2>
          <p class="exemples-lead">Coiffure, beauté, restauration, boulangerie, café, fleuriste ou boutique : la carte s’adapte à votre rythme de visites et à vos récompenses.</p>
        </div>
        <p class="exemples-note">La récompense et les couleurs sont proposées pour votre métier. Vous changez ensuite tout ce que vous voulez, sans code.</p>
      </div>
      <ul class="ex-grille">
        {
          exemples.map((s) => (
            <li>
              <a class="ex" href={`/secteurs/${s.slug}/`}>
                <span class="ex-etiquette">
                  <Icon name={EXEMPLES[s.slug].icon} size={14} /> {EXEMPLES[s.slug].label}
                </span>
                <span class="sr-only">Carte de fidélité : {s.nom}</span>
                <div class="ex-carte" aria-hidden="true">
                  <WalletCard
                    name={s.carte.nom}
                    activity={s.carte.activite}
                    bg={s.carte.couleurFond}
                    accent={s.carte.couleurAccent}
                    text={s.carte.couleurTexte}
                    filled={Math.max(2, s.carte.total - 3)}
                    total={s.carte.total}
                    reward={s.carte.recompense}
                    qr={false}
                    width={252}
                  />
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="glisser" aria-hidden="true">Faites glisser pour voir tous les exemples →</p>
      <div class="autres-metiers">
        <p>Votre métier n’y est pas ? Choisissez « Autre » dans le configurateur et écrivez le vôtre. Voyez aussi&nbsp;:</p>
        <ul class="pastilles">
          {
            autresMetiers.map((s) => (
              <li>
                <a href={`/secteurs/${s.slug}/`}>{s.nom}</a>
              </li>
            ))
          }
          <li><a href="/secteurs/">Tous les métiers <Icon name="arrow-right" size={15} /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <Jonction de="blanc" vers="sable" forme={6} retourne />

  <!-- Essai du configurateur -->
  <section class="section section--alt" id="essayer" aria-labelledby="essayer-titre">
    <div class="container">
      <div class="section-head" data-fantome="en direct">
        <p class="eyebrow">À vous</p>
        <h2 id="essayer-titre">Composez votre carte, <span class="gold-text">ici même.</span></h2>
        <p>Le nom, l’activité, les couleurs : la carte change sous vos yeux, telle que vos clients la verront dans leur Wallet.</p>
      </div>
      <MiniConfigurateur />
    </div>
  </section>

  <Jonction de="sable" vers="nuit" forme={2} retourne />

  <!-- Fonctionnalités -->
  <section class="section section--dark fonctions" aria-labelledby="fonctions-titre">
    <span class="filigrane fonctions-filigrane" set:html={filigrane} />
    <div class="container fonctions-corps">
      <div class="section-head section-head--g">
        <p class="eyebrow">Fonctionnalités</p>
        <h2 id="fonctions-titre">Tout ce qu’il faut pour fidéliser, <span class="gold-text">rien de compliqué.</span></h2>
        <p>Une carte, un scanner et des automatisations qui travaillent pour vous pendant que vous servez vos clients.</p>
      </div>
      <ul class="f-grille">
        {
          features.map((f, i) => (
            <li>
              <span class="f-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mid-cta">
        <a class="btn btn--gold" href={APPEL.href}>{APPEL.label} <Icon name="arrow-right" size={18} /></a>
        <a href="/fonctionnalites/">Le détail des fonctionnalités</a>
      </div>
    </div>
  </section>

  <Jonction de="nuit" vers="sable" forme={5} />

  <!-- Rentabilité -->
  <section class="section section--alt" id="rentabilite">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Rentabilité</p>
        <h2>Combien vous rapporte un client qui revient ?</h2>
        <p>Entrez vos propres chiffres : vous voyez tout de suite combien de visites en plus suffisent à couvrir votre abonnement.</p>
      </div>
      <RoiCalculator />
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={1} retourne />

  <!-- Tarifs -->
  <section class="section" id="tarifs">
    <div class="container">
      <div class="section-head" data-fantome="prix">
        <p class="eyebrow">Tarifs</p>
        <h2>Deux offres simples, <span class="gold-text">sans surprise sur le prix.</span></h2>
        <p>
          Starter ou Pro&nbsp;: la notification de proximité est incluse partout, et l’engagement n’est que proposé. Mise en service&nbsp;: {
            offer ? (
              <>
                <span data-offer>{PHRASES.miseEnService}</span>
                <span data-offer-off hidden>{MISE_EN_SERVICE_APRES}</span>
              </>
            ) : (
              MISE_EN_SERVICE_APRES
            )
          }
        </p>
      </div>
      <PricingCards idPrefix="home" repli />
      <ul class="reassure">
        {
          TRIAL.open ? (
            <li><Icon name="gift" size={18} /> {TRIAL.label.charAt(0).toUpperCase() + TRIAL.label.slice(1)}</li>
          ) : (
