---
import Base from '../layouts/Base.astro';
import Jonction from '../components/Jonction.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PricingCards from '../components/PricingCards.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import CallbackForm from '../components/CallbackForm.astro';
import Proximite from '../components/Proximite.astro';
import PourVotreMetier from '../components/PourVotreMetier.astro';
import {APPEL, COMPARISON, ENGAGEMENT, LAUNCH_OFFER, MARKETING_INTERVAL_HOURS, MISE_EN_SERVICE_APRES, PHRASES, PLANS, SITE, TRIAL, essaiUrl, euro, nombre, offerActive} from '../data/site';
import {getFaq} from '../lib/builder';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Tarifs', url: '/tarifs/'},
];
const faq = (await getFaq()).filter((f) => f.categorie === 'Tarifs et abonnement');

// Un Offer par offre et par prix, toujours réglé au mois
const offersLd = {
  '@type': 'Product',
  name: 'LOYNA — carte de fidélité digitale',
  description: SITE.description,
  brand: {'@type': 'Brand', name: 'LOYNA'},
  offers: PLANS.flatMap((p) =>
    [
      {name: `${p.name}, sans engagement`, price: p.monthly},
      {name: `${p.name}, avec ${ENGAGEMENT.months} mois d’engagement`, price: p.engaged},
    ].map((o) => ({
      '@type': 'Offer',
      name: o.name,
      price: o.price,
      priceCurrency: 'EUR',
      url: `${SITE.url}/tarifs/`,
      availability: 'https://schema.org/InStock',
      priceSpecification: {'@type': 'UnitPriceSpecification', price: o.price, priceCurrency: 'EUR', unitCode: 'MON', valueAddedTaxIncluded: false},
    })),
  ),
};
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}})),
};
const prixMin = Math.min(...PLANS.map((p) => p.monthly));
const starter = PLANS[0];
const offer = offerActive();
// Groupes du comparatif : une ligne de titre avant la première ligne de chaque groupe
const lignes = COMPARISON.map((row, i) => ({...row, n: i}));
---

<Base stickyCta={{primary: TRIAL.open ? APPEL : {href: '/creer-ma-carte/', label: 'Créer ma carte'}, secondary: {href: '/contact/', label: 'Une question ?'}}}
  title={`Tarifs : carte de fidélité digitale dès ${euro(prixMin)} par mois`}
  description={`${PLANS.map((p) => `${p.name} ${euro(p.monthly)}`).join(', ')} par mois, sans TVA, sans engagement, ou −${ENGAGEMENT.discountPercent} % avec ${ENGAGEMENT.months} mois d’engagement. ${TRIAL.open ? `${TRIAL.label.replace(/^1 mois gratuit/, 'Essai d’un mois gratuit')}.` : offer ? `Mise en service offerte jusqu’au ${LAUNCH_OFFER.untilLabel}.` : 'Notification de proximité incluse.'}`}
  ogImage="/og/tarifs.png"
  breadcrumbs={crumbs}
  jsonLd={[offersLd, faqLd]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Tarifs</p>
      <h1>Deux offres simples, dès {euro(prixMin)} par mois</h1>
      <p class="lead">Les deux offres comprennent la carte Apple Wallet et Google Wallet, les clients illimités, les messages qui partent tout seuls, la notification de proximité, les campagnes et le scanner. Pro ajoute le parrainage entre vos clients et les messages écrits par LOYNA.{TRIAL.open && <> {TRIAL.label.charAt(0).toUpperCase() + TRIAL.label.slice(1)}.</>}</p>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={2} />

  <section class="section pt0">
    <div class="container">
      <p class="ma-carte" id="ma-carte" hidden>
        <span class="mc-dots" aria-hidden="true"><i></i><i></i></span>
        <span>Votre carte <strong id="mc-name"></strong> est prête à être créée : {TRIAL.open ? 'essayez-la 1 mois gratuitement, ou choisissez votre offre.' : <>choisissez votre offre, nous la mettons en service sous 24&nbsp;h.</>}</span>
        <a href="/creer-ma-carte/">Modifier</a>
      </p>
      <PricingCards idPrefix="tarifs" level={2} />
    </div>
  </section>

  <Jonction de="creme" vers="sable" forme={3} retourne />

  <section class="section section--alt tete-serree">
    <div class="container">
      <div class="section-head">
        <h2>Comparer les offres</h2>
        <p>Le détail de ce qui est inclus dans chaque offre.</p>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <caption class="visually-hidden">Comparatif des offres LOYNA</caption>
          <thead>
            <tr>
              <th scope="col">Fonctionnalité</th>
              {
                PLANS.map((p) => (
                  <th scope="col">
                    {p.name}
                    <span>{euro(p.monthly)}<i>/mois</i></span>
                    <small>ou {euro(p.engaged)} avec engagement</small>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              lignes.map((row) => (
                <>
                  {row.group && (
                    <tr class="grp">
                      <th scope="colgroup" colspan={3}>
                        {row.group}
                      </th>
                    </tr>
                  )}
                <tr>
                  <th scope="row">
                    {row.label}
                    {row.note && <small>{row.note}</small>}
                  </th>
                  {row.values.map((v) => (
                    <td>
                      {v === true ? (
                        <span class="yes">
                          <Icon name="check" size={18} label="Inclus" />
                        </span>
                      ) : v === false ? (
                        <span class="no" role="img" aria-label="Non inclus">
                          <Icon name="minus" size={18} />
                        </span>
                      ) : (
                        <strong>{v}</strong>
                      )}
                    </td>
                  ))}
                </tr>
                </>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Une campagne compte pour une, quel que soit le nombre de clients qui la reçoivent&nbsp;; le compteur repart chaque lundi. Les messages automatiques et les notifications de proximité ne sont jamais décomptés.
      </p>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={1} />

  <section class="section tete-serree" id="quotas">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ce qui est compté</p>
        <h2>Des limites claires, pensées pour vos clients</h2>
        <p>Les clients et les cartes sont illimités dans les deux offres. Seules les campagnes sont comptées avec Starter.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <span class="icon"><Icon name="wallet" /></span>
          <h3>Cartes</h3>
          <p>
            Une carte, c’est un client inscrit à votre programme&nbsp;: sans limite, dans les deux offres.
          </p>
        </div>
        <div class="card">
          <span class="icon"><Icon name="megaphone" /></span>
          <h3>Campagnes</h3>
          <p>
            Une campagne, c’est un message envoyé à vos clients, à tous ou à un groupe&nbsp;: elle compte pour une, qu’elle parte vers 30 ou 300 clients. Vous en avez {nombre(starter.campaignsPerWeek ?? 0)} par semaine avec Starter, sans limite avec Pro. Le compteur repart chaque lundi&nbsp;; une campagne programmée compte dans la semaine où elle part.
          </p>
        </div>
        <div class="card">
          <span class="icon"><Icon name="bell-ring" /></span>
          <h3>Jamais décomptés</h3>
          <p>
            Les messages automatiques (passage validé, récompense débloquée, anniversaire, relance, «&nbsp;Plus qu’un passage&nbsp;!&nbsp;», avis, parrainage) et les notifications de proximité. Et pour ne pas lasser vos clients, un même client reçoit au plus un message commercial par {MARKETING_INTERVAL_HOURS}&nbsp;h, réglable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Jonction de="creme" vers="nuit" forme={5} />

  <section class="section section--dark tete-serree" id="proximite">
    <div class="container prox-grid">
      <div>
        <p class="eyebrow">Dans toutes les offres</p>
        <h2>La notification de proximité, incluse dès Starter</h2>
        <p class="lead">Quand un client passe près de votre boutique, sa carte s’affiche sur l’écran de verrouillage de son téléphone, avec un court message&nbsp;: sa récompense qui l’attend, les passages qui restent, ou votre propre message.</p>
        <ul class="checks prox-checks">
          <li>iPhone&nbsp;: la carte s’affiche sur l’écran de verrouillage. Android&nbsp;: une notification apparaît quand le client s’attarde près de la boutique.</li>
          <li>Jamais comptée comme une campagne, sans coût par message.</li>
          <li>LOYNA ne reçoit jamais la position de vos clients&nbsp;: c’est leur téléphone qui détecte la proximité.</li>
          <li>1 adresse avec Starter. Avec Pro, jusqu’à 3 adresses&nbsp;: une seule carte, un seul tableau de bord.</li>
        </ul>
        <p class="prox-note">Fonctionne quand le client a activé la localisation et laissé Wallet s’afficher sur l’écran verrouillé.</p>
      </div>
      <div class="prox-visual">
        <Proximite width={260} />
      </div>
    </div>
  </section>

  <Jonction de="nuit" vers="creme" forme={6} retourne />

  <section class="section tete-serree">
    <div class="container grid grid-3">
      <div class="card" id="mise-en-service">
        <span class="icon"><Icon name="rocket" /></span>
        <h2 class="h3">Mise en service</h2>
        <p>Création de votre carte à vos couleurs, de votre QR code d’inscription et de votre espace commerçant. {offer ? <><span data-offer>{PHRASES.miseEnService}</span><span data-offer-off hidden>{MISE_EN_SERVICE_APRES}</span></> : MISE_EN_SERVICE_APRES} Jamais refacturée à un client qui reprend un abonnement.</p>
      </div>
      <div class="card" id="engagement">
        <span class="icon"><Icon name="percent" /></span>
        <h2 class="h3">L’engagement, seulement si vous le voulez</h2>
        <p>{PHRASES.engagement}</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="lock" /></span>
        <h2 class="h3">Paiement sécurisé</h2>
        <p>Paiement par carte bancaire via Stripe. Factures, moyen de paiement et abonnement se gèrent depuis votre espace client.</p>
      </div>
    </div>
    <div class:list={['container', 'grid', 'regles', {'grid-2': TRIAL.open}]}>
      {
        TRIAL.open && (
          <div class="card" id="essai">
            <span class="icon"><Icon name="gift" /></span>
            <h2 class="h3">Essai</h2>
            <p>{PHRASES.essai}</p>
            <p class="regle-lien"><a href={essaiUrl}>Essayer 1 mois gratuitement</a></p>
          </div>
        )
      }
      <div class="card" id="arret">
        <span class="icon"><Icon name="circle-pause" /></span>
        <h2 class="h3">Si l’abonnement s’arrête</h2>
        <p>{PHRASES.arret}</p>
      </div>
    </div>
  </section>

  <Jonction de="creme" vers="nuit" forme={4} />

  <section class="section section--dark tete-serree">
    <div class="container">
      <CallbackForm title="Un doute sur l’offre à choisir ?" text="Laissez votre numéro : on vous rappelle au créneau de votre choix pour trouver l’offre adaptée à votre commerce. Ce rappel ne vous engage à rien." />
    </div>
  </section>

  <Jonction de="nuit" vers={faq.length > 0 ? 'sable' : 'creme'} forme={2} retourne />

  {
    faq.length > 0 && (
      <section class="section section--alt tete-serree">
        <div class="container narrow">
          <div class="section-head">
            <h2>Questions sur les tarifs</h2>
          </div>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="answer">
                  <p set:html={f.a} />
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {faq.length > 0 && <Jonction de="sable" vers="creme" forme={3} />}

  <PourVotreMetier />

  <CtaBand callbackHref="#rappel" title="Pas encore décidé ?" text="Créez l’aperçu de votre carte en 30 secondes, ou écrivez-nous : nous vous aidons à choisir l’offre adaptée à votre commerce." />
</Base>

<script>
  // Carte préparée dans le configurateur (même navigateur) : on la rappelle au-dessus des offres.
  try {
    const c = JSON.parse(localStorage.getItem('loyna-config') || 'null');
    const box = document.getElementById('ma-carte');
    if (c && c.name && box) {
      document.getElementById('mc-name')!.textContent = `« ${c.name} »`;
      const dots = box.querySelectorAll<HTMLElement>('.mc-dots i');
      if (/^#[0-9a-f]{6}$/i.test(c.bg)) dots[0].style.background = c.bg;
      if (/^#[0-9a-f]{6}$/i.test(c.accent)) dots[1].style.background = c.accent;
      box.hidden = false;
    }
  } catch {
    /* stockage indisponible */
  }
</script>

<style>
  .ma-carte {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    max-width: 860px;
    margin: 0 auto 30px;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--gold-soft);
    border: 1px solid rgba(123, 77, 255, 0.35);
    color: var(--ink);
    font-weight: 600;
    text-align: center;
  }
  .ma-carte[hidden] {
    display: none;
  }
  .ma-carte a {
    color: #4B25C9;
    font-weight: 700;
  }
  .mc-dots {
    display: inline-flex;
  }
  .mc-dots i {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: #1A1D21;
  }
  .mc-dots i + i {
    margin-left: -8px;
    background: #9471FF;
  }
  .pt0 {
    padding-top: 0;
  }
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid #C9CED5;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }
  .compare th,
  .compare td {
    padding: 15px 20px;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .compare thead th {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    background: #EEF0F2;
  }
  .compare thead th span {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .compare thead th i {
    font-style: normal;
  }
  .compare thead th small {
    display: block;
    margin-top: 2px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* Condition écrite à côté de la ligne (site.ts, COMPARISON) */
  .compare tbody th small {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }
  .compare tbody th {
    text-align: left;
    font-weight: 600;
  }
  .compare tbody .grp th {
    padding-top: 22px;
    padding-bottom: 10px;
    background: var(--bg);
    color: var(--gold-strong);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .compare {
      min-width: 0;
      table-layout: fixed;
      font-size: 0.86rem;
      line-height: 1.32;
    }
    .compare th,
    .compare td {
      padding: 11px 3px;
    }
    .compare thead th:first-child,
    .compare tbody th {
      width: 44%;
      padding-left: 12px;
      padding-right: 6px;
      text-align: left;
    }
    .compare thead th {
      font-size: 0.84rem;
      letter-spacing: -0.01em;
    }
    .compare thead th span {
      font-size: 0.75rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    /* le prix, puis « /mois » en dessous : colonnes étroites */
    .compare thead th i {
      display: block;
    }
    .compare tr > :last-child {
      padding-right: 8px;
    }
    .compare tbody .grp th:last-child {
      padding-right: 6px;
    }
    .compare strong {
      font-size: 0.75rem;
      letter-spacing: -0.01em;
    }
    .yes {
      width: 24px !important;
      height: 24px !important;
    }
    .yes :global(svg) {
      width: 15px;
      height: 15px;
    }
    .compare tbody .grp th {
      width: auto;
    }
  }
  .regles {
    margin-top: clamp(14px, 2vw, 22px);
  }
  .regle-lien {
    margin: 10px 0 0;
    font-weight: 700;
  }
  .table-note {
    margin: 18px auto 0;
    max-width: 860px;
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .prox-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .prox-checks {
    margin: 26px 0 18px;
  }
  .prox-checks li {
    color: #DDE1E6;
  }
  .prox-checks li::before {
    background-color: rgba(164, 135, 255, 0.2);
  }
  .prox-note {
    font-size: 0.92rem;
    color: #a8a194 !important;
    margin: 0;
  }
  .prox-visual {
    display: grid;
    place-items: center;
    padding: 10px 30px;
  }
  @media (max-width: 920px) {
    .prox-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .prox-visual {
      padding-inline: 0;
    }
  }
  .compare tbody tr:last-child > * {
    border-bottom: 0;
  }
  .yes {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ink);
    color: #A487FF;
  }
  .no {
    display: inline-grid;
    place-items: center;
    color: #a89f8f;
  }
</style>
