---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PricingCards from '../components/PricingCards.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import CallbackForm from '../components/CallbackForm.astro';
import Proximite from '../components/Proximite.astro';
import PourVotreMetier from '../components/PourVotreMetier.astro';
import {COMPARISON, LAUNCH_OFFER, MARKETING_INTERVAL_HOURS, PLANS, SETUP_FEE, SITE, euro, nombre, offerActive} from '../data/site';
import {getFaq} from '../lib/builder';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Tarifs', url: '/tarifs/'},
];
const faq = (await getFaq()).filter((f) => f.categorie === 'Tarifs et abonnement');

const offersLd = {
  '@type': 'Product',
  name: 'LOYNA — carte de fidélité digitale',
  description: SITE.description,
  brand: {'@type': 'Brand', name: 'LOYNA'},
  offers: PLANS.flatMap((p) => [
    {
      '@type': 'Offer',
      name: `${p.name} — mensuel`,
      price: p.monthly,
      priceCurrency: 'EUR',
      url: `${SITE.url}/tarifs/`,
      availability: 'https://schema.org/InStock',
      priceSpecification: {'@type': 'UnitPriceSpecification', price: p.monthly, priceCurrency: 'EUR', unitCode: 'MON', valueAddedTaxIncluded: false},
    },
    {
      '@type': 'Offer',
      name: `${p.name} — annuel`,
      price: p.yearly,
      priceCurrency: 'EUR',
      url: `${SITE.url}/tarifs/`,
      availability: 'https://schema.org/InStock',
      priceSpecification: {'@type': 'UnitPriceSpecification', price: p.yearly, priceCurrency: 'EUR', unitCode: 'ANN', valueAddedTaxIncluded: false},
    },
  ]),
};
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}})),
};
const prixMin = Math.min(...PLANS.map((p) => p.monthly));
const starter = PLANS[0];
const premium = PLANS[1];
// Groupes du comparatif : une ligne de titre avant la première ligne de chaque groupe
const lignes = COMPARISON.map((row, i) => ({...row, n: i}));
---

<Base stickyCta={{primary: {href: '/creer-ma-carte/', label: 'Créer ma carte'}, secondary: {href: '/contact/', label: 'Une question ?'}}}
  title={`Tarifs : carte de fidélité digitale dès ${euro(prixMin)} par mois`}
  description={`${PLANS.map((p) => `${p.name} ${euro(p.monthly)}`).join(', ')} par mois, sans TVA. Notification de proximité incluse. ${offerActive() ? `Mise en service offerte jusqu’au ${LAUNCH_OFFER.untilLabel}.` : '−15 % et mise en service offerte en annuel.'}`}
  ogImage="/og/tarifs.png"
  breadcrumbs={crumbs}
  jsonLd={[offersLd, faqLd]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Tarifs</p>
      <h1>Des formules simples, dès {euro(prixMin)} par mois</h1>
      <p class="lead">Toutes les formules incluent la carte Apple Wallet et Google Wallet, la notification de proximité, les campagnes de notifications et le scanner. Premium ajoute les automatisations et les niveaux VIP, Pro le suivi par LOYNA. Votre carte est prête sous 24&nbsp;h.</p>
    </div>
  </section>

  <section class="section pt0">
    <div class="container">
      <p class="ma-carte" id="ma-carte" hidden>
        <span class="mc-dots" aria-hidden="true"><i></i><i></i></span>
        <span>Votre carte <strong id="mc-name"></strong> est prête à être créée : choisissez votre formule, nous la mettons en service sous 24&nbsp;h.</span>
        <a href="/creer-ma-carte/">Modifier</a>
      </p>
      <PricingCards idPrefix="tarifs" level={2} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Comparer les formules</h2>
        <p>Le détail de ce qui est inclus dans chaque formule.</p>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <caption class="visually-hidden">Comparatif des formules LOYNA</caption>
          <thead>
            <tr>
              <th scope="col">Fonctionnalité</th>
              {
                PLANS.map((p) => (
                  <th scope="col">
                    {p.name}
                    <span>{euro(p.monthly)}/mois</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              lignes.map((row) => (
                <>
                  {row.group && (
                    <tr class="grp">
                      <th scope="colgroup" colspan={4}>
                        {row.group}
                      </th>
                    </tr>
                  )}
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((v) => (
                    <td>
                      {v === true ? (
                        <span class="yes">
                          <Icon name="check" size={18} label="Inclus" />
                        </span>
                      ) : v === false ? (
                        <span class="no" aria-label="Non inclus">
                          —
                        </span>
                      ) : (
                        <strong>{v}</strong>
                      )}
                    </td>
                  ))}
                </tr>
                </>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Une notification correspond à un message de campagne reçu par une carte&nbsp;: une campagne envoyée à 300 clients compte 300 notifications. Les messages automatiques et les notifications de proximité ne sont jamais décomptés.
      </p>
    </div>
  </section>

  <section class="section" id="quotas">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ce que comptent les quotas</p>
        <h2>Des limites claires, pensées pour vos clients</h2>
        <p>Chaque formule fixe un nombre de cartes et de notifications par mois. Pro n’a aucune limite.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <span class="icon"><Icon name="wallet" /></span>
          <h3>Cartes</h3>
          <p>
            Une carte, c’est un client inscrit à votre programme&nbsp;: {nombre(starter.cards ?? 0)} avec Starter, {nombre(premium.cards ?? 0)} avec Premium, sans limite avec Pro. Vous êtes prévenu dans votre espace à 80&nbsp;% et à 100&nbsp;%&nbsp;; au-delà, les nouvelles inscriptions sont refusées et le client voit un message d’attente. Un client supprimé ne compte plus.
          </p>
        </div>
        <div class="card">
          <span class="icon"><Icon name="megaphone" /></span>
          <h3>Notifications</h3>
          <p>
            Une notification, c’est un message de campagne reçu par une carte&nbsp;: {nombre(starter.notifications ?? 0)} par mois avec Starter (une par semaine et par client), {nombre(premium.notifications ?? 0)} avec Premium (douze par client et par mois), sans limite avec Pro. Le quota se recharge le 1er de chaque mois.
          </p>
        </div>
        <div class="card">
          <span class="icon"><Icon name="bell-ring" /></span>
          <h3>Jamais décomptés</h3>
          <p>
            Les messages automatiques (passage validé, récompense débloquée, anniversaire, relance, «&nbsp;Plus qu’un passage&nbsp;!&nbsp;», avis, parrainage, niveau VIP) et les notifications de proximité. Et pour ne pas lasser vos clients, chacun reçoit au plus un message commercial toutes les {MARKETING_INTERVAL_HOURS}&nbsp;h (réglable).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="proximite">
    <div class="container prox-grid">
      <div>
        <p class="eyebrow">Dans toutes les formules</p>
        <h2>La notification de proximité, incluse dès Starter</h2>
        <p class="lead">Quand un client passe près de votre boutique, sa carte s’affiche sur l’écran de verrouillage de son téléphone, avec un court message&nbsp;: sa récompense qui l’attend, les passages qui restent, ou votre propre message.</p>
        <ul class="checks prox-checks">
          <li>iPhone&nbsp;: la carte s’affiche sur l’écran de verrouillage. Android&nbsp;: une notification apparaît quand le client s’attarde près de la boutique.</li>
          <li>Jamais décomptée de vos notifications, sans coût par message.</li>
          <li>LOYNA ne reçoit jamais la position de vos clients&nbsp;: c’est leur téléphone qui détecte la proximité.</li>
          <li>Avec Pro, jusqu’à 3 boutiques, chacune avec sa notification de proximité.</li>
        </ul>
        <p class="prox-note">Fonctionne quand le client a activé la localisation et laissé Wallet s’afficher sur l’écran verrouillé.</p>
      </div>
      <div class="prox-visual">
        <Proximite width={260} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-3">
      <div class="card">
        <span class="icon"><Icon name="rocket" /></span>
        <h2 class="h3">Mise en service : {euro(SETUP_FEE)}, une seule fois</h2>
        <p>Création de votre carte à vos couleurs, de votre QR code d’inscription et de votre espace commerçant. {offerActive() ? <><span data-offer><strong>Offerte jusqu’au {LAUNCH_OFFER.untilLabel}</strong>, en mensuel comme en annuel (appliquée d’office dans votre panier). Ensuite : </span>offerte en paiement annuel.</> : <>Offerte en paiement annuel.</>}</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="sparkles" /></span>
        <h2 class="h3">−15&nbsp;% en paiement annuel</h2>
        <p>Payez l’année en une fois : vous économisez 15&nbsp;% sur l’abonnement et la mise en service est offerte.</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="lock" /></span>
        <h2 class="h3">Paiement sécurisé</h2>
        <p>Paiement par carte bancaire via Stripe. Factures, moyen de paiement et abonnement se gèrent depuis votre espace client.</p>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <CallbackForm title="Un doute sur la formule à choisir ?" text="Laissez votre numéro : on vous rappelle au créneau de votre choix pour trouver la formule adaptée à votre commerce. Ce rappel ne vous engage à rien." />
    </div>
  </section>

  {
    faq.length > 0 && (
      <section class="section section--alt">
        <div class="container narrow">
          <div class="section-head">
            <h2>Questions sur les tarifs</h2>
          </div>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="answer">
                  <p set:html={f.a} />
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <PourVotreMetier />

  <CtaBand callbackHref="#rappel" title="Pas encore décidé ?" text="Créez l’aperçu de votre carte en 30 secondes, ou écrivez-nous : nous vous aidons à choisir la formule adaptée à votre commerce." />
</Base>

<script>
  // Carte préparée dans le configurateur (même navigateur) : on la rappelle au-dessus des formules.
  try {
    const c = JSON.parse(localStorage.getItem('loyna-config') || 'null');
    const box = document.getElementById('ma-carte');
    if (c && c.name && box) {
      document.getElementById('mc-name')!.textContent = `« ${c.name} »`;
      const dots = box.querySelectorAll<HTMLElement>('.mc-dots i');
      if (/^#[0-9a-f]{6}$/i.test(c.bg)) dots[0].style.background = c.bg;
      if (/^#[0-9a-f]{6}$/i.test(c.accent)) dots[1].style.background = c.accent;
      box.hidden = false;
    }
  } catch {
    /* stockage indisponible */
  }
</script>

<style>
  .ma-carte {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    max-width: 860px;
    margin: 0 auto 30px;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--gold-soft);
    border: 1px solid rgba(201, 150, 63, 0.35);
    color: var(--ink);
    font-weight: 600;
    text-align: center;
  }
  .ma-carte[hidden] {
    display: none;
  }
  .ma-carte a {
    color: #6b4a14;
    font-weight: 700;
  }
  .mc-dots {
    display: inline-flex;
  }
  .mc-dots i {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #fff;
    background: #1f1c17;
  }
  .mc-dots i + i {
    margin-left: -8px;
    background: #d9b27a;
  }
  .pt0 {
    padding-top: 0;
  }
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .compare {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }
  .compare th,
  .compare td {
    padding: 15px 20px;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .compare thead th {
    font-size: 1.05rem;
    color: var(--ink);
    background: var(--bg-alt);
  }
  .compare thead th span {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .compare tbody th {
    text-align: left;
    font-weight: 600;
  }
  .compare tbody .grp th {
    padding-top: 22px;
    padding-bottom: 10px;
    background: var(--bg);
    color: var(--gold-strong);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .table-note {
    margin: 18px auto 0;
    max-width: 860px;
    text-align: center;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .prox-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .prox-checks {
    margin: 26px 0 18px;
  }
  .prox-checks li {
    color: #e9e5dc;
  }
  .prox-checks li::before {
    background-color: rgba(230, 194, 122, 0.2);
  }
  .prox-note {
    font-size: 0.92rem;
    color: #a8a194 !important;
    margin: 0;
  }
  .prox-visual {
    display: grid;
    place-items: center;
    padding: 10px 30px;
  }
  @media (max-width: 920px) {
    .prox-grid {
      grid-template-columns: 1fr;
    }
  }
  .compare tbody tr:last-child > * {
    border-bottom: 0;
  }
  .yes {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--gold-soft);
    color: var(--gold-strong);
  }
  .no {
    color: #b9b1a3;
  }
</style>
