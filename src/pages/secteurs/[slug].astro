---
import Base from '../../layouts/Base.astro';
import Jonction from '../../components/Jonction.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WalletCard from '../../components/WalletCard.astro';
import Phone from '../../components/Phone.astro';
import Icon from '../../components/Icon.astro';
import PricingCards from '../../components/PricingCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import {getArticles, getSectors, type Article, type Sector} from '../../lib/builder';
import {autresMetiers, guidesPourMetier} from '../../lib/maillage';
import {PLANS, SITE} from '../../data/site';
import {ogImage} from '../../lib/og';

export async function getStaticPaths() {
  const sectors = await getSectors();
  const articles = await getArticles();
  // Maillage (src/lib/maillage.ts) : guides du même sujet, puis les autres métiers, les plus proches en premier
  return sectors.map((s) => ({params: {slug: s.slug}, props: {s, others: autresMetiers(s, sectors), guides: guidesPourMetier(s, articles)}}));
}
const {s, others, guides} = Astro.props as {s: Sector; others: Sector[]; guides: Article[]};
const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Secteurs', url: '/secteurs/'},
  {name: s.nom, url: `/secteurs/${s.slug}/`},
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}})),
};
const serviceLd = {
  '@type': 'Service',
  name: s.h1,
  serviceType: 'Carte de fidélité digitale',
  provider: {'@id': `${SITE.url}/#organisation`},
  areaServed: 'FR',
  audience: {'@type': 'BusinessAudience', name: s.nom},
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: Math.min(...PLANS.map((p) => p.monthly)),
    highPrice: Math.max(...PLANS.map((p) => p.monthly)),
    offerCount: PLANS.length,
    url: `${SITE.url}/tarifs/`,
  },
};
// Notification de proximité : message affiché quand le client passe près de la boutique (docs/OFFRES.md, § 4)
const proche = `Votre récompense vous attend chez ${s.carte.nom} !`;
---

<Base title={s.metaTitle} description={s.metaDescription} ogImage={ogImage(`secteur-${s.slug}`)} ogImageAlt={s.h1} breadcrumbs={crumbs} jsonLd={[serviceLd, faqLd]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow">{s.nom}</p>
        <h1>{s.h1}</h1>
        <div class="lead intro" set:html={s.intro} />
        <div class="btn-row">
          <a class="btn btn--primary" href="/creer-ma-carte/">Créer ma carte <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn--ghost" href="/tarifs/">Voir les tarifs</a>
        </div>
      </div>
      <div class="visual" aria-hidden="true">
        <Phone width={340} screen="#f3f1ec">
          <div class="wallet-ui">
            <p class="wallet-title">Wallet</p>
            <WalletCard
              name={s.carte.nom}
              activity={s.carte.activite}
              bg={s.carte.couleurFond}
              accent={s.carte.couleurAccent}
              text={s.carte.couleurTexte}
              filled={Math.max(2, s.carte.total - 2)}
              total={s.carte.total}
              reward={s.carte.recompense}
              width={306}
            />
          </div>
        </Phone>
      </div>
    </div>
  </section>

  <Jonction sur vers="sable" forme={1} />

  <section class="section section--alt tete-serree">
    <div class="container">
      <div class="section-head">
        <h2>Vos enjeux au quotidien</h2>
      </div>
      <div class="grid grid-3">
        {
          s.enjeux.map((e) => (
            <div class="card">
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={3} retourne />

  <section class="section tete-serree">
    <div class="container">
      <div class="section-head">
        <h2>Ce que LOYNA change pour vous</h2>
      </div>
      <div class="grid grid-2">
        {
          s.benefices.map((b) => (
            <div class="card benefit">
              <span class="icon">
                <Icon name="check" />
              </span>
              <div>
                <h3>{b.titre}</h3>
                <p>{b.texte}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Jonction de="creme" vers="nuit" forme={5} />

  <section class="section section--dark tete-serree">
    <div class="container grid grid-2">
      <div>
        <h2>Idées de récompenses</h2>
        <ul class="checks light">
          {s.recompenses.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div>
        <h2>Exemples de notifications</h2>
        <div class="notifs">
          <div class="notif notif--prox">
            <span class="n-icon"><Icon name="map-pin" size={16} /></span>
            <span>
              <b>{s.carte.nom} <small>· près de la boutique</small></b>
              <span>{proche}</span>
            </span>
          </div>
          {
            s.messages.map((m) => (
              <div class="notif">
                <span class="n-icon">{s.carte.nom.slice(0, 1)}</span>
                <span>
                  <b>{s.carte.nom}</b>
                  <span>{m}</span>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Jonction de="nuit" vers="creme" forme={2} retourne />

  <section class="section tete-serree">
    <div class="container">
      <div class="section-head">
        <h2>Les tarifs</h2>
        <p>Les mêmes offres pour tous les métiers, avec la notification de proximité incluse dès Starter.</p>
      </div>
      <PricingCards idPrefix={`s-${s.slug}`} compact />
    </div>
  </section>

  <Jonction de="creme" vers="sable" forme={4} />

  <section class="section section--alt tete-serree">
    <div class="container narrow">
      <div class="section-head">
        <h2>Questions fréquentes</h2>
      </div>
      <div class="faq">
        {
          s.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="answer">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {guides.length > 0 && <Jonction de="sable" vers="creme" forme={6} />}

  {
    guides.length > 0 && (
      <section class="section tete-serree" aria-labelledby="guides-titre">
        <div class="container">
          <div class="section-head">
            <h2 id="guides-titre">Guides pour votre métier</h2>
            <p>Nos conseils pour choisir vos récompenses, lancer votre carte et faire revenir vos clients.</p>
          </div>
          <div class="guides">
            {guides.map((g) => (
              <a href={`/blog/${g.slug}/`}>
                <strong>{g.title}</strong>
                <span class="g-excerpt">{g.excerpt}</span>
                <span class="g-more">
                  Lire le guide <Icon name="arrow-right" size={15} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {guides.length > 0 && <Jonction de="creme" vers="sable" forme={3} />}

  <section class="section section--alt tete-serree">
    <div class="container">
      <h2 class="others-title">Les autres métiers</h2>
      <div class="others">
        {
          others.map((o) => (
            <a href={`/secteurs/${o.slug}/`}>
              {o.nom} <Icon name="arrow-right" size={16} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={1} retourne />

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(22px, 4vw, 60px) 0 clamp(70px, 8vw, 110px);
    background: var(--bg);
  }
  @media (min-width: 901px) {
    .hero {
      background:
        radial-gradient(34% 42% at 80% 46%, rgba(164, 135, 255, 0.46), transparent 74%),
        var(--bg);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(26px, 5vw, 70px);
    align-items: start;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.8rem);
  }
  .intro :global(p) {
    margin-bottom: 0.9em;
  }
  /* le bas du téléphone, vide, plonge derrière la jonction */
  .visual {
    display: grid;
    justify-items: center;
    height: 400px;
    margin-bottom: -30px;
  }
  @media (min-width: 901px) {
    .visual {
      align-self: start;
      height: 620px;
      margin-bottom: 0;
    }
  }
  .wallet-ui {
    position: absolute;
    inset: 0;
    padding: 44px 16px;
    color: #15171B;
  }
  .wallet-title {
    font-size: 24px;
    font-weight: 750;
    margin: 6px 2px 14px;
  }
  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
  }
  .benefit h3 {
    margin-top: 6px;
  }
  .light :global(li) {
    color: #DDE1E6;
  }
  .checks.light {
    margin-top: 20px;
    font-size: 1.1rem;
  }
  .notifs {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  .notif {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 20px;
    background: rgba(233, 236, 239, 0.94);
    color: #15171B;
  }
  .notif b {
    display: block;
  }
  .n-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #A487FF;
    font-weight: 800;
  }
  .notif--prox {
    box-shadow: 0 0 0 2px #A487FF;
  }
  .notif--prox small {
    font-weight: 600;
    color: #5A2FE0;
  }
  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }
  .guides a {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .guides a:hover {
    border-color: var(--ink);
  }
  .g-excerpt {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .g-more {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--gold-strong);
    font-weight: 700;
  }
  .others-title {
    font-size: 1.5rem;
    text-align: center;
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 18px;
  }
  .others a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 12px 18px;
    border-radius: 999px;
    border: 1px solid var(--filet);
    background: var(--card);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .others a:hover {
    border-color: var(--ink);
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
