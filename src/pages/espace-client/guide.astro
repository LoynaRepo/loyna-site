---
// Guide de démarrage de l'espace client (LOYNA Business), demande d'Ewan du 2026-10-28 : une courte section par
// partie de l'espace, dans l'ordre de la mise en place, avec une capture de la démonstration. Lien dans l'e-mail
// « Votre carte LOYNA est prête » (dépôt LOYNA, _shared/owner-access-email.ts) et dans le menu de l'espace client.
// Page publique, noindex et hors du plan du site ; elle s'imprime en PDF A4 de 4 pages.
//   - captures : node tools/guide-captures.mjs [adresse du site]  → public/espace-client/guide/*.webp
//   - PDF publié à côté : node tools/guide-pdf.mjs [adresse du site] → public/espace-client/guide/guide-demarrage-loyna.pdf
// Ne rien écrire ici qui n'existe pas dans l'espace client (src/app/views/) ni dans les offres (src/data/site.ts). Les textes
// sur l'essai sortent avec TRIAL.open, comme sur le reste du site.
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import Base from '../../layouts/Base.astro';
import mark from '../../assets/logo-mark.svg?raw';
import word from '../../assets/logo-word.svg?raw';
import {PHRASES, PLANS, SITE, TRIAL, euro} from '../../data/site';

const markSvg = mark.replace('id="g"', 'id="lg-guide"').replace('url(#g)', 'url(#lg-guide)').replace('<svg', '<svg aria-hidden="true"');
const wordSvg = word.replace('<svg', '<svg role="img" aria-label="LOYNA"');
const PDF = '/espace-client/guide/guide-demarrage-loyna.pdf';
// Typographie française déjà posée ici : le PDF peut être imprimé depuis le serveur de développement, sans la passe de la construction
const fr = (t: string) => t.replace(/ ([:;?!»])/g, ' $1').replace(/« /g, '« ');
const [starter, pro] = PLANS;

interface Etape {
  id: string;
  titre: string;
  img: string;
  alt: string;
  texte: string; // HTML court : 2 ou 3 phrases
}
// « Menu X » : nom exact du menu de l'espace (App.tsx) ; « … » : libellé exact d'un bouton ou d'une partie.
const ETAPES: Etape[] = [
  {
    id: 'connexion',
    titre: 'Se connecter',
    img: '01-connexion',
    alt: 'Écran de connexion de l’espace client : adresse e-mail, mot de passe et bouton « Se connecter ».',
    texte:
      'Ouvrez <strong>loyna.fr/espace-client</strong> sur votre téléphone ou votre ordinateur, et connectez-vous avec votre adresse e-mail et votre mot de passe. Sur téléphone, les menus sont en bas de l’écran, les autres sous « Plus ». Mot de passe oublié : touchez « Mot de passe oublié ou première connexion ? », vous recevez un lien par e-mail pour en choisir un nouveau.',
  },
  {
    id: 'reglages',
    titre: 'Réglages : votre carte et votre boutique',
    img: '02-reglages',
    alt: 'Menu Réglages : ajout du logo, couleur de la carte, couleur du texte et téléphone.',
    texte:
      'Menu <strong>Réglages</strong> : ajoutez votre logo, choisissez vos couleurs, indiquez votre téléphone, puis touchez « Enregistrer ». Dans « Boutique et proximité », saisissez l’adresse de la boutique (1 adresse avec Starter, jusqu’à 3 avec Pro : une seule carte, un seul tableau de bord) : la carte s’affiche sur l’écran verrouillé des clients qui passent tout près.',
  },
  {
    id: 'qr-code',
    titre: 'Le QR code d’inscription, au comptoir',
    img: '03-qr-code',
    alt: 'Affiche du comptoir : QR code d’inscription, boutons « Imprimer l’affiche (A4) » et « Télécharger le QR code ».',
    texte:
      'Menu <strong>Réglages</strong>, partie « Affiche du comptoir » : touchez « Imprimer l’affiche (A4) ». Posez-la au comptoir : vos clients la scannent avec l’appareil photo de leur téléphone et ajoutent leur carte à Apple Wallet ou Google Wallet, sans application.',
  },
  {
    id: 'scanner',
    titre: 'Scanner un passage',
    img: '04-scanner',
    alt: 'Scanner : passage validé, nombre de passages du client et bouton « Annuler ».',
    texte:
      'Menu <strong>Scanner</strong> (le bouton rond du milieu, sur téléphone) : touchez « Activer la caméra », puis présentez le QR code de la carte du client à 15–20 cm. Le passage est validé aussitôt ; en cas d’erreur, touchez « Annuler ». Quand une récompense est prête, touchez « Utiliser » au moment de l’offrir.',
  },
  {
    id: 'programme',
    titre: 'Programme et récompenses',
    img: '05-programme',
    alt: 'Programme : liste des récompenses avec le bouton « Ajouter ».',
    texte:
      'Votre carte est déjà réglée : vérifiez-la dans le menu <strong>Programme</strong>. Dans « Récompenses », touchez « Ajouter », ou le crayon, pour créer ou modifier une récompense, par exemple « Café offert » à 10 passages.',
  },
  {
    id: 'automatisations',
    titre: 'Automatisations',
    img: '06-automatisations',
    alt: 'Automatisations : message d’anniversaire avec son interrupteur et son texte.',
    texte:
      'Menu <strong>Automatisations</strong> : chaque message automatique a son interrupteur ; activez-le, adaptez le texte, puis touchez « Enregistrer ». Message après chaque passage, anniversaire, relance des clients absents, « Plus qu’un passage ! » et avis Google : toutes les offres ; niveaux VIP et parrainage entre vos clients : offre Pro.',
  },
  {
    id: 'campagnes',
    titre: 'Campagnes : envoyer un message',
    img: '07-campagnes',
    alt: 'Nouvelle campagne : message, raccourcis prénom et nom du commerce, bouton « Vérifier les destinataires ».',
    texte:
      'Menu <strong>Campagnes</strong>, « Nouvelle campagne » : écrivez votre message, touchez « Vérifier les destinataires », puis envoyez ; il s’affiche sur le téléphone de vos clients, grâce à leur carte. Groupes de clients, envoi programmé et calendrier des temps forts : toutes les offres, avec 5 campagnes par semaine en Starter et sans limite en Pro. Avec l’offre Pro, LOYNA écrit et programme vos messages, envoyés seulement après votre validation.',
  },
  {
    id: 'clients',
    titre: 'Clients',
    img: '08-clients',
    alt: 'Liste des clients : recherche, filtres et solde de chaque client.',
    texte:
      'Menu <strong>Clients</strong> : cherchez un client par son prénom, son nom ou son téléphone, ou filtrez la liste. Sa fiche montre son solde, ses passages et ses récompenses : vous pouvez y utiliser une récompense ou lui renvoyer sa carte. « Exporter en CSV » donne tous vos clients dans un fichier lisible par Excel, à tout moment (propriétaire et responsables).',
  },
  {
    id: 'equipe',
    titre: 'Équipe : ajouter un employé',
    img: '09-equipe',
    alt: 'Équipe : bouton « Inviter un membre » et liste des comptes.',
    texte:
      'Menu <strong>Équipe</strong>, « Inviter un membre » : indiquez son prénom, son adresse e-mail et son rôle, puis touchez « Créer le lien d’accès ». Transmettez-lui ce lien : il choisit lui-même son mot de passe, et vous pouvez retirer son accès à tout moment.',
  },
  {
    id: 'rapport',
    titre: 'Rapport',
    img: '10-rapport',
    alt: 'Rapport mensuel : passages et clients venus, comparés au mois précédent.',
    texte:
      'Menu <strong>Rapport</strong> : vos passages, nouveaux clients, clients revenus et récompenses du mois, comparés au mois précédent, avec jusqu’à 3 conseils. L’<strong>Accueil</strong> montre vos chiffres des 7, 30 ou 90 derniers jours.',
  },
  {
    id: 'abonnement',
    titre: TRIAL.open ? 'Abonnement : votre essai, votre offre' : 'Abonnement : votre offre',
    img: TRIAL.open ? '12-abonnement' : '12-abonnement-offre',
    alt: TRIAL.open ? 'Menu Abonnement pendant l’essai : date de fin de l’essai, jours restants et bouton « Choisir mon offre ».' : 'Menu Abonnement : votre offre, son prix, la prochaine échéance et le portail des factures.',
    texte: `${
      TRIAL.open
        ? 'Pendant l’essai d’un mois, sans carte bancaire, un compteur discret indique les jours restants : aucun prélèvement à la fin. Pour continuer, touchez « Choisir mon offre » dans le menu <strong>Abonnement</strong>. Le premier paiement a lieu le jour de la souscription et les jours restants ne sont pas reportés. '
        : 'Menu <strong>Abonnement</strong> : votre offre et vos échéances. '
    }Starter : ${euro(starter.monthly)} par mois, ou ${euro(starter.engaged)} avec 12 mois d’engagement. Pro : ${euro(pro.monthly)} par mois, ou ${euro(pro.engaged)} avec 12 mois d’engagement. Sans TVA. Le changement d’offre se fait dans ce menu ; factures, carte bancaire et résiliation, sur le portail sécurisé Stripe.`,
  },
  {
    id: 'pause',
    titre: 'Si votre carte passe en pause',
    img: '13-pause',
    alt: 'Bandeau rouge « votre carte est en pause », avec le motif, la date de conservation des données et le bouton pour repartir.',
    texte: `${PHRASES.arret} Le bandeau en haut de l’écran donne le motif et le bouton pour repartir ; pendant la pause, votre espace et l’export de vos clients restent ouverts.`,
  },
  {
    id: 'aide',
    titre: 'Aide et contact',
    img: '11-aide',
    alt: 'Menu « Plus » sur téléphone : Abonnement et Guide de démarrage.',
    texte:
      'Une question : écrivez à <a href="mailto:contact@loyna.fr">contact@loyna.fr</a> en précisant le nom de votre commerce. Ce guide reste dans votre espace (« Guide de démarrage », sous « Plus » sur téléphone) ; vos factures sont dans le menu <strong>Abonnement</strong>. Avec l’offre Pro, fixez votre point mensuel de 30 minutes depuis l’Accueil.',
  },
];

// Dimensions réelles des captures (elles changent si on les refait) : pas de décalage au chargement
const DOSSIER = path.join(process.cwd(), 'public', 'espace-client', 'guide');
const taille = async (nom: string) => {
  const f = path.join(DOSSIER, `${nom}.webp`);
  if (!fs.existsSync(f)) return {};
  const m = await sharp(f).metadata();
  return {width: m.width, height: m.height};
};
const etapes = await Promise.all(ETAPES.map(async (e, i) => ({...e, texte: fr(e.texte), n: i + 1, ...(await taille(e.img))})));
const PREMIERES = [
  {id: 'reglages', titre: 'Réglages', texte: 'Vérifiez votre logo et vos couleurs, ajoutez votre téléphone et l’adresse de votre boutique.'},
  {id: 'qr-code', titre: 'Le QR code au comptoir', texte: 'Imprimez l’affiche et posez-la près de la caisse.'},
  {id: 'scanner', titre: 'Le premier scan', texte: 'Scannez la carte d’un client avec votre téléphone.'},
];
---

<Base
  bare
  noindex
  title="Guide de démarrage LOYNA Business · votre espace client"
  description="Votre espace client LOYNA Business en 2 minutes : connexion, réglages, QR code au comptoir, scanner, programme, automatisations, campagnes, clients, équipe, rapport et abonnement."
>
  <div class="g">
    <header class="g-head">
      <div class="g-head-in">
        <a href="/" class="g-logo" aria-label="loyna.fr"><span class="mark" set:html={markSvg} /><span class="word" set:html={wordSvg} /></a>
        <p class="g-k">LOYNA Business · espace client</p>
        <h1>Guide de <span>démarrage</span></h1>
        <p class="g-lead">Votre espace, partie par partie, dans l’ordre de la mise en place. Il fonctionne sur téléphone comme sur ordinateur.</p>
        <div class="g-actions">
          <a class="g-btn g-btn--gold" href={PDF} download>Télécharger en PDF</a>
          <a class="g-btn" href="/espace-client/">Ouvrir mon espace client</a>
        </div>
      </div>
    </header>

    <div class="g-main">
      <!-- Offre de parrainage LOYNA mise en avant dès le début du guide (demande d'Ewan du 2026-10-28) ; règles :
           panneau « Parrainez un commerçant » du menu Abonnement (views/Abonnement.tsx) et carte « Parrainez un commerçant » de l'accueil de l'espace client -->
      <section class="g-promo" aria-labelledby="g-promo-h">
        <p class="g-promo-tag">Offre parrainage</p>
        <h2 id="g-promo-h" set:html={fr(PHRASES.parrainage)} />
        <p>
          Vous connaissez un commerçant à qui une carte de fidélité rendrait service&nbsp;? Partagez votre code depuis le menu <strong>Abonnement</strong>&nbsp;: il a <strong>son premier mois offert</strong>, et vous <strong>votre mois suivant offert</strong> plus <strong>1 QR code sous verre offert</strong>, dès qu’il a payé sa première mensualité. Dans toutes les offres.
        </p>
        <p class="g-promo-liens"><a href="/espace-client/#/abonnement">Voir mon code de parrainage</a> · <a href="/faq/#parrainage-loyna">Comment ça marche</a></p>
      </section>

      <section class="g-first" aria-labelledby="g-first-h">
        <h2 id="g-first-h">Les 3 premières choses à faire</h2>
        <ol>
          {
            PREMIERES.map((p, i) => (
              <li>
                <span class="g-first-n">{i + 1}</span>
                <span>
                  <a href={`#${p.id}`}>{p.titre}</a>
                  <small set:html={fr(p.texte)} />
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <ol class="g-steps">
        {
          etapes.map((e) => (
            <li class="g-step" id={e.id}>
              <h2>
                <span class="g-n">{e.n}</span>
                {e.titre}
              </h2>
              <p set:html={e.texte} />
              <figure>
                <img src={`/espace-client/guide/${e.img}.webp`} alt={e.alt} width={e.width} height={e.height} decoding="async" />
              </figure>
            </li>
          ))
        }
      </ol>
    </div>

    <footer class="g-foot">
      <p>
        <strong>LOYNA</strong>, une marque de KOVA Elec · <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · loyna.fr/espace-client/guide
      </p>
      <p class="g-foot-n">Captures : démonstration de LOYNA Business (commerce et clients fictifs).</p>
    </footer>
  </div>
</Base>

<style>
  .g {
    --gutter: 16px;
    min-height: 100vh;
    background: var(--bg);
  }
  /* En-tête noir et or, comme le menu de l'espace client */
  .g-head {
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(230, 194, 122, 0.22), transparent 70%),
      var(--ink);
    color: #e9e5dc;
    padding: 26px var(--gutter) 34px;
  }
  .g-head-in,
  .g-main,
  .g-foot {
    max-width: 980px;
    margin: 0 auto;
  }
  .g-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f8f4ec;
    text-decoration: none;
  }
  .g-logo :global(.mark svg) {
    width: 30px;
    height: 30px;
  }
  .g-logo :global(.word svg) {
    height: 14px;
    width: auto;
  }
  .g-k {
    margin: 26px 0 6px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #e6c27a;
  }
  .g-head h1 {
    color: #faf7f0;
    font-size: clamp(2rem, 6vw, 3.1rem);
    margin: 0 0 10px;
  }
  .g-head h1 span {
    background: var(--grad-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .g-lead {
    margin: 0;
    max-width: 560px;
    color: #c9c2b4;
  }
  .g-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .g-btn {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 11px 20px;
    border-radius: 999px;
    border: 1px solid rgba(250, 247, 240, 0.22);
    color: #faf7f0;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .g-btn:hover {
    color: #fff;
    background: rgba(250, 247, 240, 0.08);
  }
  .g-btn--gold {
    border: 0;
    background: var(--grad-gold);
    color: var(--ink);
  }
  .g-btn--gold:hover {
    color: var(--ink);
    filter: brightness(1.05);
  }

  .g-main {
    padding: 0 var(--gutter);
  }
  /* Encadré « Offre parrainage », en tête du guide : posé à cheval sur l'en-tête, à la place du suivant */
  .g-promo {
    position: relative;
    margin-top: -16px;
    margin-bottom: 18px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, #1d1a14, #121216);
    color: #faf7f0;
    border: 1px solid #c9a24d;
    box-shadow: var(--shadow);
  }
  .g-promo-tag {
    display: inline-block;
    margin: 0 0 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: #e6c27a;
    color: #121216;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .g-promo h2 {
    font-size: 1.2rem;
    margin: 0 0 8px;
    color: #e6c27a;
  }
  .g-promo p {
    margin: 0 0 8px;
  }
  .g-promo-liens a {
    color: #e6c27a;
    font-weight: 600;
  }
  .g-promo + .g-first {
    margin-top: 0;
  }
  @media print {
    .g-promo {
      margin: -5mm 5mm 3mm;
      padding: 3mm 5mm;
      box-shadow: none;
      break-inside: avoid;
    }
    .g-promo h2 {
      font-size: 11pt;
      margin-bottom: 1mm;
    }
    .g-promo p {
      margin-bottom: 1mm;
    }
    .g-promo + .g-first {
      margin-top: 0;
    }
  }
  /* Encadré « Les 3 premières choses à faire », posé à cheval sur l'en-tête (sauf après l'offre parrainage) */
  .g-first {
    position: relative;
    margin-top: -16px;
    padding: 20px 20px 18px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .g-first h2 {
    font-size: 1.25rem;
    margin: 0 0 12px;
  }
  .g-first ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .g-first li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .g-first li > span:last-child {
    display: grid;
    line-height: 1.4;
  }
  .g-first a {
    font-weight: 750;
    color: var(--ink);
    text-decoration: none;
  }
  .g-first small {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .g-first-n,
  .g-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--grad-gold);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .g-steps {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .g-step {
    padding: 18px 18px 20px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    scroll-margin-top: 16px;
  }
  .g-step h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    margin: 0 0 8px;
  }
  .g-step p {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.6;
  }
  .g-step figure {
    margin: 14px 0 0;
    text-align: center;
  }
  .g-step img {
    display: inline-block;
    width: auto;
    max-width: 100%;
    max-height: 440px;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(18, 18, 22, 0.05), 0 10px 26px rgba(18, 18, 22, 0.08);
    background: var(--bg);
  }

  .g-foot {
    padding: 26px var(--gutter) 40px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .g-foot p {
    margin: 0 0 4px;
  }
  .g-foot-n {
    font-size: 0.8rem;
  }

  @media (min-width: 820px) {
    .g {
      --gutter: 32px;
    }
    .g-head {
      padding: 34px var(--gutter) 46px;
    }
    .g-first ol {
      grid-template-columns: repeat(3, 1fr);
    }
    .g-steps {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  /* Impression et PDF : A4, deux colonnes, quatre pages au plus */
  @page {
    size: A4;
    margin: 10mm 11mm;
  }
  @media print {
    :global(html),
    :global(body) {
      background: #fff;
      font-size: 9pt;
    }
    .g {
      --gutter: 0;
      min-height: 0;
      background: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .g-head {
      padding: 5mm 7mm 8.5mm;
      border-radius: 4mm;
    }
    .g-logo :global(.mark svg) {
      width: 8mm;
      height: 8mm;
    }
    .g-logo :global(.word svg) {
      height: 3.6mm;
    }
    .g-k {
      margin: 3mm 0 1mm;
      font-size: 7pt;
    }
    .g-head h1 {
      font-size: 21pt;
      margin: 0 0 1mm;
    }
    .g-head h1 span {
      background: none;
      color: #d9b27a; /* le texte en dégradé laisse un filet dans le PDF */
    }
    .g-lead {
      font-size: 8.8pt;
      max-width: none;
    }
    .g-actions {
      display: none;
    }
    .g-first {
      margin-top: -5mm;
      margin-left: 5mm;
      margin-right: 5mm;
      padding: 3.5mm 5mm;
      box-shadow: none;
      break-inside: avoid;
    }
    .g-first h2 {
      font-size: 11.5pt;
      margin-bottom: 2mm;
    }
    .g-first ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 4mm;
    }
    .g-first small {
      font-size: 8pt;
    }
    .g-first-n,
    .g-n {
      width: 6mm;
      height: 6mm;
      font-size: 8.5pt;
    }
    .g-steps {
      grid-template-columns: 1fr 1fr;
