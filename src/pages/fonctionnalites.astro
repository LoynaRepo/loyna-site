---
import {Picture} from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import WalletCard from '../components/WalletCard.astro';
import CardSwatches from '../components/CardSwatches.astro';
import passageValide from '../assets/shots/passage-valide.png';
import recompense from '../assets/shots/recompense.png';
import notifications from '../assets/shots/notifications.png';
import tableau from '../assets/shots/tableau-de-bord.png';
import sms from '../assets/shots/sms.png';
import automatisations from '../assets/shots/automatisations.png';
import inscription from '../assets/shots/inscription.png';
import walletShot from '../assets/shots/wallet-card.png';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Fonctionnalités', url: '/fonctionnalites/'},
];

const blocks = [
  {
    id: 'carte-wallet',
    eyebrow: 'La carte',
    title: 'Une carte de fidélité dans Apple Wallet et Google Wallet',
    text: 'Votre carte vit dans le téléphone de vos clients, à côté de leur carte bancaire. Pas d’application à télécharger, pas de compte à créer : un QR code, un formulaire court, et la carte est ajoutée en un geste.',
    points: ['Compatible iPhone (Apple Wallet) et Android (Google Wallet)', 'À vos couleurs, avec votre logo et le nom de votre programme', 'Solde et récompense mis à jour automatiquement après chaque passage', 'QR code sans aucune donnée personnelle (jeton opaque et révocable)'],
    card: true,
  },
  {
    id: 'inscription',
    eyebrow: 'Inscription',
    title: 'Vos clients s’inscrivent en quelques secondes',
    text: 'Affichez votre QR code d’inscription au comptoir, en vitrine ou sur vos réseaux. Le formulaire ne demande que l’essentiel, avec des consentements séparés et jamais pré-cochés.',
    points: ['Prénom et téléphone facultatif', 'Consentements distincts : fidélité, offres Wallet, SMS', 'Boutons « Ajouter à Apple Wallet » et « Enregistrer dans Google Wallet »', 'Page d’inscription à votre nom et à vos couleurs'],
    img: inscription,
    alt: 'Formulaire d’inscription au programme de fidélité sur mobile',
  },
  {
    id: 'scanner',
    eyebrow: 'Scanner',
    title: 'Un scan = un passage validé',
    text: 'Le cœur de LOYNA Business : vous scannez la carte du client avec votre téléphone, et c’est tout. Pas de recherche du client, pas de bouton +1, pas de seconde confirmation.',
    points: ['Protection anti double scan (délai réglable)', 'Bouton « Annuler » pendant quelques secondes', 'Fonctionne sur n’importe quel smartphone récent', 'Chaque passage est tracé dans le journal d’activité'],
    img: passageValide,
    alt: 'Écran « Passage validé » dans LOYNA Business',
  },
  {
    id: 'recompenses',
    eyebrow: 'Récompenses',
    title: 'Les récompenses se débloquent toutes seules',
    text: 'Fixez votre seuil (par exemple 10 passages) et votre récompense. Quand le client l’atteint, la récompense apparaît sur sa carte et il reçoit une notification. Au comptoir, elle s’utilise en un scan.',
    points: ['Carte à passages (tampons) ou à points', 'Récompenses multiples possibles', 'Historique complet de chaque client', 'Ajustement manuel motivé et tracé si besoin'],
    img: recompense,
    alt: 'Récompense débloquée sur l’écran du commerçant',
  },
  {
    id: 'notifications',
    eyebrow: 'Notifications Wallet',
    title: 'Le bon message, au bon moment, sur l’écran de verrouillage',
    text: 'Les notifications Wallet sont le canal principal de LOYNA : elles s’affichent sur le téléphone du client, sans coût par message. Elles servent à faire revenir, pas à harceler.',
    points: ['Récompense disponible', 'Anniversaire du client', 'Relance après 30, 60 ou 90 jours d’absence', 'Offre ou nouveauté, pour les clients qui l’ont accepté'],
    img: notifications,
    alt: 'Notifications Wallet affichées sur un iPhone',
  },
  {
    id: 'automatisations',
    eyebrow: 'Automatisations',
    title: 'La fidélité qui fonctionne toute seule',
    text: 'Anniversaires, clients inactifs, récompenses, campagnes programmées : LOYNA envoie les bons messages pendant que vous travaillez. Vous gardez la main sur les textes et les règles.',
    points: ['Anniversaires automatiques (Growth et Pro)', 'Relance des clients inactifs (Growth et Pro)', 'Campagnes Wallet programmées (Growth et Pro)', 'Automatisations avancées (Pro)'],
    img: automatisations,
    alt: 'Schéma des automatisations : anniversaire, absence, dixième passage',
  },
  {
    id: 'campagnes-sms',
    eyebrow: 'Campagnes et SMS',
    title: 'Des campagnes ciblées, en Wallet ou par SMS',
    text: 'Choisissez votre audience (tous, actifs, inactifs depuis 30, 60 ou 90 jours, anniversaires du mois, récompense disponible) et votre canal. Le compteur SMS vous indique le nombre de SMS par destinataire avant l’envoi.',
    points: ['200 SMS par mois inclus en Growth, 500 en Pro', 'Détection des caractères coûteux et suggestion d’une version plus courte', 'Jamais de modification de votre message sans votre accord', 'Désinscription SMS gérée automatiquement'],
    img: sms,
    alt: 'Compteur SMS : 1 SMS par destinataire',
  },
  {
    id: 'tableau-de-bord',
    eyebrow: 'Tableau de bord',
    title: 'Des chiffres clairs pour piloter votre fidélité',
    text: 'Clients actifs, nouveaux clients, passages, récompenses débloquées et utilisées, clients inactifs, évolution de l’activité : tout est calculé à partir de vos vrais passages.',
    points: ['Période réglable', 'Statistiques avancées en Growth et Pro', 'Fiche détaillée par client', 'Export des données d’un client à la demande'],
    img: tableau,
    alt: 'Tableau de bord LOYNA Business : clients actifs, passages, récompenses',
  },
];

// Haut de page : chaque fonctionnalité a son icône, sa capture et une phrase d'accroche.
const ICONES: Record<string, string> = {
  'carte-wallet': 'wallet',
  inscription: 'user-plus',
  scanner: 'scan-line',
  recompenses: 'gift',
  notifications: 'bell',
  automatisations: 'workflow',
  'campagnes-sms': 'message-square-text',
  'tableau-de-bord': 'chart-column',
};
const explorer = blocks.map((b) => ({
  id: b.id,
  label: b.eyebrow,
  title: b.title,
  short: b.text.split(/(?<=\.)\s/)[0],
  icon: ICONES[b.id],
  img: b.img ?? walletShot,
  alt: b.alt ?? 'Carte de fidélité LOYNA dans Apple Wallet',
}));

const more = [
  {icon: 'users', title: 'Équipe et rôles', text: 'Un compte par personne : propriétaire, administrateur, employé. Pas de limite d’employés.'},
  {icon: 'palette', title: 'Personnalisation sans code', text: 'Logo, couleurs, nom du programme et récompense, modifiables quand vous voulez.'},
  {icon: 'file-text', title: 'Journal d’activité', text: 'Passage ajouté ou annulé, récompense utilisée, campagne envoyée : tout est tracé.'},
  {icon: 'shield-check', title: 'RGPD intégré', text: 'Consentements séparés, désinscription, export et suppression des données d’un client.'},
  {icon: 'lock', title: 'Sécurité', text: 'Données chiffrées et hébergées dans l’Union européenne, jamais utilisées à des fins commerciales.'},
  {icon: 'settings-2', title: 'Intégrations (Pro)', text: 'Intégrations compatibles, API et webhooks pour connecter vos outils.'},
];
---

<Base
  title="Logiciel de fidélité : carte Wallet, scan et relances"
  description="Logiciel de fidélité pour commerces : carte Apple et Google Wallet, validation en un scan, récompenses automatiques, notifications, SMS et statistiques."
  ogImage="/og/fonctionnalites.png"
  breadcrumbs={crumbs}
>
  <section class="f-hero" id="explorer">
    <div class="container f-grid">
      <div class="f-copy">
        <Breadcrumbs items={crumbs} />
        <p class="eyebrow">Logiciel de fidélité</p>
        <h1>Tout pour fidéliser vos clients, <span class="gold-text">rien de compliqué</span></h1>
        <p class="lead">Une carte dans le téléphone de vos clients, un scanner dans le vôtre, et des automatisations qui travaillent pour vous.</p>
      </div>

      <div class="f-tabs" role="tablist" aria-label="Fonctionnalités">
        {
          explorer.map((f, k) => (
            <a href={`#${f.id}`} class="f-tab" role="tab" id={`tab-${f.id}`} aria-selected={k === 0 ? 'true' : 'false'} aria-controls="f-panel" data-k={k}>
              <Icon name={f.icon} size={18} />
              <span>{f.label}</span>
              <i class="f-progress" aria-hidden="true" />
            </a>
          ))
        }
      </div>

      <div class="f-stage">
        {
          explorer.map((f, k) =>
            f.id === 'carte-wallet' ? (
              <figure class={`f-shot f-custom ${k === 0 ? 'on' : ''}`} data-k={k}>
                <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={320} qr={false} class="fc-live" />
                <form class="fc-form" id="fc-form" method="get" action="/creer-ma-carte/">
                  <label class="sr-only" for="fc-name">Nom de votre commerce</label>
                  <input id="fc-name" name="nom" type="text" maxlength="40" placeholder="Tapez le nom de votre commerce" autocomplete="organization" />
                  <CardSwatches stacked />
                  <button type="submit" class="btn btn--gold btn--block">Personnaliser ma carte <Icon name="arrow-right" size={18} /></button>
                </form>
              </figure>
            ) : (
              <figure class={`f-shot ${k === 0 ? 'on' : ''}`} data-k={k} aria-hidden={k === 0 ? undefined : 'true'}>
                <Picture src={f.img} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 540]} sizes="(max-width: 900px) 80vw, 420px" alt={f.alt} loading={k === 0 ? 'eager' : 'lazy'} fetchpriority={k === 0 ? 'high' : undefined} />
              </figure>
            ),
          )
        }
        <div class="f-count"><b data-f="num">1</b> / {explorer.length}</div>
      </div>

      <div class="f-panel" id="f-panel" role="tabpanel" aria-live="polite">
        <p class="f-title" data-f="title">{explorer[0].title}</p>
        <p class="f-text" data-f="short">{explorer[0].short}</p>
        <a class="f-more" href={`#${explorer[0].id}`} data-f="more">Voir le détail <Icon name="arrow-down" size={16} /></a>
      </div>
    </div>
    <script type="application/json" id="f-data" set:html={JSON.stringify(explorer.map((f) => ({id: f.id, title: f.title, short: f.short})))} />
  </section>

  {
    blocks.map((b, i) => (
      <section id={b.id} class={`section ${i % 2 ? 'section--alt' : ''}`}>
        <div class={`container feat ${i % 2 ? 'flip' : ''}`}>
          <div>
            <p class="eyebrow">{b.eyebrow}</p>
            <h2>{b.title}</h2>
            <p class="lead">{b.text}</p>
            <ul class="checks">
              {b.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
          <div class="media">
            {b.card ? (
              <div class="cards-demo">
                <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={300} />
                <WalletCard name="Snack Sirocco" activity="Restauration rapide" bg="#9b1c1c" accent="#ffd166" filled={5} total={8} reward="Un menu offert" variant="google" qr={false} width={260} class="second" />
              </div>
            ) : (
              <div class="shot">
                <Picture src={b.img!} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480, 640]} sizes="(max-width: 900px) 85vw, 420px" alt={b.alt!} loading="lazy" />
              </div>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Et aussi</p>
        <h2>Les détails qui font la différence</h2>
      </div>
      <div class="grid grid-3">
        {
          more.map((m) => (
            <div class="card">
              <span class="icon">
                <Icon name={m.icon} />
              </span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  import {appliquerCarte, brancherCouleurs, ouvrirConfigurateur, type CarteDemo} from '../lib/carte-live';

  // Onglet « La carte » : la carte se met à jour en direct (nom, couleurs) et ouvre le configurateur.
  const carte = document.querySelector<HTMLElement>('.fc-live');
  const fcForm = document.getElementById('fc-form') as HTMLFormElement | null;
  if (carte && fcForm) {
    const nom = fcForm.querySelector<HTMLInputElement>('#fc-name')!;
    let d: CarteDemo = {name: 'Maison Lumière', activity: 'Coiffure', bg: '#1f1c17', accent: '#d9b27a', total: 10, reward: 'Brushing offert'};
    nom.addEventListener('input', () => {
      d = {...d, name: nom.value.trim() || 'Votre commerce'};
      appliquerCarte(carte, d, false);
    });
    brancherCouleurs(fcForm, (cible, couleur) => {
      d = {...d, name: nom.value.trim() || d.name, [cible]: couleur};
      appliquerCarte(carte, d, false);
    });
    fcForm.addEventListener('submit', (e) => {
      e.preventDefault();
      ouvrirConfigurateur({...d, name: nom.value.trim() || d.name});
    });
  }

  // Explorateur : onglet actif = capture affichée ; défilement automatique jusqu'à la première interaction.
  const root = document.getElementById('explorer');
  if (root) {
    const data = JSON.parse(document.getElementById('f-data')!.textContent || '[]') as {id: string; title: string; short: string}[];
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('.f-tab')];
    const shots = [...root.querySelectorAll<HTMLElement>('.f-shot')];
    const strip = root.querySelector<HTMLElement>('.f-tabs')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0;
    let timer = 0;
    const set = (k: number) => {
      cur = (k + data.length) % data.length;
      tabs.forEach((t, n) => {
        t.setAttribute('aria-selected', n === cur ? 'true' : 'false');
        t.tabIndex = n === cur ? 0 : -1;
      });
      shots.forEach((sh, n) => {
        sh.classList.toggle('on', n === cur);
        sh.toggleAttribute('inert', n !== cur);
        if (n === cur) sh.removeAttribute('aria-hidden');
        else sh.setAttribute('aria-hidden', 'true');
      });
      root.querySelector('[data-f="num"]')!.textContent = String(cur + 1);
      root.querySelector('[data-f="title"]')!.textContent = data[cur].title;
      root.querySelector('[data-f="short"]')!.textContent = data[cur].short;
      root.querySelector<HTMLAnchorElement>('[data-f="more"]')!.href = `#${data[cur].id}`;
      // rangée d'onglets défilante (mobile) : on amène l'onglet actif au centre, sans faire défiler la page
      if (strip.scrollWidth > strip.clientWidth) {
        const t = tabs[cur];
        strip.scrollTo({left: t.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth'});
      }
    };
    const stop = () => {
      window.clearInterval(timer);
      root.classList.add('manual');
    };
    if (!reduce) {
      root.classList.add('auto');
      timer = window.setInterval(() => set(cur + 1), 4500);
    }
    tabs.forEach((t, n) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        stop();
        set(n);
      });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          stop();
          set(cur + (e.key === 'ArrowRight' ? 1 : -1));
          tabs[cur].focus();
        }
      });
    });
    root.querySelector('.f-stage')?.addEventListener('pointerenter', stop);
    root.querySelector('.f-stage')?.addEventListener('focusin', stop);
    shots.forEach((sh, n) => sh.toggleAttribute('inert', n !== cur));
  }
</script>

<style>
  /* Haut de page : explorateur visuel des fonctionnalités */
  .f-hero {
    padding: clamp(36px, 5vw, 72px) 0 clamp(44px, 6vw, 84px);
    color: #e9e5dc;
    background:
      radial-gradient(50% 70% at 80% 35%, rgba(230, 194, 122, 0.22), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgba(201, 150, 63, 0.12), transparent 70%),
      linear-gradient(180deg, #121216, #17151a);
  }
  .f-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas:
      'copy stage'
      'tabs stage'
      'panel stage';
    column-gap: clamp(30px, 5vw, 72px);
    align-items: start;
  }
  .f-copy {
    grid-area: copy;
  }
  .f-copy :global(.breadcrumbs a),
  .f-copy :global(.breadcrumbs li) {
    color: #a8a194;
  }
  .f-copy :global(.breadcrumbs li[aria-current]) {
    color: #e9e5dc;
  }
  .f-copy h1 {
    color: #faf7f0;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
  }
  .f-copy .eyebrow {
    color: #e6c27a;
  }
  .f-copy .lead {
    color: #c9c2b4;
    max-width: 560px;
  }
  .f-tabs {
    grid-area: tabs;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .f-tab {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(250, 247, 240, 0.12);
    background: rgba(250, 247, 240, 0.04);
    color: #d9d2c4;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .f-tab :global(svg) {
    color: #e6c27a;
    flex-shrink: 0;
  }
  .f-tab:hover {
    border-color: rgba(230, 194, 122, 0.45);
    color: #fff;
  }
  .f-tab[aria-selected='true'] {
    background: rgba(230, 194, 122, 0.14);
    border-color: rgba(230, 194, 122, 0.6);
    color: #fff;
  }
  .f-tab:focus-visible {
    outline: 3px solid rgba(230, 194, 122, 0.55);
    outline-offset: 2px;
  }
  /* barre de progression du défilement automatique */
  .f-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--grad-gold);
  }
  :global(.auto:not(.manual)) .f-tab[aria-selected='true'] .f-progress {
    animation: fprog 4.5s linear;
  }
  .f-panel {
    grid-area: panel;
    margin-top: 22px;
    padding-left: 16px;
    border-left: 3px solid #c9963f;
    min-height: 118px;
  }
  .f-title {
    margin: 0 0 6px;
    font-weight: 750;
    font-size: 1.15rem;
    color: #faf7f0;
  }
  .f-text {
    margin: 0 0 10px;
    color: #c9c2b4;
  }
  .f-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: #e6c27a;
    font-weight: 700;
    text-decoration: none;
  }
  .f-more:hover {
    text-decoration: underline;
  }
  .f-stage {
    grid-area: stage;
    position: relative;
    align-self: center;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 470px;
    justify-self: center;
    border-radius: 32px;
    background:
      radial-gradient(70% 60% at 50% 40%, rgba(230, 194, 122, 0.28), transparent 70%),
      #0d0c10;
    border: 1px solid rgba(230, 194, 122, 0.22);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  .f-shot {
    position: absolute;
    inset: 6%;
    margin: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: scale(0.96) translateY(10px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .f-shot.on {
    opacity: 1;
    transform: none;
  }
  .f-shot :global(picture) {
    display: contents;
  }
  .f-shot :global(img) {
    /* image entière et centrée dans la vitrine, quel que soit son format */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 18px;
    /* bords de la capture fondus dans la vitrine */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    mask-composite: intersect;
  }
  .f-custom {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 18px;
  }
  .f-custom :global(.wcard) {
    width: min(320px, 100%);
  }
  .fc-form {
    width: min(340px, 100%);
    display: grid;
    gap: 12px;
  }
  .fc-form input[type='text'] {
    min-height: 48px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid rgba(250, 247, 240, 0.2);
    background: rgba(18, 18, 22, 0.7);
    color: #faf7f0;
    font: inherit;
  }
  .fc-form input[type='text']::placeholder {
    color: #8f887c;
  }
  .fc-form input[type='text']:focus {
    outline: 3px solid rgba(230, 194, 122, 0.45);
    border-color: #e6c27a;
  }
  .f-count {
    position: absolute;
    right: 16px;
    bottom: 14px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(18, 18, 22, 0.7);
    color: #c9c2b4;
    font-size: 0.82rem;
  }
  .f-count b {
    color: #e6c27a;
  }
  @keyframes fprog {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @media (max-width: 900px) {
    .f-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'tabs'
        'stage'
        'panel';
    }
    .f-tabs {
      display: flex;
      overflow-x: auto;
      gap: 8px;
      margin: 6px -20px 0;
      padding: 4px 20px 10px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .f-tabs::-webkit-scrollbar {
      display: none;
    }
    .f-tab {
      flex: 0 0 auto;
      scroll-snap-align: center;
