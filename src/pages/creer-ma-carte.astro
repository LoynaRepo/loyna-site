  }
  .custom.is-picked {
    background:
      radial-gradient(circle closest-side, var(--pick) 0 50%, #fff 54% 63%, rgb(255 255 255 / 0) 67%),
      var(--roue-arc);
  }
  .custom.is-picked,
  .custom[aria-expanded='true'] {
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 5px var(--ink);
  }
  /* Réglage libre d'une couleur : trois curseurs dont le fond montre le résultat, puis le code couleur */
  .picker {
    --h: 40;
    --s: 30%;
    --l: 30%;
    display: grid;
    gap: 10px;
    margin-top: 6px;
