  }
  .picker input[type='range']:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .pk-h {
    --piste: linear-gradient(to right, hsl(0 85% 50%), hsl(60 85% 50%), hsl(120 85% 50%), hsl(180 85% 50%), hsl(240 85% 50%), hsl(300 85% 50%), hsl(360 85% 50%));
  }
  .pk-s {
    --piste: linear-gradient(to right, hsl(var(--h) 0% var(--l)), hsl(var(--h) 100% var(--l)));
  }
  .pk-l {
    --piste: linear-gradient(to right, #000, hsl(var(--h) var(--s) 50%), #fff);
  }
  .picker .pk-code input {
    max-width: 170px;
    min-height: 44px;
    padding: 8px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
