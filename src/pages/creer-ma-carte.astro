    border: 4px solid #fff;
    background: hsl(var(--h) var(--s) var(--l));
    box-shadow: 0 1px 5px rgb(0 0 0 / 0.35);
  }
  .picker input[type='range']::-moz-range-thumb {
    width: 20px;
