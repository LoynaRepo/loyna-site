---
import Base from '../layouts/Base.astro';
import Jonction from '../components/Jonction.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Phone from '../components/Phone.astro';
import WalletCard from '../components/WalletCard.astro';
import Icon from '../components/Icon.astro';
import {APPEL, CARD_ACCENTS, CARD_ACTIVITES, CARD_BGS, PHRASES, SITE, TRIAL, essaiUrl} from '../data/site';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Créer ma carte', url: '/creer-ma-carte/'},
];
// Couleurs de la carte et des tampons : ronds prédéfinis, puis le rond arc-en-ciel qui ouvre le réglage libre
// (teinte, intensité, clarté, code couleur) dans la page : la carte change en direct, y compris sur téléphone,
// où le sélecteur du système couvrait l'écran et ne mettait pas toujours l'aperçu à jour.
const couleurs = [
  {cible: 'bg', legende: 'Couleur de la carte', liste: CARD_BGS, valeur: '#1f1c17', libre: 'Couleur de carte personnalisée'},
  {cible: 'accent', legende: 'Couleur des tampons', liste: CARD_ACCENTS, valeur: '#d9b27a', libre: 'Couleur des tampons personnalisée'},
];
const activities = CARD_ACTIVITES.map((a) => a.nom);
// Exemples de cartes par métier (requêtes « modèle » et « exemple de carte de fidélité », Haloscan 2026-10-29) :
// chaque lien ouvre le configurateur réglé sur ce métier, avec sa récompense et ses couleurs par défaut.
const PAGE_METIER: Record<string, string> = {
  Coiffure: 'coiffeur-barbier',
  Barbier: 'barbier',
  'Institut de beauté': 'institut-onglerie',
  Onglerie: 'onglerie',
  Boulangerie: 'boulangerie-cafe',
  Café: 'boulangerie-cafe',
  Restaurant: 'restaurant',
  Snack: 'restauration-rapide',
  Pizzeria: 'pizzeria',
  Sushi: 'sushi',
  Fleuriste: 'fleuriste',
  Boucherie: 'boucherie-traiteur',
  Pressing: 'pressing',
  Boutique: 'commerce-de-proximite',
};
const modeles = CARD_ACTIVITES.filter((a) => PAGE_METIER[a.nom]).map((a) => ({...a, page: PAGE_METIER[a.nom]}));
// Questions fréquentes de la page (affichées et décrites en données structurées FAQPage)
const cfgFaq = [
  {q: 'Créer l’aperçu de ma carte de fidélité est-il gratuit ?', a: `Oui. Le configurateur est gratuit et sans inscription : vous voyez votre carte à votre nom, à vos couleurs et avec votre récompense. ${TRIAL.open ? PHRASES.essai : 'Vous ne payez que si vous décidez de lancer votre carte.'}`},
  {q: 'Combien de temps faut-il pour que ma carte soit prête ?', a: `${TRIAL.open ? 'Avec l’essai, votre carte et votre QR code d’inscription sont créés dès que vous confirmez votre adresse e-mail. ' : ''}Après une commande, LOYNA crée votre carte et votre QR code d’inscription sous 24 h, hors personnalisation exceptionnelle.`},
  {q: 'Mes clients doivent-ils télécharger une application ?', a: 'Non. La carte s’ajoute à Apple Wallet sur iPhone et à Google Wallet sur Android, déjà présents sur leur téléphone.'},
  {q: 'Pourrai-je modifier ma carte plus tard ?', a: 'Oui. Couleurs, logo, nom du programme, récompense et seuil se modifient depuis votre espace client, et les cartes déjà installées chez vos clients se mettent à jour toutes seules.'},
];
const appLd = {
  '@type': 'WebApplication',
  name: 'Configurateur de carte de fidélité LOYNA',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  url: `${SITE.url}/creer-ma-carte/`,
  offers: {'@type': 'Offer', price: 0, priceCurrency: 'EUR'},
};
---

<Base stickyCta={{primary: TRIAL.open ? APPEL : {href: '/tarifs/?carte=1', label: 'Je veux cette carte'}, secondary: {href: '/demo/', label: 'Démo'}}}
  finPage="sable"
  title="Créer une carte de fidélité en ligne : modèle gratuit"
  description="Créez gratuitement le modèle de votre carte de fidélité Apple et Google Wallet : nom, couleurs, logo, récompense. Aperçu en direct et exemples par métier."
  ogImage="/og/creer-ma-carte.png"
  breadcrumbs={crumbs}
  jsonLd={[appLd, {'@type': 'FAQPage', mainEntity: cfgFaq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}}))}]}
>
  <section class="page-hero compact">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Configurateur</p>
      <h1>Créez l’aperçu de votre carte de fidélité</h1>
      <p class="lead">Un modèle gratuit, sans inscription<span class="lead-suite"> : choisissez votre nom, vos couleurs, votre logo et votre récompense, et votre carte se met à jour en direct, telle que vos clients la verront dans leur Wallet</span>.</p>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={1} />

  <section class="section pt0">
    <div class="container configurator">
      <form class="panel" id="cfg" aria-label="Personnalisation de la carte" onsubmit="return false">
        <div class="field">
          <label for="c-name">Nom de votre commerce</label>
          <input id="c-name" name="name" type="text" maxlength="32" value="Maison Lumière" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="c-activity">Activité</label>
          <select id="c-activity" name="activity">
            {activities.map((a) => <option selected={a === 'Coiffure'}>{a}</option>)}
          </select>
          <input id="c-activity-other" class="act-other" type="text" maxlength="30" placeholder="Votre activité : fromagerie, tatoueur…" aria-label="Votre activité" hidden />
        </div>
        {
          couleurs.map((g) => (
            <fieldset class="field">
              <legend>{g.legende}</legend>
              <div class="swatches" data-target={g.cible}>
                {g.liste.map((c, i) => (
                  <button type="button" class="sw" style={`--c:${c.c}`} data-color={c.c} aria-label={c.nom} title={c.nom} aria-pressed={i === 0 ? 'true' : 'false'} />
                ))}
                <button type="button" class="sw custom" aria-expanded="false" aria-controls={`pk-${g.cible}`} aria-label={g.libre} title="Couleur personnalisée" />
                <input type="color" id={`c-${g.cible}`} value={g.valeur} hidden />
              </div>
              <div class="picker" id={`pk-${g.cible}`} data-target={g.cible} hidden>
                <label>
                  <span>Teinte</span>
                  <input type="range" class="pk-h" data-pk min="0" max="359" />
                </label>
                <label>
                  <span>Intensité</span>
                  <input type="range" class="pk-s" data-pk min="0" max="100" />
                </label>
                <label>
                  <span>Clarté</span>
                  <input type="range" class="pk-l" data-pk min="0" max="100" />
                </label>
                <label class="pk-code">
                  <span>Code couleur</span>
                  <input type="text" class="pk-hex" data-pk maxlength="7" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="#1f1c17" />
                </label>
              </div>
            </fieldset>
          ))
        }
        <div class="field">
          <span class="label">Votre logo <span class="hint">{TRIAL.open ? '(facultatif, reste sur votre appareil jusqu’à ce que vous lanciez l’essai)' : '(facultatif, reste sur votre appareil)'}</span></span>
          <label class="file" for="c-logo">
            <input id="c-logo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
            <span class="file-btn">Choisir une image</span>
            <span class="file-name" id="file-name">Aucun fichier choisi</span>
          </label>
        </div>
        <div class="field two">
          <div>
            <label for="c-total">Passages pour la récompense : <output id="o-total">10</output></label>
            <input id="c-total" type="range" min="4" max="15" value="10" />
          </div>
          <div>
            <label for="c-filled">Passages du client : <output id="o-filled">7</output></label>
            <input id="c-filled" type="range" min="0" max="10" value="7" />
          </div>
        </div>
        <div class="field">
          <label for="c-reward">Récompense</label>
          <input id="c-reward" type="text" maxlength="40" value="Brushing offert" />
        </div>
        <fieldset class="field">
          <legend>Aperçu</legend>
          <div class="seg" role="radiogroup">
            <input type="radio" name="variant" id="v-apple" value="apple" checked /><label for="v-apple">Apple Wallet</label>
            <input type="radio" name="variant" id="v-google" value="google" /><label for="v-google">Google Wallet</label>
          </div>
        </fieldset>
      </form>

      <div class="preview">
        <div class="stage" aria-live="polite">
          <Phone width={330} screen="#000">
            <div class="wallet-ui" id="wallet-ui">
              <p class="wallet-title" id="wallet-title">Wallet</p>
              <div id="card-slot">
                <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={294} />
              </div>
            </div>
          </Phone>
        </div>
        <!-- téléphone : copie réduite de la carte, fixée sous l'en-tête pendant les réglages (aperçu en direct) -->
        <div class="mini" id="mini" aria-hidden="true">
          <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={290} qr={false} />
        </div>
        <div class="after">
          <p class="caption">{TRIAL.open ? 'Aperçu indicatif : avec l’essai, votre carte est créée tout de suite à partir de ces réglages et du modèle de votre métier.' : 'Aperçu indicatif : la carte définitive est créée par LOYNA à vos couleurs, avec votre logo en haute définition.'}</p>
          <div class="btn-row center">
            {TRIAL.open && <a class="btn btn--gold" href={essaiUrl} id="go-essai">Essayer 1 mois gratuitement <Icon name="arrow-right" size={18} /></a>}
            <a class:list={['btn', TRIAL.open ? 'btn--ghost' : 'btn--gold']} href="/tarifs/?carte=1" id="go-plans">Je veux cette carte {!TRIAL.open && <Icon name="arrow-right" size={18} />}</a>
          </div>
          <form class="send-preview" method="post" action="/contact.php" id="send-preview">
            <p class="sp-title"><Icon name="mail" size={18} /> Pas encore décidé ? Recevez cet aperçu et nos conseils</p>
            <input type="hidden" name="type" value="apercu" />
            <input type="hidden" name="page" value="/creer-ma-carte/" />
            <input type="hidden" name="t" value="" />
            <input type="hidden" name="commerce" value="" />
            <input type="hidden" name="apercu" value="" />
            <div class="hp" aria-hidden="true">
              <label for="sp-site">Ne pas remplir</label>
              <input id="sp-site" name="site_web" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="sp-row">
              <label class="sr-only" for="sp-email">Votre e-mail</label>
              <input id="sp-email" name="email" type="email" required maxlength="120" placeholder="Votre e-mail" autocomplete="email" />
              <label class="sr-only" for="sp-tel">Téléphone (facultatif)</label>
              <input id="sp-tel" name="telephone" type="tel" maxlength="30" pattern="[0-9+ ().-]{8,30}" placeholder="Téléphone" autocomplete="tel" />
              <button type="submit" class="btn btn--primary" data-loading="Envoi…">Recevoir</button>
            </div>
            <p class="sp-legal">Votre demande arrive directement chez nous : nous vous répondons avec votre aperçu. Aucun paiement à cette étape. <a href="/confidentialite/">Confidentialité</a></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Jonction de="creme" vers="sable" forme={4} />

  <section class="section section--alt tete-serree">
    <div class="container grid grid-3">
      <div class="card">
        <span class="icon"><Icon name="palette" /></span>
        <h2 class="h3">À votre image</h2>
        <p>Logo, couleurs, nom du programme et récompense : vous pourrez tout modifier ensuite depuis votre espace, sans code.</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="zap" /></span>
        <h2 class="h3">{TRIAL.open ? 'Prête tout de suite avec l’essai' : <>Prête sous 24&nbsp;h</>}</h2>
        <p>{TRIAL.open && 'Avec l’essai, votre carte et votre QR code d’inscription sont créés dès que vous confirmez votre adresse e-mail. '}Après une commande, nous les créons sous 24&nbsp;h, hors personnalisation exceptionnelle.</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="smartphone" /></span>
        <h2 class="h3">iPhone et Android</h2>
        <p>La même carte fonctionne dans Apple Wallet et Google Wallet. Vos clients n’ont aucune application à installer.</p>
      </div>
    </div>
  </section>

  <Jonction de="sable" vers="creme" forme={6} retourne />

  <section class="section tete-serree">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Exemples</p>
        <h2>Des exemples de cartes de fidélité par métier</h2>
        <p class="lead">Partez d’un modèle prêt à l’emploi : la récompense et les couleurs sont proposées pour votre métier, et vous changez ensuite tout ce que vous voulez.</p>
      </div>
      <ul class="modeles">
        {
          modeles.map((m) => (
            <li>
              <span class="modele-carte" style={`--fond:${m.fond};--tampons:${m.tampons}`} aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span class="modele-texte">
                <a href={`/creer-ma-carte/?activite=${encodeURIComponent(m.nom)}#cfg`}>
                  <strong>Carte de fidélité {m.nom.toLowerCase()}</strong>
                </a>
                <span>Récompense proposée : {m.recompense}</span>
                <a class="modele-guide" href={`/secteurs/${m.page}/`}>Conseils pour ce métier</a>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Jonction de="creme" vers="sable" forme={2} retourne />

  <section class="section section--alt tete-serree">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Mode d’emploi</p>
        <h2>Créer une carte de fidélité en 4 étapes</h2>
      </div>
      <ol class="how">
        <li>
          <strong>Choisissez le nom et l’activité</strong> affichés sur la carte, puis ajoutez votre logo si vous en avez un.
        </li>
        <li>
          <strong>Choisissez vos couleurs</strong> : le fond de la carte et la couleur des tampons, pour retrouver l’identité de votre commerce.
        </li>
        <li>
          <strong>Fixez la récompense et le nombre de passages</strong> : une récompense qui donne envie, un seuil que vos bons clients atteignent en quelques semaines.
        </li>
        <li>
          {TRIAL.open ? (
            <><strong>Lancez l’essai</strong> : 1 mois gratuit, sans carte bancaire. Votre carte et votre QR code d’inscription sont créés dès que vous confirmez votre adresse e-mail.</>
          ) : (
            <><strong>Validez votre carte</strong> : choisissez votre offre, et votre carte et votre QR code d’inscription sont prêts sous 24&nbsp;h.</>
          )}
        </li>
      </ol>
      <p class="how-more">
        Besoin d’aide pour choisir la récompense ou le seuil ? Lisez notre méthode pour <a href="/blog/creer-carte-de-fidelite/">créer une carte de fidélité</a> et nos <a href="/blog/idees-recompenses-carte-fidelite/">30 idées de récompenses par métier</a>.
      </p>
      <div class="faq cfg-faq">
        {
          cfgFaq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import {marquerCouleurs} from '../lib/carte-live';
  import {CARD_ACTIVITES} from '../data/site';
  import {logoToFiles} from '../app/logo-png';
  import {CLE_LOGO, lireLogoGarde, store, urlLogo} from '../lib/compte-regles';

  type Touche = {reward: boolean; bg: boolean; accent: boolean};
  type Cfg = {name: string; activity: string; bg: string; accent: string; total: number; filled: number; reward: string; variant: 'apple' | 'google'; touche?: Touche};
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const cartes = [...document.querySelectorAll<HTMLElement>('#card-slot .wcard, #mini .wcard')];
  const KEY = 'loyna-config';
  let logoUrl = '';

  // Récompense et couleurs suivent l'activité choisie, sauf celles que le visiteur a modifiées lui-même
  // (ces marques sont gardées avec le brouillon, pour être respectées à la visite suivante).
  const touche: Touche = {reward: false, bg: false, accent: false};
  const simplifier = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toLowerCase();
  const defautsActivite = (nom: string) => CARD_ACTIVITES.find((a) => simplifier(a.nom) === simplifier(nom));
  function appliquerActivite(nom: string) {
    const d = defautsActivite(nom);
    if (!d) return;
    if (!touche.reward) $<HTMLInputElement>('#c-reward').value = d.recompense;
    if (!touche.bg) $<HTMLInputElement>('#c-bg').value = d.fond;
    if (!touche.accent) $<HTMLInputElement>('#c-accent').value = d.tampons;
    marquerCouleurs(document);
  }

  // Activité « Autre » : champ libre affiché sous la liste, son texte va sur la carte (demande d'Ewan du 2026-10-27)
  const AUTRE = 'Autre';
  const autreInput = () => $<HTMLInputElement>('#c-activity-other');
  const activite = () => {
    const v = $<HTMLSelectElement>('#c-activity').value;
    return v === AUTRE ? autreInput().value.trim() || 'Votre activité' : v;
  };
  const montrerAutre = (focus = false) => {
    const autre = $<HTMLSelectElement>('#c-activity').value === AUTRE;
    autreInput().hidden = !autre;
    if (autre && focus) autreInput().focus();
  };
  /** Activité qui n'est pas dans la liste (brouillon, lien) : « Autre » + son texte dans le champ libre. */
  const choisirActivite = (texte: string) => {
    const act = $<HTMLSelectElement>('#c-activity');
    const option = [...act.options].find((o) => simplifier(o.value) === simplifier(texte));
    if (option) act.value = option.value;
    else {
      act.value = AUTRE;
      autreInput().value = texte.slice(0, 30);
    }
    montrerAutre();
  };

  const read = (): Cfg => ({
    name: $<HTMLInputElement>('#c-name').value.trim() || 'Votre commerce',
    activity: activite(),
    bg: $<HTMLInputElement>('#c-bg').value,
    accent: $<HTMLInputElement>('#c-accent').value,
    total: Number($<HTMLInputElement>('#c-total').value),
    filled: Number($<HTMLInputElement>('#c-filled').value),
    reward: $<HTMLInputElement>('#c-reward').value.trim() || 'Récompense offerte',
    variant: ($<HTMLInputElement>('#v-google').checked ? 'google' : 'apple') as Cfg['variant'],
  });

  const luminance = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
  };

  function render() {
    const c = read();
    const filledInput = $<HTMLInputElement>('#c-filled');
    filledInput.max = String(c.total);
    if (c.filled > c.total) {
      c.filled = c.total;
      filledInput.value = String(c.total);
    }
    $<HTMLOutputElement>('#o-total').value = String(c.total);
    $<HTMLOutputElement>('#o-filled').value = String(c.filled);
    cartes.forEach((card) => peindre(card, c));
    $('#wallet-title').textContent = c.variant === 'apple' ? 'Wallet' : 'Google Wallet';
    rafraichirReglages();
    try {
      localStorage.setItem(KEY, JSON.stringify({...c, touche}));
    } catch {
      /* stockage indisponible : sans conséquence */
    }
    // Formulaire « Recevoir cet aperçu » : le commerce et l'aperçu suivent la carte affichée.
    const sp = $<HTMLFormElement>('#send-preview');
    (sp.elements.namedItem('commerce') as HTMLInputElement).value = c.name;
    (sp.elements.namedItem('apercu') as HTMLInputElement).value =
      `${c.name} (${c.activity}) · fond ${c.bg} · tampons ${c.accent} · ${c.total} passages · récompense : ${c.reward} · style ${c.variant === 'google' ? 'Google Wallet' : 'Apple Wallet'}`;
  }

  /** Met une carte (la grande, ou la copie réduite du téléphone) aux réglages du visiteur. */
  function peindre(card: HTMLElement, c: Cfg) {
    const fg = luminance(c.bg) > 0.45 ? '#16130e' : '#f8f4ec';
    card.style.setProperty('--bg', c.bg);
    card.style.setProperty('--accent', c.accent);
    card.style.setProperty('--fg', fg);
    card.classList.toggle('wcard--google', c.variant === 'google');
    card.classList.toggle('wcard--apple', c.variant === 'apple');
    card.querySelector('.wc-name strong')!.textContent = c.name;
    card.querySelector('.wc-name small')!.textContent = c.activity;
    const logo = card.querySelector<HTMLElement>('.wc-logo')!;
    if (logoUrl) {
      logo.innerHTML = `<img src="${logoUrl}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`;
    } else {
      logo.textContent = c.name
        .split(/\s+/)
        .filter((w) => /^[A-Za-zÀ-ÿ]/.test(w) && !/^(de|du|des|la|le|les|et|d'|l'|chez|au|aux)$/i.test(w))
        .slice(0, 2)
        .map((w) => w[0].toUpperCase())
        .join('');
    }
    const count = card.querySelector<HTMLElement>('.wc-count');
    if (count) {
      count.style.display = c.variant === 'apple' ? '' : 'none';
      count.querySelector('b')!.innerHTML = `${c.filled}<i>/${c.total}</i>`;
    }
    let gt = card.querySelector<HTMLElement>('.wc-gtitle');
    if (!gt) {
      gt = document.createElement('p');
      gt.className = 'wc-gtitle';
      card.querySelector('.wc-head')!.after(gt);
    }
    gt.textContent = `${c.filled} / ${c.total} passages`;
    gt.style.display = c.variant === 'google' ? '' : 'none';
    const stamps = card.querySelector<HTMLElement>('.wc-stamps')!;
    stamps.style.setProperty('--n', String(c.total));
    stamps.innerHTML = Array.from({length: c.total}, (_, i) => `<span class="${i < c.filled ? 'on' : ''}"></span>`).join('');
    card.querySelector('.wc-reward span')!.textContent = c.reward;
  }

  // Réglage libre d'une couleur, dans la page : teinte, intensité et clarté (curseurs, qui mettent la carte à jour
  // pendant qu'on les fait glisser sur tous les téléphones) et code couleur (#rrggbb) pour la couleur exacte du commerce.
  const hexVersHsl = (hex: string): [number, number, number] => {
    const n = parseInt(hex.slice(1), 16);
    const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => v / 255);
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const d = max - min;
    const l = (max + min) / 2;
    const s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
    let h = 0;
    if (d) h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
    return [Math.round((h * 60 + 360) % 360), Math.round(s * 100), Math.round(l * 100)];
  };
  const hslVersHex = (h: number, s: number, l: number) => {
    const a = (s / 100) * Math.min(l / 100, 1 - l / 100);
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      const v = l / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
      return Math.round(v * 255)
        .toString(16)
        .padStart(2, '0');
    };
    return `#${f(0)}${f(8)}${f(4)}`;
  };
  const lireHex = (v: string) => {
    let h = v.trim().replace(/^#/, '').toLowerCase();
    if (/^[0-9a-f]{3}$/.test(h)) h = [...h].map((x) => x + x).join('');
    return /^[0-9a-f]{6}$/.test(h) ? `#${h}` : '';
  };
  const reglages = [...document.querySelectorAll<HTMLElement>('.picker')];
  const valeurDe = (pk: HTMLElement) => $<HTMLInputElement>(`#c-${pk.dataset.target}`);
  /** Curseurs et code d'un réglage d'après la couleur choisie (rond prédéfini, activité, brouillon) ; une couleur
   *  venue des curseurs eux-mêmes est laissée telle quelle, pour qu'ils ne sautent pas pendant qu'on les déplace. */
  function rafraichirReglages() {
    reglages.forEach((pk) => {
      const v = valeurDe(pk).value.toLowerCase();
      if (pk.dataset.hex === v) return;
      const [h, s, l] = hexVersHsl(v);
      pk.querySelector<HTMLInputElement>('.pk-h')!.value = String(h);
      pk.querySelector<HTMLInputElement>('.pk-s')!.value = String(s);
      pk.querySelector<HTMLInputElement>('.pk-l')!.value = String(l);
      if (document.activeElement !== pk.querySelector('.pk-hex')) pk.querySelector<HTMLInputElement>('.pk-hex')!.value = v;
      teinter(pk, h, s, l);
      pk.dataset.hex = v;
    });
  }
  /** Fonds des curseurs : ce que donnerait chaque position avec les deux autres réglages. */
  function teinter(pk: HTMLElement, h: number, s: number, l: number) {
    pk.style.setProperty('--h', String(h));
    pk.style.setProperty('--s', `${s}%`);
    pk.style.setProperty('--l', `${l}%`);
  }
  reglages.forEach((pk) => {
    const cible = pk.dataset.target as 'bg' | 'accent';
    const groupe = document.querySelector<HTMLElement>(`.swatches[data-target="${cible}"]`)!;
    const bouton = groupe.querySelector<HTMLButtonElement>('.sw.custom')!;
    const [h, s, l] = ['.pk-h', '.pk-s', '.pk-l'].map((q) => pk.querySelector<HTMLInputElement>(q)!);
    const code = pk.querySelector<HTMLInputElement>('.pk-hex')!;
    const choisir = (v: string) => {
      valeurDe(pk).value = v;
      touche[cible] = true;
      marquerCouleurs(groupe);
      render();
    };
    bouton.addEventListener('click', () => {
      const ouvrir = pk.hidden;
      // un seul réglage ouvert à la fois : le formulaire reste court et la carte proche
      document.querySelectorAll<HTMLButtonElement>('.sw.custom[aria-expanded="true"]').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = true;
      });
      pk.hidden = !ouvrir;
      bouton.setAttribute('aria-expanded', String(ouvrir));
    });
    [h, s, l].forEach((curseur) =>
      curseur.addEventListener('input', () => {
        const [vh, vs, vl] = [h, s, l].map((x) => Number(x.value));
        const v = hslVersHex(vh, vs, vl);
        pk.dataset.hex = v;
        code.value = v;
        teinter(pk, vh, vs, vl);
        choisir(v);
      }),
    );
    code.addEventListener('input', () => {
      const v = lireHex(code.value);
      if (v) choisir(v);
    });
    code.addEventListener('blur', () => {
      code.value = valeurDe(pk).value;
    });
  });

  // Couleurs : ronds prédéfinis (le rond arc-en-ciel ouvre le réglage libre, couleur choisie affichée au centre)
  document.querySelectorAll<HTMLElement>('.swatches').forEach((group) => {
    const input = group.querySelector<HTMLInputElement>('input[type=color]')!;
    const cible = group.dataset.target as 'bg' | 'accent';
    group.querySelectorAll<HTMLButtonElement>('.sw[data-color]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.color!;
        touche[cible] = true;
        marquerCouleurs(group);
        render();
      }),
    );
  });

  // Téléphone : la grande carte est en haut de la page et les réglages en dessous. Dès que la grande carte passe
  // sous l'en-tête, une copie réduite s'affiche juste en dessous de lui, tant que les réglages sont à l'écran.
  const mini = $('#mini');
  const grande = $('#card-slot');
  const enTete = document.querySelector<HTMLElement>('.site-header');
  let attente = 0;
  function placerMini() {
    attente = 0;
    const haut = enTete ? Math.max(0, enTete.getBoundingClientRect().bottom) : 0;
    const panneau = $('#cfg').getBoundingClientRect();
    const visible = mini.offsetHeight > 0 && grande.getBoundingClientRect().bottom < haut + 20 && panneau.bottom > haut + mini.offsetHeight + 80;
    mini.style.top = `${haut}px`;
    mini.classList.toggle('on', visible);
    // les champs touchés restent visibles sous la copie réduite (clavier ouvert, retour sur un champ)
    document.documentElement.style.scrollPaddingTop = visible ? `${haut + mini.offsetHeight + 12}px` : '';
  }
  const surDefilement = () => {
    if (!attente) attente = requestAnimationFrame(placerMini);
  };
  window.addEventListener('scroll', surDefilement, {passive: true});
  window.addEventListener('resize', surDefilement);
  $<HTMLInputElement>('#c-reward').addEventListener('input', () => {
    touche.reward = true;
  });
  // Changement d'activité : la récompense et les couleurs de l'activité, sauf ce que le visiteur a modifié
  $<HTMLSelectElement>('#c-activity').addEventListener('input', () => {
    appliquerActivite($<HTMLSelectElement>('#c-activity').value);
    montrerAutre(true);
    render();
  });

  // Logo : converti ici, gardé dans cet onglet pour l'essai (sessionStorage) et montré sur la carte. Rien ne part avant l'essai.
  $<HTMLInputElement>('#c-logo').addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    logoUrl = '';
    store('session', CLE_LOGO, null);
    if (!f) {
      $('#file-name').textContent = 'Aucun fichier choisi';
      render();
      return;
    }
    $('#file-name').textContent = 'Préparation du logo…';
    try {
      const {logo_png, icon_png} = await logoToFiles(f);
      store('session', CLE_LOGO, JSON.stringify({logo_png, icon_png, nom: f.name}));
      logoUrl = urlLogo({logo_png}) ?? '';
      $('#file-name').textContent = f.name;
    } catch (err) {
      $('#file-name').textContent = err instanceof Error ? err.message : 'Cette image est illisible.';
    }
    render();
  });
  // Logo déjà choisi dans cet onglet : retrouvé en revenant sur la page
  const logoGarde = lireLogoGarde();
  if (logoGarde) {
    logoUrl = urlLogo(logoGarde) ?? '';
    $('#file-name').textContent = logoGarde.nom || 'Logo choisi';
  }
  document.querySelectorAll('#cfg input:not([type=file]):not([type=color]):not([data-pk])').forEach((el) => el.addEventListener('input', render));

  ($<HTMLFormElement>('#send-preview').elements.namedItem('t') as HTMLInputElement).value = String(Date.now());
  $<HTMLFormElement>('#send-preview').addEventListener('submit', (e) => {
    if ((e.target as HTMLFormElement).checkValidity())
      (window as unknown as {loynaTrack?: (n: string, p?: object) => void}).loynaTrack?.('generate_lead', {form: 'apercu'});
  });

  // Reprise d'un brouillon enregistré
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null') as Cfg | null;
    if (saved) {
      $<HTMLInputElement>('#c-name').value = saved.name;
      if (saved.activity && saved.activity !== 'Votre activité') choisirActivite(saved.activity);
      $<HTMLInputElement>('#c-bg').value = saved.bg;
      $<HTMLInputElement>('#c-accent').value = saved.accent;
      $<HTMLInputElement>('#c-total').value = String(saved.total);
      $<HTMLInputElement>('#c-filled').value = String(saved.filled);
      $<HTMLInputElement>('#c-reward').value = saved.reward;
      $<HTMLInputElement>(saved.variant === 'google' ? '#v-google' : '#v-apple').checked = true;
      if (saved.touche) Object.assign(touche, saved.touche);
    }
  } catch {
    /* rien */
  }

  // Réglages passés dans le lien, prioritaires sur le brouillon enregistré :
  // ?nom=…&activite=Boulangerie&recompense=Viennoiserie%20offerte&fond=5b3a21&tampons=d9b27a
  // (nom : celui tapé dans le haut de la page d'accueil, ou un lien envoyé à un commerçant)
  const lien = new URLSearchParams(location.search);
  const hexa = (v: string | null) => {
    const h = (v || '').trim().replace(/^#/, '').toLowerCase();
    return /^[0-9a-f]{6}$/.test(h) ? `#${h}` : ''; // couleur invalide : ignorée
  };
  const nomLien = (lien.get('nom') || '').trim();
  const activiteLien = (lien.get('activite') || '').trim().slice(0, 40);
  const recompenseLien = (lien.get('recompense') || '').trim().slice(0, 40);
  const fondLien = hexa(lien.get('fond'));
  const tamponsLien = hexa(lien.get('tampons'));
  if (nomLien) $<HTMLInputElement>('#c-name').value = nomLien.slice(0, 40);
  if (activiteLien) {
    const act = $<HTMLSelectElement>('#c-activity');
    choisirActivite(activiteLien);
    // l'activité du lien apporte sa récompense et ses couleurs, sauf celles que le lien précise lui-même
    const d = defautsActivite(act.value);
    if (d) {
      if (!recompenseLien) $<HTMLInputElement>('#c-reward').value = d.recompense;
      if (!fondLien) $<HTMLInputElement>('#c-bg').value = d.fond;
      if (!tamponsLien) $<HTMLInputElement>('#c-accent').value = d.tampons;
      Object.assign(touche, {reward: false, bg: false, accent: false});
    }
  }
  if (recompenseLien) {
    $<HTMLInputElement>('#c-reward').value = recompenseLien;
    touche.reward = false;
  }
  if (fondLien) {
    $<HTMLInputElement>('#c-bg').value = fondLien;
    touche.bg = false;
  }
  if (tamponsLien) {
    $<HTMLInputElement>('#c-accent').value = tamponsLien;
    touche.accent = false;
  }
  marquerCouleurs(document);
  render();
  placerMini();
</script>

<style>
