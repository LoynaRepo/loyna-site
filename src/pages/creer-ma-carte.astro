---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Phone from '../components/Phone.astro';
import WalletCard from '../components/WalletCard.astro';
import Icon from '../components/Icon.astro';
import {CARD_ACCENTS, CARD_ACTIVITES, CARD_BGS, SITE} from '../data/site';

const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Créer ma carte', url: '/creer-ma-carte/'},
];
const bgs = CARD_BGS;
const accents = CARD_ACCENTS;
const activities = CARD_ACTIVITES.map((a) => a.nom);
// Questions fréquentes de la page (affichées et décrites en données structurées FAQPage)
const cfgFaq = [
  {q: 'Créer l’aperçu de ma carte de fidélité est-il gratuit ?', a: 'Oui. Le configurateur est gratuit et sans inscription : vous voyez votre carte à votre nom, à vos couleurs et avec votre récompense. Vous ne payez que si vous décidez de lancer votre carte.'},
  {q: 'Combien de temps faut-il pour que ma carte soit prête ?', a: 'Après votre commande, LOYNA crée votre carte et votre QR code d’inscription sous 24 h, hors personnalisation exceptionnelle.'},
  {q: 'Mes clients doivent-ils télécharger une application ?', a: 'Non. La carte s’ajoute à Apple Wallet sur iPhone et à Google Wallet sur Android, déjà présents sur leur téléphone.'},
  {q: 'Pourrai-je modifier ma carte plus tard ?', a: 'Oui. Couleurs, logo, nom du programme, récompense et seuil se modifient depuis votre espace client, et les cartes déjà installées chez vos clients se mettent à jour toutes seules.'},
];
const appLd = {
  '@type': 'WebApplication',
  name: 'Configurateur de carte de fidélité LOYNA',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  url: `${SITE.url}/creer-ma-carte/`,
  offers: {'@type': 'Offer', price: 0, priceCurrency: 'EUR'},
};
---

<Base stickyCta={{primary: {href: '/tarifs/', label: 'Je veux cette carte'}, secondary: {href: '/demo/', label: 'Démo'}}}
  title="Créer une carte de fidélité en ligne : aperçu gratuit"
  description="Créez l'aperçu de votre carte de fidélité Apple Wallet et Google Wallet : nom, couleurs, logo, nombre de passages et récompense. Résultat en direct, gratuit."
  ogImage="/og/creer-ma-carte.png"
  breadcrumbs={crumbs}
  jsonLd={[appLd, {'@type': 'FAQPage', mainEntity: cfgFaq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}}))}]}
>
  <section class="page-hero compact">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Configurateur</p>
      <h1>Créez l’aperçu de votre carte de fidélité</h1>
      <p class="lead">Choisissez votre nom, vos couleurs, votre logo et votre récompense : votre carte se met à jour en direct, telle que vos clients la verront dans leur Wallet.</p>
    </div>
  </section>

  <section class="section pt0">
    <div class="container configurator">
      <form class="panel" id="cfg" aria-label="Personnalisation de la carte" onsubmit="return false">
        <div class="field">
          <label for="c-name">Nom de votre commerce</label>
          <input id="c-name" name="name" type="text" maxlength="32" value="Maison Lumière" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="c-activity">Activité</label>
          <select id="c-activity" name="activity">
            {activities.map((a) => <option selected={a === 'Coiffure'}>{a}</option>)}
          </select>
          <input id="c-activity-other" class="act-other" type="text" maxlength="30" placeholder="Votre activité : fromagerie, tatoueur…" aria-label="Votre activité" hidden />
        </div>
        <fieldset class="field">
          <legend>Couleur de la carte</legend>
          <div class="swatches" data-target="bg">
            {bgs.map((c, i) => <button type="button" class="sw" style={`--c:${c.c}`} data-color={c.c} aria-label={c.nom} title={c.nom} aria-pressed={i === 0 ? 'true' : 'false'} />)}
            <label class="sw custom" title="Couleur personnalisée"><input type="color" id="c-bg" value="#1f1c17" aria-label="Couleur de carte personnalisée" /></label>
          </div>
        </fieldset>
        <fieldset class="field">
          <legend>Couleur des tampons</legend>
          <div class="swatches" data-target="accent">
            {accents.map((c, i) => <button type="button" class="sw" style={`--c:${c.c}`} data-color={c.c} aria-label={c.nom} title={c.nom} aria-pressed={i === 0 ? 'true' : 'false'} />)}
            <label class="sw custom" title="Couleur personnalisée"><input type="color" id="c-accent" value="#d9b27a" aria-label="Couleur des tampons personnalisée" /></label>
          </div>
        </fieldset>
        <div class="field">
          <span class="label">Votre logo <span class="hint">(facultatif, reste sur votre appareil)</span></span>
          <label class="file" for="c-logo">
            <input id="c-logo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
            <span class="file-btn">Choisir une image</span>
            <span class="file-name" id="file-name">Aucun fichier choisi</span>
          </label>
        </div>
        <div class="field two">
          <div>
            <label for="c-total">Passages pour la récompense : <output id="o-total">10</output></label>
            <input id="c-total" type="range" min="4" max="15" value="10" />
          </div>
          <div>
            <label for="c-filled">Passages du client : <output id="o-filled">7</output></label>
            <input id="c-filled" type="range" min="0" max="10" value="7" />
          </div>
        </div>
        <div class="field">
          <label for="c-reward">Récompense</label>
          <input id="c-reward" type="text" maxlength="40" value="Brushing offert" />
        </div>
        <fieldset class="field">
          <legend>Aperçu</legend>
          <div class="seg" role="radiogroup">
            <input type="radio" name="variant" id="v-apple" value="apple" checked /><label for="v-apple">Apple Wallet</label>
            <input type="radio" name="variant" id="v-google" value="google" /><label for="v-google">Google Wallet</label>
          </div>
        </fieldset>
      </form>

      <div class="preview" aria-live="polite">
        <Phone width={330} screen="#000">
          <div class="wallet-ui" id="wallet-ui">
            <p class="wallet-title" id="wallet-title">Wallet</p>
            <div id="card-slot">
              <WalletCard name="Maison Lumière" activity="Coiffure" filled={7} total={10} reward="Brushing offert" width={294} />
            </div>
          </div>
        </Phone>
        <p class="caption">Aperçu indicatif : la carte définitive est créée par LOYNA à vos couleurs, avec votre logo en haute définition.</p>
        <div class="btn-row center">
          <a class="btn btn--gold" href="/tarifs/?carte=1" id="go-plans">Je veux cette carte <Icon name="arrow-right" size={18} /></a>
        </div>
        <form class="send-preview" method="post" action="/contact.php" id="send-preview">
          <p class="sp-title"><Icon name="mail" size={18} /> Pas encore décidé ? Recevez cet aperçu et nos conseils</p>
          <input type="hidden" name="type" value="apercu" />
          <input type="hidden" name="page" value="/creer-ma-carte/" />
          <input type="hidden" name="t" value="" />
          <input type="hidden" name="commerce" value="" />
          <input type="hidden" name="apercu" value="" />
          <div class="hp" aria-hidden="true">
            <label for="sp-site">Ne pas remplir</label>
            <input id="sp-site" name="site_web" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="sp-row">
            <label class="sr-only" for="sp-email">Votre e-mail</label>
            <input id="sp-email" name="email" type="email" required maxlength="120" placeholder="Votre e-mail" autocomplete="email" />
            <label class="sr-only" for="sp-tel">Téléphone (facultatif)</label>
            <input id="sp-tel" name="telephone" type="tel" maxlength="30" pattern="[0-9+ ().-]{8,30}" placeholder="Téléphone" autocomplete="tel" />
            <button type="submit" class="btn btn--primary" data-loading="Envoi…">Recevoir</button>
          </div>
          <p class="sp-legal">Votre demande arrive directement chez nous : nous vous répondons avec votre aperçu. Aucun paiement à cette étape. <a href="/confidentialite/">Confidentialité</a></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid-3">
      <div class="card">
        <span class="icon"><Icon name="palette" /></span>
        <h2 class="h3">À votre image</h2>
        <p>Logo, couleurs, nom du programme et récompense : vous pourrez tout modifier ensuite depuis votre espace, sans code.</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="zap" /></span>
        <h2 class="h3">Prête sous 24&nbsp;h</h2>
        <p>Après votre commande, nous créons votre carte et votre QR code d’inscription sous 24&nbsp;h, hors personnalisation exceptionnelle.</p>
      </div>
      <div class="card">
        <span class="icon"><Icon name="smartphone" /></span>
        <h2 class="h3">iPhone et Android</h2>
        <p>La même carte fonctionne dans Apple Wallet et Google Wallet. Vos clients n’ont aucune application à installer.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Mode d’emploi</p>
        <h2>Créer une carte de fidélité en 4 étapes</h2>
      </div>
      <ol class="how">
        <li>
          <strong>Choisissez le nom et l’activité</strong> affichés sur la carte, puis ajoutez votre logo si vous en avez un.
        </li>
        <li>
          <strong>Choisissez vos couleurs</strong> : le fond de la carte et la couleur des tampons, pour retrouver l’identité de votre commerce.
        </li>
        <li>
          <strong>Fixez la récompense et le nombre de passages</strong> : une récompense qui donne envie, un seuil que vos bons clients atteignent en quelques semaines.
        </li>
        <li>
          <strong>Validez votre carte</strong> : choisissez votre formule, et votre carte et votre QR code d’inscription sont prêts sous 24&nbsp;h.
        </li>
      </ol>
      <p class="how-more">
        Besoin d’aide pour choisir la récompense ou le seuil ? Lisez notre méthode pour <a href="/blog/creer-carte-de-fidelite/">créer une carte de fidélité</a> et nos <a href="/blog/idees-recompenses-carte-fidelite/">30 idées de récompenses par métier</a>.
      </p>
      <div class="faq cfg-faq">
        {
          cfgFaq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import {marquerCouleurs} from '../lib/carte-live';
  import {CARD_ACTIVITES} from '../data/site';

  type Touche = {reward: boolean; bg: boolean; accent: boolean};
  type Cfg = {name: string; activity: string; bg: string; accent: string; total: number; filled: number; reward: string; variant: 'apple' | 'google'; touche?: Touche};
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const card = document.querySelector<HTMLElement>('#card-slot .wcard')!;
  const KEY = 'loyna-config';
  let logoUrl = '';

  // Récompense et couleurs suivent l'activité choisie, sauf celles que le visiteur a modifiées lui-même
  // (ces marques sont gardées avec le brouillon, pour être respectées à la visite suivante).
  const touche: Touche = {reward: false, bg: false, accent: false};
  const simplifier = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').trim().toLowerCase();
  const defautsActivite = (nom: string) => CARD_ACTIVITES.find((a) => simplifier(a.nom) === simplifier(nom));
  function appliquerActivite(nom: string) {
    const d = defautsActivite(nom);
    if (!d) return;
    if (!touche.reward) $<HTMLInputElement>('#c-reward').value = d.recompense;
    if (!touche.bg) $<HTMLInputElement>('#c-bg').value = d.fond;
    if (!touche.accent) $<HTMLInputElement>('#c-accent').value = d.tampons;
    marquerCouleurs(document);
  }

  // Activité « Autre » : champ libre affiché sous la liste, son texte va sur la carte (demande d'Ewan du 2026-10-27)
  const AUTRE = 'Autre';
  const autreInput = () => $<HTMLInputElement>('#c-activity-other');
  const activite = () => {
    const v = $<HTMLSelectElement>('#c-activity').value;
    return v === AUTRE ? autreInput().value.trim() || 'Votre activité' : v;
  };
  const montrerAutre = (focus = false) => {
    const autre = $<HTMLSelectElement>('#c-activity').value === AUTRE;
    autreInput().hidden = !autre;
    if (autre && focus) autreInput().focus();
  };
  /** Activité qui n'est pas dans la liste (brouillon, lien) : « Autre » + son texte dans le champ libre. */
  const choisirActivite = (texte: string) => {
    const act = $<HTMLSelectElement>('#c-activity');
    const option = [...act.options].find((o) => simplifier(o.value) === simplifier(texte));
    if (option) act.value = option.value;
    else {
      act.value = AUTRE;
      autreInput().value = texte.slice(0, 30);
    }
    montrerAutre();
  };

  const read = (): Cfg => ({
    name: $<HTMLInputElement>('#c-name').value.trim() || 'Votre commerce',
    activity: activite(),
    bg: $<HTMLInputElement>('#c-bg').value,
    accent: $<HTMLInputElement>('#c-accent').value,
    total: Number($<HTMLInputElement>('#c-total').value),
    filled: Number($<HTMLInputElement>('#c-filled').value),
    reward: $<HTMLInputElement>('#c-reward').value.trim() || 'Récompense offerte',
    variant: ($<HTMLInputElement>('#v-google').checked ? 'google' : 'apple') as Cfg['variant'],
  });

  const luminance = (hex: string) => {
    const n = parseInt(hex.slice(1), 16);
    const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
      const s = v / 255;
      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
  };

  function render() {
    const c = read();
    const filledInput = $<HTMLInputElement>('#c-filled');
    filledInput.max = String(c.total);
    if (c.filled > c.total) {
      c.filled = c.total;
      filledInput.value = String(c.total);
    }
    $<HTMLOutputElement>('#o-total').value = String(c.total);
    $<HTMLOutputElement>('#o-filled').value = String(c.filled);
    const fg = luminance(c.bg) > 0.45 ? '#16130e' : '#f8f4ec';
    card.style.setProperty('--bg', c.bg);
    card.style.setProperty('--accent', c.accent);
    card.style.setProperty('--fg', fg);
    card.classList.toggle('wcard--google', c.variant === 'google');
    card.classList.toggle('wcard--apple', c.variant === 'apple');
    card.querySelector('.wc-name strong')!.textContent = c.name;
    card.querySelector('.wc-name small')!.textContent = c.activity;
    const logo = card.querySelector<HTMLElement>('.wc-logo')!;
    if (logoUrl) {
      logo.innerHTML = `<img src="${logoUrl}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`;
    } else {
      logo.textContent = c.name
        .split(/\s+/)
        .filter((w) => /^[A-Za-zÀ-ÿ]/.test(w) && !/^(de|du|des|la|le|les|et|d'|l'|chez|au|aux)$/i.test(w))
        .slice(0, 2)
        .map((w) => w[0].toUpperCase())
        .join('');
    }
    const count = card.querySelector<HTMLElement>('.wc-count');
    if (count) {
      count.style.display = c.variant === 'apple' ? '' : 'none';
      count.querySelector('b')!.innerHTML = `${c.filled}<i>/${c.total}</i>`;
    }
    let gt = card.querySelector<HTMLElement>('.wc-gtitle');
    if (!gt) {
      gt = document.createElement('p');
      gt.className = 'wc-gtitle';
      card.querySelector('.wc-head')!.after(gt);
    }
    gt.textContent = `${c.filled} / ${c.total} passages`;
    gt.style.display = c.variant === 'google' ? '' : 'none';
    const stamps = card.querySelector<HTMLElement>('.wc-stamps')!;
    stamps.style.setProperty('--n', String(c.total));
    stamps.innerHTML = Array.from({length: c.total}, (_, i) => `<span class="${i < c.filled ? 'on' : ''}"></span>`).join('');
    card.querySelector('.wc-reward span')!.textContent = c.reward;
    $('#wallet-title').textContent = c.variant === 'apple' ? 'Wallet' : 'Google Wallet';
    try {
      localStorage.setItem(KEY, JSON.stringify({...c, touche}));
    } catch {
      /* stockage indisponible : sans conséquence */
    }
    // Formulaire « Recevoir cet aperçu » : le commerce et l'aperçu suivent la carte affichée.
    const sp = $<HTMLFormElement>('#send-preview');
    (sp.elements.namedItem('commerce') as HTMLInputElement).value = c.name;
    (sp.elements.namedItem('apercu') as HTMLInputElement).value =
      `${c.name} (${c.activity}) · fond ${c.bg} · tampons ${c.accent} · ${c.total} passages · récompense : ${c.reward} · style ${c.variant === 'google' ? 'Google Wallet' : 'Apple Wallet'}`;
  }

  // Couleurs : pastilles et sélecteur libre (roue des couleurs, couleur choisie affichée au centre)
  document.querySelectorAll<HTMLElement>('.swatches').forEach((group) => {
    const input = group.querySelector<HTMLInputElement>('input[type=color]')!;
    const cible = group.dataset.target as 'bg' | 'accent';
    group.querySelectorAll<HTMLButtonElement>('.sw[data-color]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.color!;
        touche[cible] = true;
        marquerCouleurs(group);
        render();
      }),
    );
    input.addEventListener('input', () => {
      touche[cible] = true;
      marquerCouleurs(group);
      render();
    });
  });
  $<HTMLInputElement>('#c-reward').addEventListener('input', () => {
    touche.reward = true;
  });
  // Changement d'activité : la récompense et les couleurs de l'activité, sauf ce que le visiteur a modifié
  $<HTMLSelectElement>('#c-activity').addEventListener('input', () => {
    appliquerActivite($<HTMLSelectElement>('#c-activity').value);
    montrerAutre(true);
    render();
  });

  $<HTMLInputElement>('#c-logo').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (logoUrl) URL.revokeObjectURL(logoUrl);
    logoUrl = f ? URL.createObjectURL(f) : '';
    $('#file-name').textContent = f ? f.name : 'Aucun fichier choisi';
    render();
  });
  document.querySelectorAll('#cfg input:not([type=file]):not([type=color])').forEach((el) => el.addEventListener('input', render));

  ($<HTMLFormElement>('#send-preview').elements.namedItem('t') as HTMLInputElement).value = String(Date.now());
  $<HTMLFormElement>('#send-preview').addEventListener('submit', (e) => {
    if ((e.target as HTMLFormElement).checkValidity())
      (window as unknown as {loynaTrack?: (n: string, p?: object) => void}).loynaTrack?.('generate_lead', {form: 'apercu'});
  });

  // Reprise d'un brouillon enregistré
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || 'null') as Cfg | null;
    if (saved) {
      $<HTMLInputElement>('#c-name').value = saved.name;
      if (saved.activity && saved.activity !== 'Votre activité') choisirActivite(saved.activity);
      $<HTMLInputElement>('#c-bg').value = saved.bg;
      $<HTMLInputElement>('#c-accent').value = saved.accent;
      $<HTMLInputElement>('#c-total').value = String(saved.total);
      $<HTMLInputElement>('#c-filled').value = String(saved.filled);
      $<HTMLInputElement>('#c-reward').value = saved.reward;
      $<HTMLInputElement>(saved.variant === 'google' ? '#v-google' : '#v-apple').checked = true;
      if (saved.touche) Object.assign(touche, saved.touche);
    }
  } catch {
    /* rien */
  }

  // Réglages passés dans le lien, prioritaires sur le brouillon enregistré :
  // ?nom=…&activite=Boulangerie&recompense=Viennoiserie%20offerte&fond=5b3a21&tampons=d9b27a
  // (nom : celui tapé dans le haut de la page d'accueil, ou un lien envoyé à un commerçant)
  const lien = new URLSearchParams(location.search);
  const hexa = (v: string | null) => {
    const h = (v || '').trim().replace(/^#/, '').toLowerCase();
    return /^[0-9a-f]{6}$/.test(h) ? `#${h}` : ''; // couleur invalide : ignorée
  };
  const nomLien = (lien.get('nom') || '').trim();
  const activiteLien = (lien.get('activite') || '').trim().slice(0, 40);
  const recompenseLien = (lien.get('recompense') || '').trim().slice(0, 40);
  const fondLien = hexa(lien.get('fond'));
  const tamponsLien = hexa(lien.get('tampons'));
  if (nomLien) $<HTMLInputElement>('#c-name').value = nomLien.slice(0, 40);
  if (activiteLien) {
    const act = $<HTMLSelectElement>('#c-activity');
    choisirActivite(activiteLien);
    // l'activité du lien apporte sa récompense et ses couleurs, sauf celles que le lien précise lui-même
    const d = defautsActivite(act.value);
    if (d) {
      if (!recompenseLien) $<HTMLInputElement>('#c-reward').value = d.recompense;
      if (!fondLien) $<HTMLInputElement>('#c-bg').value = d.fond;
      if (!tamponsLien) $<HTMLInputElement>('#c-accent').value = d.tampons;
      Object.assign(touche, {reward: false, bg: false, accent: false});
    }
  }
  if (recompenseLien) {
    $<HTMLInputElement>('#c-reward').value = recompenseLien;
    touche.reward = false;
  }
  if (fondLien) {
    $<HTMLInputElement>('#c-bg').value = fondLien;
    touche.bg = false;
  }
  if (tamponsLien) {
    $<HTMLInputElement>('#c-accent').value = tamponsLien;
    touche.accent = false;
  }
  marquerCouleurs(document);
  render();
</script>

<style>
  .compact {
    padding-bottom: clamp(30px, 4vw, 50px);
  }
  .pt0 {
    padding-top: 0;
  }
  .configurator {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }
  .panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 38px);
    box-shadow: var(--shadow);
    display: grid;
    gap: 22px;
  }
  .field {
    display: grid;
    gap: 9px;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .field label,
  .field legend {
    font-weight: 700;
    color: var(--ink);
    padding: 0;
  }
  .hint {
    font-weight: 500;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .two {
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .two > div {
