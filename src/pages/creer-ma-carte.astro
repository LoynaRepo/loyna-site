      z-index: 45;
      left: 0;
      right: 0;
      top: 64px;
      padding: 10px 16px 12px;
      background: rgba(247, 241, 230, 0.97);
      border-bottom: 1px solid var(--filet);
      box-shadow: 0 10px 24px rgba(18, 18, 22, 0.16);
      transform: translateY(-110%);
      opacity: 0;
