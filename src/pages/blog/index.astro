---
import Base from '../../layouts/Base.astro';
import Jonction from '../../components/Jonction.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import {getArticles} from '../../lib/builder';
import {SITE} from '../../data/site';

const articles = await getArticles();
const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Ressources', url: '/blog/'},
];
const date = (d: string) => new Date(d).toLocaleDateString('fr-FR', {day: 'numeric', month: 'long', year: 'numeric'});
const blogLd = {
  '@type': 'Blog',
  name: 'Ressources LOYNA',
  url: `${SITE.url}/blog/`,
  inLanguage: 'fr-FR',
  publisher: {'@id': `${SITE.url}/#organisation`},
  blogPost: articles.map((a) => ({'@type': 'BlogPosting', headline: a.title, url: `${SITE.url}/blog/${a.slug}/`, datePublished: a.date})),
};
---

<Base
  title="Ressources : guides pour fidéliser vos clients"
  description="Guides pratiques pour les commerçants : carte de fidélité digitale, Apple Wallet et Google Wallet, idées de récompenses, relance des clients inactifs."
  breadcrumbs={crumbs}
  jsonLd={blogLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Ressources</p>
      <h1>Guides pour fidéliser vos clients</h1>
      <p class="lead">Des conseils concrets pour faire revenir vos clients plus souvent, que vous soyez coiffeur, boulanger, restaurateur ou commerçant.</p>
    </div>
  </section>
  <Jonction de="sable" vers="creme" forme={4} retourne />
  <section class="section pt0">
    <div class="container posts">
      {
        articles.map((a, i) => (
          <a class={`post ${i === 0 ? 'post--first' : ''}`} href={`/blog/${a.slug}/`}>
            <p class="meta">
              {date(a.date)} · {a.readingMinutes} min de lecture
            </p>
            <h2>{a.title}</h2>
            <p>{a.excerpt}</p>
            <span class="more">
              Lire l’article <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .pt0 {
    padding-top: 0;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 22px;
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--card);
    border: 1px solid var(--filet);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .post:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .post--first {
    grid-column: 1 / -1;
    background: var(--ink) radial-gradient(circle at 90% 0%, rgba(164, 135, 255, 0.22), transparent 55%);
    color: #DDE1E6;
    border-color: var(--ink);
  }
  .post--first h2 {
    color: #E9ECEF;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }
  .post h2 {
    font-size: clamp(1.25rem, 1.8vw, 1.45rem);
    letter-spacing: -0.03em;
  }
  .post p {
    color: var(--muted);
  }
  .post--first p,
  .post--first .meta {
    color: #B8BEC6;
  }
  .meta {
    font-size: 0.88rem;
    font-weight: 600;
    margin: 0;
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-weight: 700;
    color: var(--gold-strong);
  }
  .post--first .more {
    color: #A487FF;
  }
</style>
