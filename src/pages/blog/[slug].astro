---
import Base from '../../layouts/Base.astro';
import Jonction from '../../components/Jonction.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import {getArticles, type Article} from '../../lib/builder';
import {articlesProches} from '../../lib/maillage';
import {APPEL, FONDATEUR, PLANS, SITE, TRIAL, euro} from '../../data/site';
import {ogImage} from '../../lib/og';

export async function getStaticPaths() {
  const all = await getArticles();
  // « À lire aussi » : les articles les plus proches par le sujet (src/lib/maillage.ts)
  return all.map((a) => ({params: {slug: a.slug}, props: {a, others: articlesProches(a, all)}}));
}
const {a, others} = Astro.props as {a: Article; others: Article[]};
const url = `${SITE.url}/blog/${a.slug}/`;
const og = a.cover || ogImage(`blog-${a.slug}`);
const crumbs = [
  {name: 'Accueil', url: '/'},
  {name: 'Ressources', url: '/blog/'},
  {name: a.title, url: `/blog/${a.slug}/`},
];
const dateFr = (d: string) => new Date(d).toLocaleDateString('fr-FR', {day: 'numeric', month: 'long', year: 'numeric'});
const date = dateFr(a.date);
// Mise à jour réelle du contenu (champ miseAJour), affichée seulement si elle est postérieure à la publication
const maj = a.miseAJour && a.miseAJour > a.date ? a.miseAJour : undefined;
const words = a.body.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const ld: object[] = [
  {
    '@type': 'BlogPosting',
    headline: a.title,
    description: a.metaDescription,
    datePublished: a.date,
    dateModified: maj ?? a.date,
    inLanguage: 'fr-FR',
    wordCount: words,
    keywords: a.tags.join(', '),
    mainEntityOfPage: url,
    url,
    image: og.startsWith('http') ? og : SITE.url + og,
    // Auteur : le fondateur, décrit sur /a-propos/ (Person complète dans l'Organization de Seo.astro)
    author: {'@type': 'Person', '@id': FONDATEUR.id, name: FONDATEUR.nom, jobTitle: FONDATEUR.titre, url: new URL(FONDATEUR.page, SITE.url).href},
    publisher: {'@id': `${SITE.url}/#organisation`},
  },
];
if (a.faq?.length) {
  ld.push({'@type': 'FAQPage', mainEntity: a.faq.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}}))});
}
---

<Base title={a.metaTitle} description={a.metaDescription} type="article" published={a.date} modified={maj} ogImage={og} ogImageAlt={a.title} breadcrumbs={crumbs} jsonLd={ld}>
  <article>
    <header class="page-hero article-head">
      <div class="narrow">
        <Breadcrumbs items={crumbs} />
        <p class="meta">
          <time datetime={a.date}>{date}</time>
          {
            maj && (
              <>
                {' · '}Mis à jour le <time datetime={maj}>{dateFr(maj)}</time>
              </>
            )
          }
          {' · '}
          {a.readingMinutes} min de lecture
        </p>
        <h1>{a.title}</h1>
        <p class="lead">{a.excerpt}</p>
        <p class="byline">
          Par <a href={FONDATEUR.page} rel="author">{FONDATEUR.nom}</a>, fondateur de LOYNA
        </p>
      </div>
    </header>
    <Jonction de="sable" vers="creme" forme={3} />
    <div class="narrow prose" set:html={a.body} />
    {
      a.faq && a.faq.length > 0 && (
        <section class="narrow faq-block" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions fréquentes</h2>
          <div class="faq">
            {a.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="answer">
                  <p set:html={f.a} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }
    <aside class="narrow box">
      <p class="eyebrow">LOYNA</p>
      <p class="box-title">Votre carte de fidélité dans Apple Wallet et Google Wallet</p>
      <p>Sans application, avec récompenses automatiques et notification de proximité. Dès {euro(Math.min(...PLANS.map((p) => p.monthly)))} par mois, sans TVA.{TRIAL.open && <> {TRIAL.label.charAt(0).toUpperCase() + TRIAL.label.slice(1)}.</>}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={APPEL.href}>{APPEL.label}</a>
        <a class="btn btn--ghost" href={TRIAL.open ? '/tarifs/' : '/creer-ma-carte/'}>{TRIAL.open ? 'Voir les tarifs' : 'Créer ma carte'}</a>
      </div>
    </aside>
  </article>
  <section class="section">
    <div class="container">
      <h2 class="center">À lire aussi</h2>
      <div class="related">
        {
          others.map((o) => (
            <a href={`/blog/${o.slug}/`}>
              <strong>{o.title}</strong>
              <span>
                Lire <Icon name="arrow-right" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .article-head {
    text-align: left;
  }
  .article-head :global(.breadcrumbs ol) {
    justify-content: flex-start;
  }
  .article-head h1 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
  }
  .prose {
    padding-top: clamp(14px, 2.4vw, 30px);
  }
  .meta {
    font-weight: 600;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .byline {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .byline a {
    color: var(--ink);
    font-weight: 700;
  }
  .faq-block {
    margin-top: 48px;
  }
  .box {
    margin-top: 56px;
    padding: clamp(26px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
    border: 1px solid var(--filet);
  }
  .box-title {
    font-size: 1.4rem;
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .center {
    text-align: center;
    font-size: 1.6rem;
  }
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 18px;
    margin-top: 24px;
  }
  .related a {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .related span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    color: var(--gold-strong);
    font-weight: 700;
  }
</style>
