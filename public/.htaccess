# loyna.fr : hébergement OVH (Apache 2.4). Fichier copié tel quel à la racine du site (dossier www).

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# --- Types de fichiers --------------------------------------------------------------------------
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
AddType application/xml .xml
<Files "rss.xml">
  ForceType "application/rss+xml; charset=utf-8"
</Files>
<FilesMatch "\.(txt|md)$">
  ForceType "text/plain; charset=utf-8"
</FilesMatch>

# --- Redirections : HTTPS, domaine sans www, « / » final ----------------------------------------
# (méthode HTTPS recommandée par OVH : test du port)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.loyna\.fr$ [NC]
RewriteRule ^ https://loyna.fr%{REQUEST_URI} [L,R=301]
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://loyna.fr%{REQUEST_URI} [L,R=301]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://loyna.fr/$1/ [L,R=301]

# --- Compression -------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/markdown application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml image/x-icon
</IfModule>

# --- Cache navigateur --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Fichiers construits par Astro : nom unique à chaque version, donc cache permanent
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sécurité
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <If "%{REQUEST_URI} =~ m#^/builder-preview/#">
    # Page d'aperçu de l'éditeur visuel Builder.io : chargée dans l'éditeur, scripts Builder autorisés
    Header always set Content-Security-Policy "frame-ancestors 'self' https://builder.io https://*.builder.io"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  <Else>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.builder.io; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://builder.io https://*.builder.io; upgrade-insecure-requests"
  </Else>
  <Files "contact.php">
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

# --- Fichiers jamais servis ---------------------------------------------------------------------
<FilesMatch "^\.(?!well-known)|\.(env|ini|log|sh|py|bak|sql)$">
  Require all denied
</FilesMatch>
